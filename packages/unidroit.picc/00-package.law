// UNIDROIT Principles of International Commercial Contracts (2016 edition)
// — the HUB of the `unidroit.picc*` group.
//
// THIS IS NOT THE LAW OF A STATE, AND THE METADATA SAYS SO. `jurisdiction
// International`, `instrument doctrine`, `legalStatus doctrine`: the Principles
// apply when the parties have agreed on them (Preamble), or when a court or
// arbitral tribunal takes them as general principles of law. They do not replace
// the rule of a state — article 1.4 expressly preserves mandatory rules.
//
// THE HUB OWNS THE TYPES AND THE SHARED NOTIONS of the group: party, contract,
// obligation, notice, the organ of evaluative elements. The packages of chapters
// 2, 3, 6, 7 and 8–11 take them by alias — two subject types in one package
// would lock the bridges shut.
//
// THE ORGAN IS NAMED BY THE INSTRUMENT ITSELF. Article 1.11: «"court" includes
// an arbitral tribunal» — the Principles address the court and the tribunal as
// one addressee. `authority Tribunal` is therefore not a choice of the
// formaliser but the definition of article 1.11.

language "law.core" version "0.2";
package unidroit.picc version "0.1.0";
namespace "urn:org:unidroit:clir:picc";

// --- Subjects and objects ---------------------------------------------------

pub entity Party { label en official "Party"; }
pub entity Contract { label en official "Contract"; }
pub entity Obligation { label en official "Obligation"; }
pub entity Term { label en official "Contract term"; }
pub entity Statement { label en official "Statement or other conduct"; }
pub entity Notice { label en official "Notice"; }
pub entity Usage { label en official "Usage or practice"; }
pub entity Organ { label en official "Court, including an arbitral tribunal (article 1.11)"; }

pub relation party_of(p: Party, c: Contract) kind institutional {
    label en official "the person is a party to the contract";
}

pub relation obligation_of(o: Obligation, c: Contract, obligor: Party, obligee: Party) kind institutional {
    label en official "the obligation arises from the contract, owed by the obligor to the obligee";
}

pub relation term_of(t: Term, c: Contract) kind institutional {
    label en official "the term belongs to the contract";
}

// --- The organ of article 1.11 -----------------------------------------------

pub relation court_includes_arbitral_tribunal(who: Organ) kind institutional {
    label en official "for the purposes of these Principles the court includes an arbitral tribunal";
}

assert court_includes_arbitral_tribunal(Tribunal);

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
};
