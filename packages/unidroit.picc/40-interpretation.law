// Chapter 4. Interpretation of the contract (articles 4.1–4.8).
//
// TWO LEVELS OF INTERPRETATION, AND THE ORDER BETWEEN THEM IS TEXTUAL. Article
// 4.1: the common intention of the parties; if it cannot be established — the
// meaning that reasonable persons of the same kind would give. Article 4.2
// repeats the same pair for the statements of a single party. The second level
// falls away where the first one works, and this is expressed by a defeater
// rather than a priority: "If such an intention cannot be established" is a
// proviso of the text itself.
// ARTICLES 4.4 AND 4.5 ARE CANONS, NOT FEATURES OF THE CASE. They say HOW to
// read a term (in the light of the whole contract; so as to give effect to all
// terms) and produce no checkable feature of their own: only the RESULT of the
// reading can be presented. Their heads are therefore about the reading, while
// the fact "this reading gives the term effect" is brought by the case — exactly
// as with the canons of interpretation of the VCLT.
// CONTRA PROFERENTEM (4.6) AND LINGUISTIC DISCREPANCIES (4.7) ARE RULES OF
// PREFERENCE: they give no meaning of their own but choose between readings
// already offered. They are expressed as a conclusion preferring one reading
// over another.
language "law.core" version "0.2";
package unidroit.picc version "0.1.0";
namespace "urn:org:unidroit:clir:picc";

pub entity Reading { label en official "Reading of a contract or term"; }

pub relation reading_of_contract(r: Reading, c: Contract) kind empirical {
    label en official "the reading is a reading of that contract";
}

pub relation reading_of_term(r: Reading, t: Term) kind empirical {
    label en official "the reading is a reading of that term";
}

// --- Article 4.1: intention of the parties and reasonable persons ------------

pub relation common_intention_established(r: Reading, c: Contract) kind empirical {
    label en official "the reading gives the common intention of the parties, and that intention can be established";
}

pub external judgment relation reasonable_persons_meaning(r: Reading, c: Contract) {
    authority Tribunal;
    label en official "the reading gives the meaning that reasonable persons of the same kind as the parties would give to the contract in the same circumstances";
}

pub relation contract_interpreted_by(r: Reading, c: Contract) kind institutional {
    label en official "the contract is to be interpreted according to that reading (article 4.1)";
}

@source(PICC_ART4_1_EN, PICC_ART4_1_FR)
rule InterpretedByCommonIntention(r: Reading, c: Contract) defeasible {
    label en official "Article 4.1(1). A contract shall be interpreted according to the common intention of the parties";
    when reading_of_contract(r, c)
        and common_intention_established(r, c);
    then contract_interpreted_by(r, c);
}

@source(PICC_ART4_1_EN, PICC_ART4_1_FR)
rule InterpretedByReasonablePersons(r: Reading, c: Contract) defeasible {
    label en official "Article 4.1(2). If the common intention cannot be established, the contract shall be interpreted according to the meaning reasonable persons of the same kind would give it";
    when reading_of_contract(r, c)
        and reasonable_persons_meaning(r, c);
    then contract_interpreted_by(r, c);
}

@source(PICC_ART4_1_EN, PICC_ART4_1_FR)
rule CommonIntentionDisplacesReasonablePersons(r: Reading, other: Reading, c: Contract) defeater {
    label en official "Article 4.1(2) (opening words). Where the common intention can be established, the reasonable-persons reading does not apply";
    // The defeater strikes ONLY the reading by reasonable persons, and only
    // where the common intention is established by ANOTHER reading: without
    // `r != other` the rule would defeat itself, and the conclusion about the
    // intention would die with the displaced one (measured: case 02 returned
    // NEITHER instead of TRUE_ONLY).
    when reading_of_contract(r, c)
        and reasonable_persons_meaning(r, c)
        and common_intention_established(other, c)
        and r != other;
    defeat contract_interpreted_by(r, c);
}

// --- Article 4.2: statements and conduct of a party ---------------------------

pub relation statement_by_party(st: Statement, p: Party, c: Contract) kind empirical {
    label en official "the statement or other conduct is that of the party";
}

pub relation intention_known_to_other(st: Statement) kind empirical {
    label en official "the other party knew or could not have been unaware of that party's intention";
}

pub external judgment relation reasonable_person_meaning_of_statement(st: Statement) {
    authority Tribunal;
    label en official "the meaning that a reasonable person of the same kind as the other party would give to the statement in the same circumstances";
}

pub relation statement_interpreted_by_intention(st: Statement) kind institutional {
    label en official "the statement is to be interpreted according to the party's intention (article 4.2(1))";
}

pub relation statement_interpreted_by_reasonable_person(st: Statement) kind institutional {
    label en official "the statement is to be interpreted according to the understanding of a reasonable person (article 4.2(2))";
}

@source(PICC_ART4_2_EN, PICC_ART4_2_FR)
rule StatementByIntention(st: Statement, p: Party, c: Contract) defeasible {
    label en official "Article 4.2(1). Statements and other conduct shall be interpreted according to the party's intention if the other party knew or could not have been unaware of it";
    when statement_by_party(st, p, c)
        and intention_known_to_other(st);
    then statement_interpreted_by_intention(st);
}

@source(PICC_ART4_2_EN, PICC_ART4_2_FR)
rule StatementByReasonablePerson(st: Statement, p: Party, c: Contract) defeasible {
    label en official "Article 4.2(2). If the preceding paragraph is not applicable, statements shall be interpreted according to the meaning a reasonable person would give them";
    when statement_by_party(st, p, c)
        and reasonable_person_meaning_of_statement(st);
    then statement_interpreted_by_reasonable_person(st);
}

@source(PICC_ART4_2_EN, PICC_ART4_2_FR)
rule IntentionDisplacesReasonablePerson(st: Statement) defeater {
    label en official "Article 4.2(2) (opening words). Where the intention was known to the other party, the reasonable-person reading does not apply";
    when intention_known_to_other(st);
    defeat statement_interpreted_by_reasonable_person(st);
}

// --- Articles 4.4 and 4.5: two canons -----------------------------------------

pub relation reading_consistent_with_whole_contract(r: Reading, c: Contract) kind empirical {
    label en official "the reading interprets the terms in the light of the whole contract or statement in which they appear";
}

pub relation reading_gives_effect_to_all_terms(r: Reading, c: Contract) kind empirical {
    label en official "the reading gives effect to all the terms rather than depriving some of them of effect";
}

pub relation reading_conforms_to_canons(r: Reading, c: Contract) kind institutional {
    label en official "the reading conforms to the canons of articles 4.4 and 4.5";
}

@source(PICC_ART4_4_EN, PICC_ART4_5_EN)
rule ReadingConformsToCanons(r: Reading, c: Contract) strict {
    label en official "Articles 4.4 and 4.5. Terms are to be read in the light of the whole contract and so as to give effect to all of them";
    when reading_consistent_with_whole_contract(r, c)
        and reading_gives_effect_to_all_terms(r, c);
    then reading_conforms_to_canons(r, c);
}

// --- Article 4.6: contra proferentem ------------------------------------------

pub relation term_supplied_by_party(t: Term, p: Party) kind empirical {
    label en official "the contract term was supplied by that party";
}

pub external judgment relation term_unclear(t: Term) {
    authority Tribunal;
    label en official "the contract term is unclear";
}

pub relation reading_against_supplier(r: Reading, t: Term, p: Party) kind empirical {
    label en official "the reading is the one against the party that supplied the term";
}

pub relation reading_preferred(r: Reading, t: Term) kind institutional {
    label en official "the reading is preferred (articles 4.6 and 4.7)";
}

@source(PICC_ART4_6_EN, PICC_ART4_6_FR)
rule ContraProferentem(r: Reading, t: Term, p: Party) defeasible {
    label en official "Article 4.6. If contract terms supplied by one party are unclear, an interpretation against that party is preferred";
    when term_supplied_by_party(t, p)
        and term_unclear(t)
        and reading_against_supplier(r, t, p);
    then reading_preferred(r, t);
}

// --- Article 4.7: linguistic discrepancies ------------------------------------

pub relation drawn_up_in_several_equally_authoritative_versions(c: Contract) kind empirical {
    label en official "the contract is drawn up in two or more language versions which are equally authoritative";
}

pub relation discrepancy_between_versions(t: Term, c: Contract) kind empirical {
    label en official "there is a discrepancy between the language versions";
}

pub relation reading_follows_original_version(r: Reading, t: Term, c: Contract) kind empirical {
    label en official "the reading follows the version in which the contract was originally drawn up";
}

@source(PICC_ART4_7_EN, PICC_ART4_7_FR)
rule OriginalVersionPreferred(r: Reading, t: Term, c: Contract) defeasible {
    label en official "Article 4.7. In case of discrepancy between equally authoritative versions there is a preference for the interpretation according to the original version";
    when drawn_up_in_several_equally_authoritative_versions(c)
        and discrepancy_between_versions(t, c)
        and reading_follows_original_version(r, t, c);
    then reading_preferred(r, t);
}

// --- Article 4.3: relevant circumstances --------------------------------------
//
// The list in article 4.3 is addressed to the INTERPRETER: it says what to take
// into account when applying articles 4.1 and 4.2. It produces no feature of the
// case and enters the ground of a §47.3 judgment rather than the premise of a
// rule. Declared as a boundary in the catalogue of questions instead of being
// expressed by a head the norm does not have.

// --- Article 4.8: supplying an omitted term -----------------------------------

pub relation term_important_but_not_agreed(c: Contract, t: Term) kind empirical {
    label en official "the parties have not agreed with respect to a term which is important for a determination of their rights and duties";
}

pub external judgment relation term_appropriate_in_circumstances(c: Contract, t: Term) {
    authority Tribunal;
    label en official "the term is appropriate in the circumstances";
}

pub relation term_supplied(c: Contract, t: Term) kind institutional {
    label en official "an appropriate term is supplied (article 4.8)";
}

@source(PICC_ART4_8_EN, PICC_ART4_8_FR)
rule SupplyOmittedTerm(c: Contract, t: Term) defeasible {
    label en official "Article 4.8(1). Where the parties have not agreed with respect to an important term, a term which is appropriate in the circumstances shall be supplied";
    when term_important_but_not_agreed(c, t)
        and term_appropriate_in_circumstances(c, t);
    then term_supplied(c, t);
}
