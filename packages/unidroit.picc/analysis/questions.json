  "boundaries": [
    {
      "id": "br-not-the-law-of-a-state",
      "task": "general-provisions",
      "reason_kind": "source_delegates",
      "question": "Which mandatory rules apply to the contract and by which law are they laid down?",
      "source_units": [
        "PICC_ART1_4_EN"
      ],
      "limitation": "THIS IS NOT THE LAW OF A STATE. The Principles apply when the parties have agreed on them (Preamble), or when a court or arbitral tribunal takes them as general principles of law. They do not replace the rule of a state: article 1.4 expressly preserves mandatory rules, and which rules are mandatory is a question of the applicable law — an input of the case."
    },
    {
      "id": "br-evaluative-elements",
      "task": "interpretation",
      "reason_kind": "case_data",
      "question": "What meaning would reasonable persons give to the contract, and is the term ambiguous?",
      "source_units": [
        "PICC_ART4_1_EN",
        "PICC_ART4_6_EN"
      ],
      "limitation": "THE EVALUATIVE ELEMENTS of chapters 1, 4 and 5 go through the §47.3 judgment channel with the organ `Tribunal`: good faith (1.7), reasonable reliance on an understanding (1.8), unreasonableness of applying a usage (1.9), the closest relationship of a place of business (1.11), the meaning of reasonable persons (4.1, 4.2), ambiguity of a term (4.6), appropriateness of a supplied term (4.8), reasonable efforts (5.1.4), quality no less than average (5.1.6), a manifestly unreasonable determination of price (5.1.7), a reasonable time for notice (5.1.8)."
    },
    {
      "id": "br-organ",
      "task": "general-provisions",
      "reason_kind": "source_delegates",
      "question": "Which court or arbitral tribunal establishes the evaluative elements?",
      "source_units": [
        "PICC_ART1_11_EN"
      ],
      "limitation": "THE ORGAN IS NAMED BY THE INSTRUMENT ITSELF: article 1.11 provides that \"court\" includes an arbitral tribunal. `authority Tribunal` quotes that definition rather than choosing one."
    },
    {
      "id": "br-holiday-proviso",
      "task": "computation-of-time",
      "reason_kind": "case_data",
      "question": "Do the circumstances indicate otherwise than the extension over an official holiday?",
      "source_units": [
        "PICC_ART1_12_EN"
      ],
      "limitation": "THE EXTENSION FOR AN OFFICIAL HOLIDAY (article 1.12(2)) CARRIES THE PROVISO \"unless the circumstances indicate otherwise\", WHICH ARTICLE 20(2) OF THE CONVENTION DOES NOT HAVE: there the extension is unconditional. The two rules must not be merged, and the difference is checked by case 04 rather than by a comment."
    },
    {
      "id": "br-calendar-and-zone",
      "task": "computation-of-time",
      "reason_kind": "case_data",
      "question": "Which days are non-business days at the place of performance and which time zone applies?",
      "source_units": [
        "PICC_ART1_12_EN"
      ],
      "limitation": "THE PRINCIPLES HAVE NO CALENDAR AND NO TIME ZONES: which days are non-business days at the place of performance, and the zone of a place of business, are facts of the case. The §86 policy of the package counts calendar days, and the extension is expressed as a rule over those facts (a policy with a roll would require a §85 calendar snapshot inside the package)."
    },
    {
      "id": "br-neighbouring-chapters",
      "task": "content",
      "reason_kind": "source_delegates",
      "question": "Where do the rules on formation, validity, performance and non-performance live?",
      "source_units": [
        "PICC_ART5_1_1_EN"
      ],
      "limitation": "CHAPTERS 2, 3, 6, 7 AND 8–11 LIVE IN THE NEIGHBOURING PACKAGES of the `unidroit.picc*` group; the hub holds chapters 1, 4 and 5 and the types that all of them use."
    },
