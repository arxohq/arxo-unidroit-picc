language "law.core" version "0.2";
package examples.unidroit.applying_the_principles version "0.1.0";
namespace "urn:law:examples:unidroit:applying-the-principles";

// Case 2. Two readings of one clause, and who wrote it matters.
//
// ARTICLE 4.1 HAS TWO LEVELS AND A TEXTUAL ORDER BETWEEN THEM: a contract is
// interpreted according to the common intention of the parties, and only "if
// such an intention cannot be established" by the meaning reasonable persons
// would give it. Where the common intention IS established, the second level
// falls away — and that is a defeater of the text, not a preference invented
// by the model.
//
// ARTICLE 4.6 DOES NOT GIVE A MEANING, IT CHOOSES BETWEEN MEANINGS. Contra
// proferentem prefers the reading against the party that supplied an unclear
// term. Whether the term is unclear is evaluative and is answered by the organ
// of article 1.11; the case supplies that answer as `origin adjudicated`.

case ReadingATerm {
    context {
        deadline_policy PICC_PARTY_SET_PERIOD;
        legal_time @2026-09-18;
        knowledge_time @2026-09-18T12:00:00Z;
        decision_time @2026-09-18T12:00:00Z;
        timezone "UTC";
    }

    const contract: unidroit.picc::Contract = entity_ref("urn:example:picc:reading:contract");
    const supplier: unidroit.picc::Party = entity_ref("urn:example:picc:reading:supplier");
    const clause: unidroit.picc::Term = entity_ref("urn:example:picc:reading:delivery-clause");
    const intended: unidroit.picc::Reading = entity_ref("urn:example:picc:reading:common-intention");
    const against: unidroit.picc::Reading = entity_ref("urn:example:picc:reading:against-supplier");

    // Article 4.1(1): a reading of the contract, and the common intention behind it.
    assert "reading": unidroit.picc::reading_of_contract(intended, contract) { origin case_input; }
    assert "intention": unidroit.picc::common_intention_established(intended, contract) { origin case_input; }

    // Article 4.6: the clause was drafted by one party and the organ finds it unclear.
    assert "supplied": unidroit.picc::term_supplied_by_party(clause, supplier) { origin case_input; }
    assert "unclear": unidroit.picc::term_unclear(clause) { origin adjudicated; }
    assert "against": unidroit.picc::reading_against_supplier(against, clause, supplier) { origin case_input; }
}
