language "law.core" version "0.2";
package unidroit.picc version "0.1.0";
namespace "urn:org:unidroit:clir:picc";

// Case 1. Chapter 1: freedom of contract (1.1), its binding character and the
// three ways of modification (1.3), no form required (1.2), mandatory rules
// (1.4), derogation by the parties (1.5), supplementation of the Principles
// (1.6), good faith (1.7) and inconsistent behaviour (1.8).
//
// Expectations from the text: the contract is binding; modification by agreement
// is effective; an attempt to exclude good faith has no effect; a derogation
// from a provision the Principles do not allow to be derogated from is of no
// effect.

test "PICC-GEN-01-FREEDOM-AND-BINDING" {
    given {
        context {
            deadline_policy PICC_PARTY_SET_PERIOD;
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": party_of(entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a1": party_of(entity_ref("urn:case:picc:beta"), entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a2": negotiating(entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:beta")) { origin case_input; }
        assert "a3": contract_validly_entered_into(entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a4": modified_by_agreement(entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a5": mandatory_rule_applies(entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a6": duty_of_good_faith_excluded(entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a7": parties_derogated_from_provision(entity_ref("urn:case:picc:contract-1"), entity_ref("urn:case:picc:term-1a")) { origin case_input; }
        assert "a8": parties_derogated_from_provision(entity_ref("urn:case:picc:contract-1"), entity_ref("urn:case:picc:term-1b")) { origin case_input; }
        assert "a9": provision_not_subject_to_derogation(entity_ref("urn:case:picc:term-1b")) { origin case_input; }
        assert "a10": issue_of(entity_ref("urn:case:picc:issue-1"), entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a11": within_scope_of_principles(entity_ref("urn:case:picc:issue-1")) { origin case_input; }
        assert "a12": caused_understanding(entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:beta"), entity_ref("urn:case:picc:contract-1")) { origin case_input; }
        assert "a13": reasonably_acted_in_reliance(entity_ref("urn:case:picc:beta"), entity_ref("urn:case:picc:contract-1")) { origin adjudicated; }
        assert "a14": acted_inconsistently(entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:contract-1")) { origin case_input; }
    }

    evaluate truth(parties_free_to_contract(entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:beta")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(FreedomOfContract);

    evaluate truth(binding_upon_parties(entity_ref("urn:case:picc:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ContractIsBinding);

    evaluate truth(form_not_required(entity_ref("urn:case:picc:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(NoFormRequired);

    evaluate truth(validly_modified_or_terminated(entity_ref("urn:case:picc:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ModificationByAgreement);

    evaluate truth(principles_do_not_restrict_mandatory_rule(entity_ref("urn:case:picc:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(MandatoryRulesUnrestricted);

    evaluate truth(exclusion_of_good_faith_ineffective(entity_ref("urn:case:picc:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(GoodFaithCannotBeExcluded);

    // Derogation is effective where the Principles allow it…
    evaluate truth(derogation_effective(entity_ref("urn:case:picc:contract-1"), entity_ref("urn:case:picc:term-1a")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(DerogationEffective);

    // …and ineffective where they do not (for example article 1.7(2)).
    evaluate truth(derogation_effective(entity_ref("urn:case:picc:contract-1"), entity_ref("urn:case:picc:term-1b")));
    expect truth_status == NEITHER;

    evaluate truth(settled_by_underlying_general_principles(entity_ref("urn:case:picc:issue-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(GapSettledByUnderlyingPrinciples);

    evaluate truth(inconsistent_behaviour_barred(entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(InconsistentBehaviourBarred);

    evaluate positions();
    expect position(GoodFaith, ACTIVE);
}
