language "law.core" version "0.2";
package unidroit.picc version "0.1.0";
namespace "urn:org:unidroit:clir:picc";

// Case 2. Chapter 4: interpretation of the contract and of statements (4.1,
// 4.2), the canons (4.3–4.5), contra proferentem (4.6), linguistic
// discrepancies (4.7) and supplying an omitted term (4.8).
//
// Expectations from the text: an established common intention displaces the
// reading by reasonable persons; an intention known to the other party displaces
// the reasonable-person reading for a single statement as well; an ambiguous
// term supplied by one party is read against that party; where equally
// authentic versions differ, the original version prevails.

test "PICC-GEN-02-INTERPRETATION" {
    given {
        context {
            deadline_policy PICC_PARTY_SET_PERIOD;
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": reading_of_contract(entity_ref("urn:case:picc:reading-intent"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a1": common_intention_established(entity_ref("urn:case:picc:reading-intent"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a2": reading_of_contract(entity_ref("urn:case:picc:reading-reasonable"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a3": reasonable_persons_meaning(entity_ref("urn:case:picc:reading-reasonable"), entity_ref("urn:case:picc:contract-2")) { origin adjudicated; }
        assert "a4": statement_by_party(entity_ref("urn:case:picc:statement-2"), entity_ref("urn:case:picc:alpha"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a5": intention_known_to_other(entity_ref("urn:case:picc:statement-2")) { origin case_input; }
        assert "a6": reasonable_person_meaning_of_statement(entity_ref("urn:case:picc:statement-2")) { origin adjudicated; }
        assert "a7": reading_consistent_with_whole_contract(entity_ref("urn:case:picc:reading-intent"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a8": reading_gives_effect_to_all_terms(entity_ref("urn:case:picc:reading-intent"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a9": term_supplied_by_party(entity_ref("urn:case:picc:term-2"), entity_ref("urn:case:picc:alpha")) { origin case_input; }
        assert "a10": term_unclear(entity_ref("urn:case:picc:term-2")) { origin adjudicated; }
        assert "a11": reading_against_supplier(entity_ref("urn:case:picc:reading-against"), entity_ref("urn:case:picc:term-2"), entity_ref("urn:case:picc:alpha")) { origin case_input; }
        assert "a12": drawn_up_in_several_equally_authoritative_versions(entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a13": discrepancy_between_versions(entity_ref("urn:case:picc:term-2b"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a14": reading_follows_original_version(entity_ref("urn:case:picc:reading-original"), entity_ref("urn:case:picc:term-2b"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
        assert "a15": term_important_but_not_agreed(entity_ref("urn:case:picc:contract-2"), entity_ref("urn:case:picc:term-2c")) { origin case_input; }
        assert "a16": term_appropriate_in_circumstances(entity_ref("urn:case:picc:contract-2"), entity_ref("urn:case:picc:term-2c")) { origin adjudicated; }
        assert "a17": circumstance_of_listed_kind(entity_ref("urn:case:picc:circ-2"), entity_ref("urn:case:picc:contract-2")) { origin case_input; }
    }

    evaluate truth(contract_interpreted_by(entity_ref("urn:case:picc:reading-intent"), entity_ref("urn:case:picc:contract-2")));
    // The answer on the merits is the reading by the common intention. The
    // document stays REQUIRES_JUDGMENT: the organ has not been asked whether
    // reasonable persons would give the same meaning to THAT reading, and this is
    // the honest state — article 4.1(2) remains available while its question is open.
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect truth_status == TRUE_ONLY;
    expect any_applied(InterpretedByCommonIntention);

    // An established common intention displaces the reading by reasonable persons.
    evaluate truth(contract_interpreted_by(entity_ref("urn:case:picc:reading-reasonable"), entity_ref("urn:case:picc:contract-2")));
    expect truth_status == NEITHER;

    evaluate truth(statement_interpreted_by_intention(entity_ref("urn:case:picc:statement-2")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(StatementByIntention);

    evaluate truth(statement_interpreted_by_reasonable_person(entity_ref("urn:case:picc:statement-2")));
    expect truth_status == NEITHER;

    evaluate truth(reading_conforms_to_canons(entity_ref("urn:case:picc:reading-intent"), entity_ref("urn:case:picc:contract-2")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ReadingConformsToCanons);

    evaluate truth(reading_preferred(entity_ref("urn:case:picc:reading-against"), entity_ref("urn:case:picc:term-2")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ContraProferentem);

    evaluate truth(reading_preferred(entity_ref("urn:case:picc:reading-original"), entity_ref("urn:case:picc:term-2b")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(OriginalVersionPreferred);

    evaluate truth(term_supplied(entity_ref("urn:case:picc:contract-2"), entity_ref("urn:case:picc:term-2c")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(SupplyOmittedTerm);

    evaluate truth(circumstance_to_be_regarded(entity_ref("urn:case:picc:circ-2"), entity_ref("urn:case:picc:contract-2")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(CircumstanceToBeRegarded);
}
