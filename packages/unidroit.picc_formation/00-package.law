// Chapter 2 of the Principles: formation of the contract and authority of agents.
//
// WHY A SEPARATE PACKAGE IF THE RULES MIRROR PART II OF THE CONVENTION. Precisely
// because they mirror it INCOMPLETELY, and the differences are the point of the
// comparison:
//  · article 2.1.22 states the "battle of forms" AS A RULE (knock-out: the
//    contract is concluded on the terms agreed and on the standard terms that
//    are common in substance), whereas article 19 of the Convention has no such
//    rule at all and practice reads it in two ways — two §152 readings in
//    `intl.uncitral.cisg_formation`;
//  · article 2.1.12 knows the writing in confirmation with additional terms,
//    which the Convention does not;
//  · article 2.1.15 knows liability for negotiations in bad faith, which the
//    Convention does not;
//  · article 2.1.20 knows surprising terms in standard forms.
//
// THE PERIOD FOR ACCEPTANCE RUNS FROM THE DISPATCH OF THE OFFER (article 2.1.8),
// not from the handing in of a telegram or the date of a letter as under article
// 20 of the Convention: "A period of acceptance fixed by the offeror begins to
// run from the time that the offer is dispatched". The §86 policy is the same as
// the hub's and comes in by import.

language "law.core" version "0.2";
package unidroit.picc_formation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-formation";

import unidroit.picc version "0.1.0";

type Party = unidroit.picc::Party;
type Contract = unidroit.picc::Contract;
type Term = unidroit.picc::Term;
type Organ = unidroit.picc::Organ;

deadline policy PICC_ACCEPTANCE_PERIOD {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
};

pub entity Offer { label en official "Offer"; }
pub entity Acceptance { label en official "Acceptance or reply to an offer"; }
