// Articles 2.1.1–2.1.12. Offer, acceptance, the period for acceptance and a late acceptance.
//
// TWO MODES OF CONCLUSION (2.1.1), AND THE CONVENTION DOES NOT STATE THE SECOND
// EXPRESSLY: a contract may be concluded by the acceptance of an offer OR by
// conduct of the parties that is sufficient to show agreement. Two grounds —
// two rules (§206).
//
// THE PERIOD RUNS FROM THE DISPATCH OF THE OFFER (2.1.8), and a time indicated
// in the offer counts as the time of dispatch, "unless the circumstances
// indicate otherwise". Article 20 of the Convention starts the count elsewhere
// (handing in of a telegram, the date of a letter, the date of the envelope) —
// that comparison lives in the cross-cutting family, not in a shared rule.
//
// "WITHOUT UNDUE DELAY" AND "IMMEDIATELY" ARE EVALUATIVE ELEMENTS, not zero
// periods (DECISION-0194): an oral offer must be accepted immediately,
// "unless the circumstances indicate otherwise", which is a proviso as well.

language "law.core" version "0.2";
package unidroit.picc_formation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-formation";

// --- Article 2.1.1: modes of conclusion ---------------------------------------

pub relation conduct_sufficient_to_show_agreement(c: Contract) kind empirical {
    label en official "the conduct of the parties is sufficient to show agreement";
}

pub relation contract_concluded(c: Contract) kind institutional {
    label en official "the contract is concluded (article 2.1.1)";
}

pub relation concluded_by_acceptance(c: Contract, a: Acceptance) kind empirical {
    label en official "the contract is concluded by that acceptance";
}

// --- Article 2.1.2: what amounts to an offer ----------------------------------

pub relation proposal_sufficiently_definite(o: Offer) kind empirical {
    label en official "the proposal for concluding a contract is sufficiently definite";
}

pub relation proposal_indicates_intention_to_be_bound(o: Offer) kind empirical {
    label en official "the proposal indicates the intention of the offeror to be bound in case of acceptance";
}

pub relation is_offer(o: Offer) kind institutional {
    label en official "the proposal constitutes an offer (article 2.1.2)";
}

@source(PICC_ART2_1_2_EN, PICC_ART2_1_2_FR)
rule ProposalIsOffer(o: Offer) defeasible {
    label en official "Article 2.1.2. A proposal for concluding a contract constitutes an offer if it is sufficiently definite and indicates the intention of the offeror to be bound";
    when proposal_sufficiently_definite(o)
        and proposal_indicates_intention_to_be_bound(o);
    then is_offer(o);
}

// --- Article 2.1.3: when an offer becomes effective and its withdrawal --------

pub relation offer_reached_offeree(o: Offer) kind empirical {
    label en official "the offer reaches the offeree";
}

pub relation withdrawal_reached_before_or_with_offer(o: Offer) kind empirical {
    label en official "the withdrawal reaches the offeree before or at the same time as the offer";
}

pub relation offer_effective(o: Offer) kind institutional {
    label en official "the offer becomes effective (article 2.1.3(1))";
}

@source(PICC_ART2_1_3_EN, PICC_ART2_1_3_FR)
rule OfferBecomesEffective(o: Offer) defeasible {
    label en official "Article 2.1.3(1). An offer becomes effective when it reaches the offeree";
    when offer_reached_offeree(o);
    then offer_effective(o);
}

@source(PICC_ART2_1_3_EN, PICC_ART2_1_3_FR)
rule OfferWithdrawn(o: Offer) defeater {
    label en official "Article 2.1.3(2). An offer, even if irrevocable, may be withdrawn if the withdrawal reaches the offeree before or at the same time as the offer";
    when withdrawal_reached_before_or_with_offer(o);
    defeat offer_effective(o);
}

// --- Articles 2.1.4 and 2.1.5: revocation and rejection -----------------------

pub relation revocation_reached_before_dispatch_of_acceptance(o: Offer) kind empirical {
    label en official "the revocation reaches the offeree before it has dispatched an acceptance";
}

pub relation offer_states_irrevocability(o: Offer) kind empirical {
    label en official "the offer indicates, whether by stating a fixed time for acceptance or otherwise, that it is irrevocable";
}

pub external judgment relation reasonable_to_rely_on_irrevocability(o: Offer) {
    authority Tribunal;
    label en official "it was reasonable for the offeree to rely on the offer as being irrevocable";
}

pub relation offeree_acted_in_reliance(o: Offer) kind empirical {
    label en official "the offeree has acted in reliance on the offer";
}

pub relation rejection_reached_offeror(o: Offer) kind empirical {
    label en official "a rejection reaches the offeror";
}

pub relation offer_revoked(o: Offer) kind institutional {
    label en official "the offer is revoked (article 2.1.4(1))";
}

@source(PICC_ART2_1_4_EN, PICC_ART2_1_4_FR)
rule OfferRevoked(o: Offer) defeasible {
    label en official "Article 2.1.4(1). Until a contract is concluded an offer may be revoked if the revocation reaches the offeree before it has dispatched an acceptance";
    when revocation_reached_before_dispatch_of_acceptance(o);
    then offer_revoked(o);
}

@source(PICC_ART2_1_4_EN, PICC_ART2_1_4_FR)
rule IrrevocableByItsTerms(o: Offer) defeater {
    label en official "Article 2.1.4(2)(a). An offer cannot be revoked if it indicates that it is irrevocable";
    when offer_states_irrevocability(o);
    defeat offer_revoked(o);
}

@source(PICC_ART2_1_4_EN, PICC_ART2_1_4_FR)
rule IrrevocableByReliance(o: Offer) defeater {
    label en official "Article 2.1.4(2)(b). An offer cannot be revoked if it was reasonable for the offeree to rely on it as being irrevocable and the offeree has acted in reliance";
    when reasonable_to_rely_on_irrevocability(o)
        and offeree_acted_in_reliance(o);
    defeat offer_revoked(o);
}

@source(PICC_ART2_1_5_EN, PICC_ART2_1_5_FR)
rule OfferTerminatedByRejection(o: Offer) defeater {
    label en official "Article 2.1.5. An offer is terminated when a rejection reaches the offeror";
    when rejection_reached_offeror(o);
    defeat offer_effective(o);
}

// --- Article 2.1.6: mode of acceptance ----------------------------------------

pub relation reply_to(a: Acceptance, o: Offer) kind empirical {
    label en official "the reply is a reply to that offer";
}

pub relation indicates_assent(a: Acceptance) kind empirical {
    label en official "a statement made by or other conduct of the offeree indicates assent to the offer";
}

pub relation silence_or_inactivity_only(a: Acceptance) kind empirical {
    label en official "there is silence or inactivity only";
}

pub relation assent_reached_offeror(a: Acceptance) kind empirical {
    label en official "the indication of assent reaches the offeror";
}

pub relation is_acceptance(a: Acceptance) kind institutional {
    label en official "the reply is an acceptance (article 2.1.6(1))";
}

pub relation acceptance_effective(a: Acceptance) kind institutional {
    label en official "the acceptance becomes effective (article 2.1.6(2))";
}

@source(PICC_ART2_1_6_EN, PICC_ART2_1_6_FR)
rule AssentIsAcceptance(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.6(1). A statement made by or other conduct of the offeree indicating assent to an offer is an acceptance";
    when reply_to(a, o)
        and indicates_assent(a);
    then is_acceptance(a);
}

@source(PICC_ART2_1_6_EN, PICC_ART2_1_6_FR)
rule SilenceIsNotAcceptance(a: Acceptance, o: Offer) strict {
    label en official "Article 2.1.6(1). Silence or inactivity does not in itself amount to acceptance";
    when reply_to(a, o)
        and silence_or_inactivity_only(a);
    then not is_acceptance(a);
}

// --- Articles 2.1.7 and 2.1.8: the period for acceptance ----------------------

pub relation acceptance_period(o: Offer, span: Quantity) kind empirical {
    label en official "the period of acceptance fixed by the offeror";
    key(o);
}

pub relation offer_dispatched_on(o: Offer, day: Date) kind empirical {
    label en official "the day on which the offer is dispatched";
    key(o);
}

pub relation time_indicated_in_offer(o: Offer, day: Date) kind empirical {
    label en official "the time indicated in the offer, deemed to be the time of dispatch";
    key(o);
}

pub relation circumstances_indicate_otherwise(o: Offer) kind empirical {
    label en official "the circumstances indicate otherwise";
}

pub relation acceptance_period_runs_from(o: Offer, day: Date) kind institutional {
    label en official "the day from which the period of acceptance begins to run (article 2.1.8)";
}

pub relation acceptance_period_ends_on(o: Offer, day: Date) kind derived {
    label en official "the last day of the period of acceptance";
}

@source(PICC_ART2_1_8_EN, PICC_ART2_1_8_FR)
rule PeriodRunsFromDispatch(o: Offer, day: Date) defeasible {
    label en official "Article 2.1.8. A period of acceptance fixed by the offeror begins to run from the time that the offer is dispatched";
    when offer_dispatched_on(o, day);
    then acceptance_period_runs_from(o, day);
}

@source(PICC_ART2_1_8_EN, PICC_ART2_1_8_FR)
rule IndicatedTimeIsDispatch(o: Offer, day: Date) defeasible {
    label en official "Article 2.1.8. A time indicated in the offer is deemed to be the time of dispatch unless the circumstances indicate otherwise";
    when time_indicated_in_offer(o, day);
    then acceptance_period_runs_from(o, day);
    // The binding conjunct belongs in the clause itself (§149-§150, E-0099).
    unless time_indicated_in_offer(o, day)
        and circumstances_indicate_otherwise(o);
}

@source(PICC_ART2_1_7_EN, PICC_ART2_1_8_EN)
rule AcceptancePeriodEnds(o: Offer, start: Date, span: Quantity) defeasible {
    label en official "Articles 2.1.7 and 2.1.8. The last day of the period of acceptance fixed by the offeror";
    when acceptance_period_runs_from(o, start)
        and acceptance_period(o, span);
    then acceptance_period_ends_on(o, add_calendar_period(start, span));
}

pub relation acceptance_reached_offeror_on(a: Acceptance, day: Date) kind empirical {
    label en official "the day on which the indication of assent reached the offeror";
    key(a);
}

pub external judgment relation within_reasonable_time(a: Acceptance) {
    authority Tribunal;
    label en official "the offer was accepted within a reasonable time having regard to the circumstances, including the rapidity of the means of communication employed";
}

pub relation acceptance_in_time(a: Acceptance, o: Offer) kind institutional {
    label en official "the acceptance was made within the time allowed (article 2.1.7)";
}

@source(PICC_ART2_1_7_EN, PICC_ART2_1_7_FR)
rule AcceptanceWithinFixedPeriod(a: Acceptance, o: Offer, received: Date, last: Date) defeasible {
    label en official "Article 2.1.7. An offer must be accepted within the time the offeror has fixed";
    when reply_to(a, o)
        and acceptance_reached_offeror_on(a, received)
        and acceptance_period_ends_on(o, last)
        and received <= last;
    then acceptance_in_time(a, o);
}

@source(PICC_ART2_1_7_EN, PICC_ART2_1_7_FR)
rule AcceptanceWithinReasonableTime(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.7. If no time is fixed, the offer must be accepted within a reasonable time";
    when reply_to(a, o)
        and within_reasonable_time(a);
    then acceptance_in_time(a, o);
}

@source(PICC_ART2_1_6_EN, PICC_ART2_1_7_EN)
rule AcceptanceEffective(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.6(2) with 2.1.7. An acceptance becomes effective when the indication of assent reaches the offeror in time";
    when is_acceptance(a)
        and reply_to(a, o)
        and assent_reached_offeror(a)
        and acceptance_in_time(a, o);
    then acceptance_effective(a);
}

// --- Article 2.1.9: late acceptance -------------------------------------------

pub relation acceptance_late(a: Acceptance) kind empirical {
    label en official "the acceptance is late";
}

pub external judgment relation offeror_informed_without_undue_delay(a: Acceptance) {
    authority Tribunal;
    label en official "without undue delay the offeror so informs the offeree or gives notice to that effect";
}

pub relation communication_shows_normal_transmission(a: Acceptance) kind empirical {
    label en official "the communication containing the late acceptance shows that if its transmission had been normal it would have reached the offeror in due time";
}

pub external judgment relation offeror_objected_without_undue_delay(a: Acceptance) {
    authority Tribunal;
    label en official "the offeror without undue delay informs the offeree that it considers its offer as having lapsed";
}

@source(PICC_ART2_1_9_EN, PICC_ART2_1_9_FR)
rule LateAcceptanceSavedByOfferor(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.9(1). A late acceptance is nevertheless effective if without undue delay the offeror so informs the offeree";
    when reply_to(a, o)
        and acceptance_late(a)
        and offeror_informed_without_undue_delay(a);
    then is_acceptance(a);
}

@source(PICC_ART2_1_9_EN, PICC_ART2_1_9_FR)
rule LateAcceptanceSavedByNormalTransmission(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.9(2). A late acceptance which would have arrived in due time is effective unless the offeror without undue delay objects";
    when reply_to(a, o)
        and acceptance_late(a)
        and communication_shows_normal_transmission(a);
    then is_acceptance(a);
    unless reply_to(a, o)
        and offeror_objected_without_undue_delay(a);
}

// --- Article 2.1.10: withdrawal of acceptance ---------------------------------

pub relation acceptance_withdrawal_in_time(a: Acceptance) kind empirical {
    label en official "the withdrawal reaches the offeror before or at the same time as the acceptance would have become effective";
}

@source(PICC_ART2_1_10_EN, PICC_ART2_1_10_FR)
rule AcceptanceWithdrawn(a: Acceptance) defeater {
    label en official "Article 2.1.10. An acceptance may be withdrawn if the withdrawal reaches the offeror before or at the same time as the acceptance would have become effective";
    when acceptance_withdrawal_in_time(a);
    defeat acceptance_effective(a);
}

@source(PICC_ART2_1_1_EN, PICC_ART2_1_1_FR)
rule ConcludedByAcceptance(c: Contract, a: Acceptance) defeasible {
    label en official "Article 2.1.1. A contract may be concluded by the acceptance of an offer";
    when concluded_by_acceptance(c, a)
        and acceptance_effective(a);
    then contract_concluded(c);
}

@source(PICC_ART2_1_1_EN, PICC_ART2_1_1_FR)
rule ConcludedByConduct(c: Contract) defeasible {
    label en official "Article 2.1.1. A contract may be concluded by conduct of the parties that is sufficient to show agreement";
    when conduct_sufficient_to_show_agreement(c);
    then contract_concluded(c);
}

// --- Article 2.1.12: writings in confirmation ---------------------------------
//
// A rule the Convention does not have: additional or different terms of a
// writing in confirmation BECOME part of the contract unless they materially
// alter it and the recipient objects without undue delay.

pub relation confirmation_sent_within_reasonable_time(c: Contract, t: Term) kind empirical {
    label en official "a writing purporting to be a confirmation of the contract was sent within a reasonable time after its conclusion and contains that additional or different term";
}

pub external judgment relation materially_alters_the_contract(t: Term, c: Contract) {
    authority Tribunal;
    label en official "the term materially alters the contract";
}

pub relation recipient_objected_without_undue_delay(t: Term, c: Contract) kind empirical {
    label en official "the recipient, without undue delay, objects to the discrepancy";
}

pub relation term_becomes_part_of_contract(t: Term, c: Contract) kind institutional {
    label en official "the term becomes part of the contract (article 2.1.12)";
}

@source(PICC_ART2_1_12_EN, PICC_ART2_1_12_FR)
rule ConfirmationTermBecomesPart(t: Term, c: Contract) defeasible {
    label en official "Article 2.1.12. Additional or different terms in a writing in confirmation become part of the contract unless they materially alter it or the recipient objects without undue delay";
    when confirmation_sent_within_reasonable_time(c, t)
        and not_known(materially_alters_the_contract(t, c));
    then term_becomes_part_of_contract(t, c);
    unless confirmation_sent_within_reasonable_time(c, t)
        and recipient_objected_without_undue_delay(t, c);
}

// --- Article 2.1.6(3): acceptance by performing an act without notice ---------
//
// The offer, practices established between the parties or a usage may allow the
// offeree to indicate assent by performing an act. Acceptance is then effective
// not on receipt but ON THE PERFORMANCE OF THE ACT, and that is a head of its
// own rather than a proviso to paragraph 2.

pub relation assent_by_act_permitted(a: Acceptance) kind empirical {
    label en official "by virtue of the offer or as a result of practices which the parties have established between themselves or of usage, the offeree may indicate assent by performing an act without notice to the offeror";
}

pub relation act_of_assent_performed(a: Acceptance) kind empirical {
    label en official "the act indicating assent has been performed";
}

@source(PICC_ART2_1_6_EN, PICC_ART2_1_6_FR)
rule AssentByPerformedActIsAcceptance(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.6(3). Where the offeree may indicate assent by performing an act without notice, performing that act is an acceptance";
    when reply_to(a, o)
        and assent_by_act_permitted(a)
        and act_of_assent_performed(a);
    then is_acceptance(a);
}

@source(PICC_ART2_1_6_EN, PICC_ART2_1_6_FR)
rule AcceptanceEffectiveOnPerformance(a: Acceptance, o: Offer) defeasible {
    label en official "Article 2.1.6(3). The acceptance is effective when the act is performed";
    when reply_to(a, o)
        and assent_by_act_permitted(a)
        and act_of_assent_performed(a);
    then acceptance_effective(a);
}
