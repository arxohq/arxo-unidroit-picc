// Articles 2.2.1–2.2.10. Authority of agents.
//
// THE SECTION GOVERNS THE EXTERNAL RELATIONSHIP, AND SAYS SO EXPRESSLY. Article
// 2.2.1(2): it governs only the relations between the principal or the agent on
// the one hand and the third party on the other. The internal relationship
// between principal and agent is left to the applicable law, and that boundary
// comes from the text rather than from a silence of the model.
//
// THREE OUTCOMES OF THE AGENT'S ACT, AND THE TEXT SEPARATES THEM BY FACTS:
// disclosed agency (2.2.3) binds the principal to the third party; undisclosed
// agency (2.2.4) binds the agent alone; an act without authority (2.2.5) binds
// nobody, save for apparent authority. These are three distinct heads, not one
// head with provisos.
//
// RATIFICATION (2.2.9) IS A §127 POWER: by its own act the principal gives the
// agent's act the effect it would have had if performed with authority from the
// outset.

language "law.core" version "0.2";
package unidroit.picc_formation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-formation";

pub entity Agent { label en official "Agent"; }
pub entity Principal { label en official "Principal"; }
pub entity ThirdParty { label en official "Third party"; }
pub entity Act { label en official "Act of the agent"; }

pub relation act_of_agent(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) kind empirical {
    label en official "the act was done by the agent with respect to a contract with the third party on behalf of the principal";
}

pub relation within_scope_of_authority(x: Act) kind empirical {
    label en official "the agent acts within the scope of its authority";
}

pub relation third_party_knew_of_agency(x: Act) kind empirical {
    label en official "the third party knew or ought to have known that the agent was acting as an agent";
}

pub relation affects_principal_and_third_party(x: Act) kind institutional {
    label en official "the acts of the agent directly affect the legal relations between the principal and the third party (article 2.2.3(1))";
}

pub relation affects_agent_and_third_party_only(x: Act) kind institutional {
    label en official "the acts of the agent affect only the relations between the agent and the third party (article 2.2.4(1))";
}

@source(PICC_ART2_2_3_EN, PICC_ART2_2_3_FR)
rule AgencyDisclosed(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeasible {
    label en official "Article 2.2.3(1). Where an agent acts within the scope of its authority and the third party knew or ought to have known of the agency, the acts directly affect the relations between principal and third party";
    when act_of_agent(x, ag, pr, tp)
        and within_scope_of_authority(x)
        and third_party_knew_of_agency(x);
    then affects_principal_and_third_party(x);
}

@source(PICC_ART2_2_4_EN, PICC_ART2_2_4_FR)
rule AgencyUndisclosed(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeasible {
    label en official "Article 2.2.4(1). Where the third party neither knew nor ought to have known of the agency, the acts affect only the relations between the agent and the third party";
    when act_of_agent(x, ag, pr, tp)
        and within_scope_of_authority(x)
        and not_known(third_party_knew_of_agency(x));
    then affects_agent_and_third_party_only(x);
}

// --- Article 2.2.5: act without authority and apparent authority --------------

pub relation acts_without_or_exceeding_authority(x: Act) kind empirical {
    label en official "the agent acts without authority or exceeds its authority";
}

pub external judgment relation principal_caused_reasonable_belief(x: Act) {
    authority Tribunal;
    label en official "the principal caused the third party reasonably to believe that the agent had authority and was acting within it";
}

pub relation no_effect_on_principal(x: Act) kind institutional {
    label en official "the acts do not affect the legal relations between the principal and the third party (article 2.2.5(1))";
}

@source(PICC_ART2_2_5_EN, PICC_ART2_2_5_FR)
rule ActsWithoutAuthority(x: Act) defeasible {
    label en official "Article 2.2.5(1). Where an agent acts without authority or exceeds its authority, its acts do not affect the legal relations between the principal and the third party";
    when acts_without_or_exceeding_authority(x);
    then no_effect_on_principal(x);
}

@source(PICC_ART2_2_5_EN, PICC_ART2_2_5_FR)
rule ApparentAuthorityBindsPrincipal(x: Act) defeater {
    label en official "Article 2.2.5(2). Where the principal causes the third party reasonably to believe that the agent has authority, the principal may not invoke the lack of authority";
    when acts_without_or_exceeding_authority(x)
        and principal_caused_reasonable_belief(x);
    defeat no_effect_on_principal(x);
}

// --- Article 2.2.6: liability of the agent ------------------------------------

pub relation ratified_by_principal(x: Act) kind empirical {
    label en official "the act has been ratified by the principal";
}

pub relation third_party_knew_of_lack_of_authority(x: Act) kind empirical {
    label en official "the third party knew or ought to have known of the agent's lack of authority";
}

pub relation agent_liable_for_damages(x: Act, ag: Agent, tp: ThirdParty) kind institutional {
    label en official "the agent is liable for damages that will place the third party in the same position as if the agent had acted with authority (article 2.2.6(1))";
}

@source(PICC_ART2_2_6_EN, PICC_ART2_2_6_FR)
rule AgentLiableWithoutAuthority(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeasible {
    label en official "Article 2.2.6(1). An agent that acts without authority or exceeds it is, failing ratification, liable for damages placing the third party in the same position as if the agent had acted with authority";
    when act_of_agent(x, ag, pr, tp)
        and acts_without_or_exceeding_authority(x)
        and not_known(ratified_by_principal(x));
    then agent_liable_for_damages(x, ag, tp);
    // The binding conjunct belongs in the clause itself (§149-§150, E-0099).
    unless act_of_agent(x, ag, pr, tp)
        and third_party_knew_of_lack_of_authority(x);
}

// --- Article 2.2.7: conflict of interests -------------------------------------

pub relation conflict_of_interests(x: Act) kind empirical {
    label en official "the contract concluded by the agent involves the agent in a conflict of interests with the principal of which the third party knew or ought to have known";
}

pub relation principal_consented_or_knew(x: Act) kind empirical {
    label en official "the principal had consented to, or knew or ought to have known of, the agent's involvement in the conflict of interests";
}

pub relation principal_may_avoid_contract(x: Act, pr: Principal) kind institutional {
    label en official "the principal may avoid the contract (article 2.2.7(1))";
}

@source(PICC_ART2_2_7_EN, PICC_ART2_2_7_FR)
rule ConflictOfInterestsAllowsAvoidance(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeasible {
    label en official "Article 2.2.7(1). If a contract concluded by an agent involves a conflict of interests of which the third party knew or ought to have known, the principal may avoid the contract";
    when act_of_agent(x, ag, pr, tp)
        and conflict_of_interests(x);
    then principal_may_avoid_contract(x, pr);
    unless act_of_agent(x, ag, pr, tp)
        and principal_consented_or_knew(x);
}

// --- Article 2.2.8: sub-agency -------------------------------------------------

pub external judgment relation not_reasonable_to_expect_agent_to_act_itself(x: Act) {
    authority Tribunal;
    label en official "it is not reasonable to expect the agent to perform the acts itself";
}

pub relation implied_authority_to_appoint_sub_agent(x: Act, ag: Agent) kind institutional {
    label en official "the agent has implied authority to appoint a sub-agent (article 2.2.8)";
}

@source(PICC_ART2_2_8_EN, PICC_ART2_2_8_FR)
rule ImpliedAuthorityForSubAgent(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeasible {
    label en official "Article 2.2.8. An agent has implied authority to appoint a sub-agent to perform acts which it is not reasonable to expect the agent to perform itself";
    when act_of_agent(x, ag, pr, tp)
        and not_reasonable_to_expect_agent_to_act_itself(x);
    then implied_authority_to_appoint_sub_agent(x, ag);
}

// --- Article 2.2.9: ratification as a §127 power ------------------------------

pub relation act_produces_effects_as_authorised(x: Act) kind institutional {
    label en official "on ratification the act produces the same effects as if it had initially been carried out with authority (article 2.2.9(1))";
}

@source(PICC_ART2_2_9_EN, PICC_ART2_2_9_FR)
rule RatificationPower(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) strict {
    label en official "Article 2.2.9(1). An act by an agent that acts without authority may be ratified by the principal";
    when act_of_agent(x, ag, pr, tp)
        and acts_without_or_exceeding_authority(x);
    then power Ratify {
        holder pr;
        over x;
        exercise ratified_by_principal(x);
        valid_when acts_without_or_exceeding_authority(x);
        effect create(act_produces_effects_as_authorised(x));
    };
}

@source(PICC_ART2_2_9_EN, PICC_ART2_2_9_FR)
rule RatifiedActIsAuthorised(x: Act) defeasible {
    label en official "Article 2.2.9(1). On ratification the act produces the same effects as if it had been carried out with authority";
    when ratified_by_principal(x);
    then act_produces_effects_as_authorised(x);
}

// --- Article 2.2.10: termination of authority ---------------------------------

pub relation authority_terminated(x: Act) kind empirical {
    label en official "the authority of the agent has been terminated";
}

pub relation third_party_knew_of_termination(x: Act) kind empirical {
    label en official "the third party knew or ought to have known of the termination of authority";
}

pub relation act_necessary_to_prevent_harm(x: Act) kind empirical {
    label en official "the act is necessary to prevent harm to the principal's interests";
}

pub relation termination_effective_against_third_party(x: Act) kind institutional {
    label en official "the termination of authority is effective in relation to the third party (article 2.2.10(1))";
}

pub relation agent_remains_authorised(x: Act) kind institutional {
    label en official "the agent remains authorised to perform acts necessary to prevent harm to the principal's interests (article 2.2.10(2))";
}

@source(PICC_ART2_2_10_EN, PICC_ART2_2_10_FR)
rule TerminationEffectiveOnlyIfKnown(x: Act) strict {
    label en official "Article 2.2.10(1). Termination of authority is not effective in relation to the third party unless the third party knew or ought to have known of it";
    when authority_terminated(x)
        and third_party_knew_of_termination(x);
    then termination_effective_against_third_party(x);
}

@source(PICC_ART2_2_10_EN, PICC_ART2_2_10_FR)
rule AgentRemainsAuthorisedToPreventHarm(x: Act) strict {
    label en official "Article 2.2.10(2). Notwithstanding the termination of its authority, an agent remains authorised to perform the acts necessary to prevent harm to the principal's interests";
    when authority_terminated(x)
        and act_necessary_to_prevent_harm(x);
    then agent_remains_authorised(x);
}

// --- Article 2.2.1: scope of the section and its boundary ---------------------

pub relation external_relations_governed(x: Act) kind institutional {
    label en official "this Section governs the relations between the principal or the agent and the third party (article 2.2.1)";
}

@source(PICC_ART2_2_1_EN, PICC_ART2_2_1_FR)
rule SectionGovernsExternalRelations(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) strict {
    label en official "Article 2.2.1. This Section governs the authority of an agent to affect the legal relations of the principal with respect to a contract with a third party";
    when act_of_agent(x, ag, pr, tp);
    then external_relations_governed(x);
}

// --- Article 2.2.2: establishment and scope of the authority ------------------

pub relation authority_granted_expressly_or_impliedly(x: Act) kind empirical {
    label en official "the principal's grant of authority to the agent may be express or implied";
}

pub relation authority_covers_necessary_acts(x: Act) kind institutional {
    label en official "the agent has authority to perform all acts necessary in the circumstances to achieve the purposes for which the authority was granted (article 2.2.2(2))";
}

@source(PICC_ART2_2_2_EN, PICC_ART2_2_2_FR)
rule AuthorityCoversNecessaryActs(x: Act) strict {
    label en official "Article 2.2.2. The agent has authority to perform all acts necessary in the circumstances to achieve the purposes for which the authority was granted";
    when authority_granted_expressly_or_impliedly(x);
    then authority_covers_necessary_acts(x);
}

// --- Article 2.2.3(2): the agent undertakes to become a party itself ----------

pub relation agent_undertakes_to_be_party(x: Act) kind empirical {
    label en official "the agent, with the consent of the principal, undertakes to become the party to the contract";
}

@source(PICC_ART2_2_3_EN, PICC_ART2_2_3_FR)
rule AgentBecomesPartyItself(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeasible {
    label en official "Article 2.2.3(2). Where the agent with the consent of the principal undertakes to become the party to the contract, the acts affect only the relations between the agent and the third party";
    when act_of_agent(x, ag, pr, tp)
        and agent_undertakes_to_be_party(x);
    then affects_agent_and_third_party_only(x);
}

@source(PICC_ART2_2_3_EN, PICC_ART2_2_3_FR)
rule UndertakingDisplacesDisclosedAgency(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeater {
    label en official "Article 2.2.3(2). Where the agent undertakes to become the party, the acts do not directly affect the relations between principal and third party";
    when act_of_agent(x, ag, pr, tp)
        and agent_undertakes_to_be_party(x);
    defeat affects_principal_and_third_party(x);
}

// --- Article 2.2.4(2): the agent held itself out as the owner of the business -

pub relation agent_represented_itself_as_owner(x: Act) kind empirical {
    label en official "the agent, when contracting with the third party on behalf of a business, represents itself to be the owner of that business";
}

pub relation real_owner_discovered(x: Act) kind empirical {
    label en official "the third party has discovered the real owner of the business";
}

pub relation rights_exercisable_against_owner(x: Act) kind institutional {
    label en official "the third party may exercise also against the real owner the rights it has against the agent (article 2.2.4(2))";
}

@source(PICC_ART2_2_4_EN, PICC_ART2_2_4_FR)
rule RightsAgainstRealOwner(x: Act) strict {
    label en official "Article 2.2.4(2). Upon discovery of the real owner of the business the third party may exercise against the latter the rights it has against the agent";
    when agent_represented_itself_as_owner(x)
        and real_owner_discovered(x);
    then rights_exercisable_against_owner(x);
}

// --- Article 2.2.7(2)(b): the conflict was disclosed and not objected to ------

pub relation conflict_disclosed_without_objection(x: Act) kind empirical {
    label en official "the agent had disclosed the conflict of interests to the principal and the latter had not objected within a reasonable time";
}

@source(PICC_ART2_2_7_EN, PICC_ART2_2_7_FR)
rule DisclosedConflictBarsAvoidance(x: Act, ag: Agent, pr: Principal, tp: ThirdParty) defeater {
    label en official "Article 2.2.7(2)(b). The principal may not avoid the contract if the agent had disclosed the conflict of interests and the principal had not objected within a reasonable time";
    when act_of_agent(x, ag, pr, tp)
        and conflict_disclosed_without_objection(x);
    defeat principal_may_avoid_contract(x, pr);
}

// --- Article 2.2.9(2)-(3): time for ratification and refusal by the third party

pub relation ratification_period_specified(x: Act) kind empirical {
    label en official "the third party has by notice to the principal specified a reasonable period of time for ratification";
}

pub relation not_ratified_within_period(x: Act) kind empirical {
    label en official "the principal did not ratify within that period of time";
}

pub relation ratification_no_longer_possible(x: Act) kind institutional {
    label en official "the principal can no longer ratify the act (article 2.2.9(2))";
}

@source(PICC_ART2_2_9_EN, PICC_ART2_2_9_FR)
rule RatificationPeriodExpired(x: Act) strict {
    label en official "Article 2.2.9(2). If the principal does not ratify within the period specified by the third party it can no longer do so";
    when ratification_period_specified(x)
        and not_ratified_within_period(x);
    then ratification_no_longer_possible(x);
}

pub relation third_party_unaware_of_lack_of_authority(x: Act) kind empirical {
    label en official "at the time of the agent's act the third party neither knew nor ought to have known of the lack of authority";
}

pub relation third_party_refused_to_be_bound(x: Act) kind empirical {
    label en official "the third party has by notice to the principal indicated its refusal to become bound by a ratification";
}

pub relation ratification_ineffective_against_third_party(x: Act) kind institutional {
    label en official "the ratification does not bind the third party which refused it before ratification (article 2.2.9(3))";
}

@source(PICC_ART2_2_9_EN, PICC_ART2_2_9_FR)
rule RefusalBeforeRatification(x: Act) strict {
    label en official "Article 2.2.9(3). A third party that neither knew nor ought to have known of the lack of authority may, before ratification, indicate its refusal to become bound by a ratification";
    when third_party_unaware_of_lack_of_authority(x)
        and third_party_refused_to_be_bound(x);
    then ratification_ineffective_against_third_party(x);
}
