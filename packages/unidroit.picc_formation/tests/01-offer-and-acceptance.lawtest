language "law.core" version "0.2";
package unidroit.picc_formation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-formation";

// Case 1. The offer (2.1.2), when it becomes effective and its withdrawal
// (2.1.3), revocation (2.1.4), rejection (2.1.5), acceptance and silence
// (2.1.6), the period running from the DISPATCH of the offer (2.1.8), late
// acceptance (2.1.9), withdrawal of acceptance (2.1.10) and the two modes of
// conclusion (2.1.1).
//
// THE PERIOD IS COUNTED DIFFERENTLY FROM THE CONVENTION: it begins with the
// dispatch of the offer (02.03.2026), the last day is 01.04.2026, and an assent
// received on 01.04.2026 is in time.

test "PICCF-01-OFFER-AND-ACCEPTANCE" {
    given {
        context {
            deadline_policy PICC_ACCEPTANCE_PERIOD;
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": proposal_sufficiently_definite(entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a1": proposal_indicates_intention_to_be_bound(entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a2": offer_reached_offeree(entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a3": reply_to(entity_ref("urn:case:piccf:acc-1"), entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a4": indicates_assent(entity_ref("urn:case:piccf:acc-1")) { origin case_input; }
        assert "a5": assent_reached_offeror(entity_ref("urn:case:piccf:acc-1")) { origin case_input; }
        assert "a6": offer_dispatched_on(entity_ref("urn:case:piccf:offer-1"), @2026-03-02) { origin case_input; }
        assert "a7": acceptance_period(entity_ref("urn:case:piccf:offer-1"), 30 calendar_day) { origin case_input; }
        assert "a8": acceptance_reached_offeror_on(entity_ref("urn:case:piccf:acc-1"), @2026-04-01) { origin case_input; }
        assert "a9": concluded_by_acceptance(entity_ref("urn:case:piccf:contract-1"), entity_ref("urn:case:piccf:acc-1")) { origin case_input; }
        assert "a10": reply_to(entity_ref("urn:case:piccf:silence-1"), entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a11": silence_or_inactivity_only(entity_ref("urn:case:piccf:silence-1")) { origin case_input; }
        assert "a12": withdrawal_reached_before_or_with_offer(entity_ref("urn:case:piccf:offer-1b")) { origin case_input; }
        assert "a13": offer_reached_offeree(entity_ref("urn:case:piccf:offer-1b")) { origin case_input; }
        assert "a14": revocation_reached_before_dispatch_of_acceptance(entity_ref("urn:case:piccf:offer-1c")) { origin case_input; }
        assert "a15": revocation_reached_before_dispatch_of_acceptance(entity_ref("urn:case:piccf:offer-1d")) { origin case_input; }
        assert "a16": offer_states_irrevocability(entity_ref("urn:case:piccf:offer-1d")) { origin case_input; }
        assert "a17": rejection_reached_offeror(entity_ref("urn:case:piccf:offer-1e")) { origin case_input; }
        assert "a18": offer_reached_offeree(entity_ref("urn:case:piccf:offer-1e")) { origin case_input; }
        assert "a19": conduct_sufficient_to_show_agreement(entity_ref("urn:case:piccf:contract-1b")) { origin case_input; }
        assert "a20": reply_to(entity_ref("urn:case:piccf:acc-1b"), entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a21": acceptance_late(entity_ref("urn:case:piccf:acc-1b")) { origin case_input; }
        assert "a22": offeror_informed_without_undue_delay(entity_ref("urn:case:piccf:acc-1b")) { origin adjudicated; }
        assert "a23": indicates_assent(entity_ref("urn:case:piccf:acc-1c")) { origin case_input; }
        assert "a24": reply_to(entity_ref("urn:case:piccf:acc-1c"), entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "a25": assent_reached_offeror(entity_ref("urn:case:piccf:acc-1c")) { origin case_input; }
        assert "a26": acceptance_reached_offeror_on(entity_ref("urn:case:piccf:acc-1c"), @2026-03-20) { origin case_input; }
        assert "a27": acceptance_withdrawal_in_time(entity_ref("urn:case:piccf:acc-1c")) { origin case_input; }
        assert "p0": reply_to(entity_ref("urn:case:piccf:acc-perf"), entity_ref("urn:case:piccf:offer-1")) { origin case_input; }
        assert "p1": assent_by_act_permitted(entity_ref("urn:case:piccf:acc-perf")) { origin case_input; }
        assert "p2": act_of_assent_performed(entity_ref("urn:case:piccf:acc-perf")) { origin case_input; }

    }

    evaluate truth(is_offer(entity_ref("urn:case:piccf:offer-1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(ProposalIsOffer);

    evaluate truth(offer_effective(entity_ref("urn:case:piccf:offer-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(OfferBecomesEffective);

    evaluate truth(offer_effective(entity_ref("urn:case:piccf:offer-1b")));
    expect truth_status == NEITHER;

    evaluate truth(offer_revoked(entity_ref("urn:case:piccf:offer-1c")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(OfferRevoked);

    evaluate truth(offer_revoked(entity_ref("urn:case:piccf:offer-1d")));
    expect truth_status == NEITHER;

    evaluate truth(offer_effective(entity_ref("urn:case:piccf:offer-1e")));
    expect truth_status == NEITHER;

    evaluate truth(acceptance_period_runs_from(entity_ref("urn:case:piccf:offer-1"), @2026-03-02));
    expect truth_status == TRUE_ONLY;
    expect any_applied(PeriodRunsFromDispatch);

    evaluate truth(acceptance_period_ends_on(entity_ref("urn:case:piccf:offer-1"), @2026-04-01));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AcceptancePeriodEnds);

    evaluate truth(acceptance_in_time(entity_ref("urn:case:piccf:acc-1"), entity_ref("urn:case:piccf:offer-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AcceptanceWithinFixedPeriod);

    evaluate truth(acceptance_effective(entity_ref("urn:case:piccf:acc-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AcceptanceEffective);

    evaluate truth(contract_concluded(entity_ref("urn:case:piccf:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ConcludedByAcceptance);

    evaluate truth(contract_concluded(entity_ref("urn:case:piccf:contract-1b")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ConcludedByConduct);

    evaluate truth(is_acceptance(entity_ref("urn:case:piccf:silence-1")));
    expect truth_status == FALSE_ONLY;
    expect any_applied(SilenceIsNotAcceptance);

    evaluate truth(is_acceptance(entity_ref("urn:case:piccf:acc-1b")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(LateAcceptanceSavedByOfferor);

    // Withdrawal of acceptance: the defeater only blocks.
    evaluate truth(acceptance_effective(entity_ref("urn:case:piccf:acc-1c")));
    expect truth_status == NEITHER;

    // Article 2.1.6(3): assent is indicated by performing an act without notice to
    // the offeror — acceptance is effective on the act, not on receipt.
    evaluate truth(is_acceptance(entity_ref("urn:case:piccf:acc-perf")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AssentByPerformedActIsAcceptance);

    evaluate truth(acceptance_effective(entity_ref("urn:case:piccf:acc-perf")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AcceptanceEffectiveOnPerformance);
}
