// Глава 10 Принципов: исковая давность.
//
// У КОНВЕНЦИИ ЭТОЙ ГЛАВЫ НЕТ ВОВСЕ. Исковая давность вынесена за пределы
// Конвенции 1980 года (отдельная Нью-Йоркская конвенция 1974 года об исковой
// давности в международной купле-продаже товаров); Принципы дают собственный
// режим, и потому глава 10 — ещё один ответ там, где Конвенция молчит.
//
// ДВА СРОКА СРАЗУ, И ОНИ СЧИТАЮТСЯ ОТ РАЗНЫХ ДНЕЙ: общий — три года со дня,
// СЛЕДУЮЩЕГО за днём, когда кредитор узнал или должен был узнать о фактах;
// максимальный — десять лет со дня, СЛЕДУЮЩЕГО за днём, когда право может
// быть осуществлено. Политика §86 пакета считает от следующего дня, и это
// свойство текста, а не умолчание модели.
//
// ИСТЕЧЕНИЕ ДАВНОСТИ ПРАВО НЕ ПРЕКРАЩАЕТ (ст. 10.9 п. 1): оно действует
// только как возражение должника и только будучи заявленным.

language "law.core" version "0.2";
package unidroit.picc_limitation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-limitation";

import unidroit.picc version "0.1.0";

type Party = unidroit.picc::Party;
type Contract = unidroit.picc::Contract;
type Organ = unidroit.picc::Organ;

deadline policy PICC_LIMITATION {
    start_count next_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
    label ru unofficial "суд или арбитраж, рассматривающий спор (статья 1.11)";
};

pub entity Right {
    label en official "Right governed by the Principles";
    label ru unofficial "Право, регулируемое Принципами";
}

pub relation right_of(r: Right, c: Contract, obligee: Party, obligor: Party) kind empirical {
    label en official "the right belongs to the obligee against the obligor under that contract";
    label ru unofficial "право принадлежит кредитору против должника по этому договору";
}
