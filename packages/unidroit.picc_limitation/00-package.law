// Chapter 10 of the Principles: limitation periods.
//
// THE CONVENTION HAS NO SUCH CHAPTER AT ALL. Limitation is left outside the 1980
// Convention (a separate 1974 New York Convention deals with the limitation
// period in the international sale of goods); the Principles provide a regime of
// their own, which makes chapter 10 one more answer where the Convention is
// silent.
//
// TWO PERIODS RUN AT ONCE, AND THEY ARE COUNTED FROM DIFFERENT DAYS: the general
// period is three years beginning on the day AFTER the day the obligee knew or
// ought to have known the facts; the maximum period is ten years beginning on
// the day AFTER the day the right could be exercised. The §86 policy of this
// package counts from the next day, and that is a property of the text rather
// than a default of the model.
//
// EXPIRY DOES NOT EXTINGUISH THE RIGHT (article 10.9(1)): it operates only as a
// defence of the obligor, and only if invoked.

language "law.core" version "0.2";
package unidroit.picc_limitation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-limitation";

import unidroit.picc version "0.1.0";

type Party = unidroit.picc::Party;
type Contract = unidroit.picc::Contract;
type Organ = unidroit.picc::Organ;

deadline policy PICC_LIMITATION {
    start_count next_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
};

pub entity Right {
    label en official "Right governed by the Principles";
}

pub relation right_of(r: Right, c: Contract, obligee: Party, obligor: Party) kind empirical {
    label en official "the right belongs to the obligee against the obligor under that contract";
}
