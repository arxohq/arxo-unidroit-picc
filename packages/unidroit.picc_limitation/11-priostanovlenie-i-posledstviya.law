// Статьи 10.5-10.11. Приостановление течения срока и последствия его истечения.

language "law.core" version "0.2";
package unidroit.picc_limitation version "0.1.0";
namespace "urn:org:unidroit:clir:picc-limitation";

// --- Статьи 10.5-10.7: приостановление разбирательствами ---------------------------

pub relation judicial_act_asserting_right(r: Right) kind empirical {
    label en official "the obligee performs an act, by commencing judicial proceedings or in proceedings already instituted, that is recognised by the law of the court as asserting its right";
    label ru unofficial "кредитор совершает действие, возбуждая судебное разбирательство или в уже начатом, признаваемое правом суда как заявление его права";
}

pub relation right_asserted_in_insolvency(r: Right) kind empirical {
    label en official "in the case of the obligor's insolvency the obligee has asserted its rights in the insolvency proceedings";
    label ru unofficial "при несостоятельности должника кредитор заявил свои права в деле о несостоятельности";
}

pub relation right_asserted_in_dissolution(r: Right) kind empirical {
    label en official "in the case of proceedings for dissolution of the obligor the obligee has asserted its rights in those proceedings";
    label ru unofficial "при разбирательстве о ликвидации должника кредитор заявил свои права в этом разбирательстве";
}

pub relation arbitral_act_asserting_right(r: Right) kind empirical {
    label en official "the obligee performs an act, by commencing arbitral proceedings or in proceedings already instituted, that is recognised by the law of the arbitral tribunal as asserting its right";
    label ru unofficial "кредитор совершает действие, возбуждая арбитражное разбирательство или в уже начатом, признаваемое правом арбитража как заявление его права";
}

pub relation request_for_adjudication_reached_obligor(r: Right) kind empirical {
    label en official "a request that the right in dispute should be adjudicated has reached the obligor, and there are no provisions determining the exact date of commencement";
    label ru unofficial "требование о рассмотрении спорного права достигло должника, а положений о точной дате начала разбирательства нет";
}

pub relation amicable_settlement_proceedings(r: Right) kind empirical {
    label en official "the parties request a third person to assist them in their attempt to reach an amicable settlement of their dispute";
    label ru unofficial "стороны просят третье лицо содействовать им в попытке достичь мирового соглашения";
}

pub relation proceedings_terminated(r: Right) kind empirical {
    label en official "a final or binding decision has been issued or the proceedings have been otherwise terminated";
    label ru unofficial "вынесено окончательное или обязательное решение либо разбирательство иным образом завершено";
}

pub relation limitation_suspended(r: Right) kind institutional {
    label en official "the running of the limitation period is suspended (articles 10.5-10.8)";
    label ru unofficial "течение срока исковой давности приостановлено (статьи 10.5-10.8)";
}

pub relation arbitral_proceedings_deemed_commenced(r: Right) kind institutional {
    label en official "the arbitral proceedings are deemed to commence on the date on which the request reaches the obligor (article 10.6(1))";
    label ru unofficial "арбитражное разбирательство считается начатым в день, когда требование достигает должника (статья 10.6 пункт 1)";
}

@source(PICC_ART10_5_EN, PICC_ART10_5_RU)
rule SuspensionByJudicialAct(r: Right) defeasible {
    label en official "Article 10.5(1)(a). The running of the limitation period is suspended when the obligee performs an act recognised by the law of the court as asserting its right";
    label ru unofficial "Статья 10.5 пункт 1 подпункт a. Течение срока приостанавливается, когда кредитор совершает действие, признаваемое правом суда как заявление его права";
    when judicial_act_asserting_right(r)
        and not_known(proceedings_terminated(r));
    then limitation_suspended(r);
}

@source(PICC_ART10_5_EN, PICC_ART10_5_RU)
rule SuspensionByInsolvencyClaim(r: Right) defeasible {
    label en official "Article 10.5(1)(b). The running of the limitation period is suspended where the obligee has asserted its rights in the insolvency proceedings";
    label ru unofficial "Статья 10.5 пункт 1 подпункт b. Течение срока приостанавливается, когда кредитор заявил права в деле о несостоятельности";
    when right_asserted_in_insolvency(r)
        and not_known(proceedings_terminated(r));
    then limitation_suspended(r);
}

@source(PICC_ART10_5_EN, PICC_ART10_5_RU)
rule SuspensionByDissolutionClaim(r: Right) defeasible {
    label en official "Article 10.5(1)(c). The running of the limitation period is suspended where the obligee has asserted its rights in proceedings for dissolution of the obligor";
    label ru unofficial "Статья 10.5 пункт 1 подпункт c. Течение срока приостанавливается, когда кредитор заявил права в разбирательстве о ликвидации должника";
    when right_asserted_in_dissolution(r)
        and not_known(proceedings_terminated(r));
    then limitation_suspended(r);
}

@source(PICC_ART10_6_EN, PICC_ART10_6_RU)
rule SuspensionByArbitralAct(r: Right) defeasible {
    label en official "Article 10.6(1). The running of the limitation period is suspended when the obligee performs an act recognised by the law of the arbitral tribunal as asserting its right";
    label ru unofficial "Статья 10.6 пункт 1. Течение срока приостанавливается, когда кредитор совершает действие, признаваемое правом арбитража как заявление его права";
    when arbitral_act_asserting_right(r)
        and not_known(proceedings_terminated(r));
    then limitation_suspended(r);
}

@source(PICC_ART10_6_EN, PICC_ART10_6_RU)
rule ArbitrationCommencesOnRequest(r: Right) strict {
    label en official "Article 10.6(1). In the absence of provisions determining the exact date of commencement, arbitral proceedings are deemed to commence on the date on which the request reaches the obligor";
    label ru unofficial "Статья 10.6 пункт 1. При отсутствии положений о точной дате начала арбитражное разбирательство считается начатым в день, когда требование достигает должника";
    when request_for_adjudication_reached_obligor(r);
    then arbitral_proceedings_deemed_commenced(r);
}

@source(PICC_ART10_7_EN, PICC_ART10_7_RU)
rule SuspensionByAmicableSettlementProceedings(r: Right) defeasible {
    label en official "Article 10.7. Articles 10.5 and 10.6 apply with appropriate modifications to proceedings whereby the parties request a third person to assist them in reaching an amicable settlement";
    label ru unofficial "Статья 10.7. Статьи 10.5 и 10.6 применяются с соответствующими изменениями к разбирательствам, в которых стороны просят третье лицо содействовать мировому соглашению";
    when amicable_settlement_proceedings(r)
        and not_known(proceedings_terminated(r));
    then limitation_suspended(r);
}

// --- Статья 10.8: непреодолимая сила, смерть и недееспособность ---------------------

pub relation impediment_beyond_control(r: Right) kind empirical {
    label en official "the obligee has been prevented by an impediment beyond its control which it could neither avoid nor overcome from causing the limitation period to cease to run";
    label ru unofficial "кредитору помешало препятствие вне его контроля, которого он не мог ни избежать, ни преодолеть, прекратить течение срока";
}

pub relation impediment_ceased_on(r: Right, day: Date) kind empirical {
    label en official "the day on which the relevant impediment ceased to exist";
    label ru unofficial "день, в который препятствие перестало существовать";
}

pub relation representative_or_successor_appointed(r: Right) kind empirical {
    label en official "a representative for the incapacitated or deceased party or its estate has been appointed, or a successor has inherited the party's position";
    label ru unofficial "назначен представитель недееспособной или умершей стороны либо её имущества, или правопреемник унаследовал её положение";
}

pub relation additional_year(r: Right, span: Quantity) kind empirical {
    label en official "the additional period of one year under article 10.8(1)";
    label ru unofficial "дополнительный годичный срок по статье 10.8 пункту 1";
}

pub relation general_period_not_expiring_before(r: Right, day: Date) kind derived {
    label en official "the general limitation period is suspended so as not to expire before one year after the impediment has ceased (article 10.8)";
    label ru unofficial "общий срок приостановлен так, чтобы не истечь ранее чем через год после прекращения препятствия (статья 10.8)";
}

@source(PICC_ART10_8_EN, PICC_ART10_8_RU)
rule SuspensionByImpediment(r: Right, day: Date, span: Quantity) defeasible {
    label en official "Article 10.8(1). Where the obligee has been prevented by an impediment beyond its control, the general limitation period is suspended so as not to expire before one year after the impediment has ceased to exist";
    label ru unofficial "Статья 10.8 пункт 1. Если кредитору помешало препятствие вне его контроля, общий срок приостанавливается так, чтобы не истечь ранее чем через год после прекращения препятствия";
    when impediment_beyond_control(r)
        and impediment_ceased_on(r, day)
        and additional_year(r, span);
    then general_period_not_expiring_before(r, add_calendar_period(day, span));
}

@source(PICC_ART10_8_EN, PICC_ART10_8_RU)
rule SuspensionByIncapacityEndsOnAppointment(r: Right) defeasible {
    label en official "Article 10.8(2). Where the impediment consists of the incapacity or death of a party, suspension ceases when a representative or successor has been appointed; the additional one-year period applies accordingly";
    label ru unofficial "Статья 10.8 пункт 2. Если препятствием является недееспособность или смерть стороны, приостановление прекращается с назначением представителя или правопреемника; дополнительный годичный срок применяется соответственно";
    when impediment_beyond_control(r)
        and not_known(representative_or_successor_appointed(r));
    then limitation_suspended(r);
}

// --- Статьи 10.9-10.11: последствия истечения --------------------------------------

pub relation limitation_expired(r: Right) kind empirical {
    label en official "the limitation period for the right has expired";
    label ru unofficial "срок исковой давности по праву истёк";
}

pub relation expiration_asserted_as_defence(r: Right) kind empirical {
    label en official "the obligor has asserted the expiration of the limitation period as a defence";
    label ru unofficial "должник заявил истечение срока исковой давности как возражение";
}

pub relation right_relied_on_as_defence(r: Right) kind empirical {
    label en official "the right is relied on as a defence";
    label ru unofficial "право используется как возражение";
}

pub relation set_off_exercised(r: Right) kind empirical {
    label en official "the obligee exercises a right of set-off";
    label ru unofficial "кредитор осуществляет право на зачёт";
}

pub relation performance_rendered_after_expiration(r: Right) kind empirical {
    label en official "performance has been rendered in order to discharge the obligation after the limitation period expired";
    label ru unofficial "исполнение произведено во исполнение обязательства после истечения срока давности";
}

pub relation right_not_extinguished(r: Right) kind institutional {
    label en official "the expiration of the limitation period does not extinguish the right (article 10.9(1))";
    label ru unofficial "истечение срока исковой давности право не прекращает (статья 10.9 пункт 1)";
}

pub relation exercise_barred(r: Right) kind institutional {
    label en official "the expiration of the limitation period has effect and bars the exercise of the right (article 10.9(2))";
    label ru unofficial "истечение срока исковой давности имеет силу и препятствует осуществлению права (статья 10.9 пункт 2)";
}

pub relation defence_still_available(r: Right) kind institutional {
    label en official "the right may still be relied on as a defence even though its limitation has been asserted (article 10.9(3))";
    label ru unofficial "право может использоваться как возражение, даже если заявлено истечение срока по нему (статья 10.9 пункт 3)";
}

pub relation set_off_still_available(r: Right) kind institutional {
    label en official "the obligee may exercise the right of set-off until the obligor has asserted the expiration of the limitation period (article 10.10)";
    label ru unofficial "кредитор может осуществить право на зачёт, пока должник не заявил об истечении срока (статья 10.10)";
}

pub relation no_restitution_for_expired_right(r: Right) kind institutional {
    label en official "there is no right of restitution merely because the limitation period had expired (article 10.11)";
    label ru unofficial "права на возврат исполненного лишь потому, что срок истёк, нет (статья 10.11)";
}

@source(PICC_ART10_9_EN, PICC_ART10_9_RU)
rule ExpirationDoesNotExtinguishRight(r: Right) strict {
    label en official "Article 10.9(1). The expiration of the limitation period does not extinguish the right";
    label ru unofficial "Статья 10.9 пункт 1. Истечение срока исковой давности право не прекращает";
    when limitation_expired(r);
    then right_not_extinguished(r);
}

@source(PICC_ART10_9_EN, PICC_ART10_9_RU)
rule ExpirationNeedsToBeAsserted(r: Right) defeasible {
    label en official "Article 10.9(2). For the expiration of the limitation period to have effect, the obligor must assert it as a defence";
    label ru unofficial "Статья 10.9 пункт 2. Чтобы истечение срока имело силу, должник обязан заявить его как возражение";
    when limitation_expired(r)
        and expiration_asserted_as_defence(r);
    then exercise_barred(r);
}

@source(PICC_ART10_9_EN, PICC_ART10_9_RU)
rule RightStillAvailableAsDefence(r: Right) defeasible {
    label en official "Article 10.9(3). A right may still be relied on as a defence even though the expiration of the limitation period for that right has been asserted";
    label ru unofficial "Статья 10.9 пункт 3. Право может использоваться как возражение, даже если заявлено истечение срока по нему";
    when right_relied_on_as_defence(r)
        and expiration_asserted_as_defence(r);
    then defence_still_available(r);
}

@source(PICC_ART10_10_EN, PICC_ART10_10_RU)
rule SetOffUntilExpirationAsserted(r: Right) defeasible {
    label en official "Article 10.10. The obligee may exercise the right of set-off until the obligor has asserted the expiration of the limitation period";
    label ru unofficial "Статья 10.10. Кредитор может осуществить право на зачёт, пока должник не заявил об истечении срока исковой давности";
    when set_off_exercised(r)
        and not_known(expiration_asserted_as_defence(r));
    then set_off_still_available(r);
}

@source(PICC_ART10_11_EN, PICC_ART10_11_RU)
rule NoRestitutionAfterExpiration(r: Right) strict {
    label en official "Article 10.11. Where there has been performance in order to discharge an obligation, there is no right of restitution merely because the limitation period has expired";
    label ru unofficial "Статья 10.11. Если исполнение произведено во исполнение обязательства, права на возврат лишь потому, что срок давности истёк, нет";
    when performance_rendered_after_expiration(r);
    then no_restitution_for_expired_right(r);
}
