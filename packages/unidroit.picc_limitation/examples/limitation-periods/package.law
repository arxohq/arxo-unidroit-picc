language "law.core" version "0.2";
package examples.unidroit.limitation_periods version "0.1.0";
namespace "urn:law:examples:unidroit:limitation-periods";

import unidroit.picc version "0.1.0";
import unidroit.picc_limitation version "0.1.0";

// The §86 policy is declared by the package that EXECUTES the case, not by the
// one that owns the norms (LDC-E1332): a case is counted by the policy of the
// document that answers it. These parameters repeat the policy of
// `unidroit.picc_limitation` word for word, because article 10.2 counts
// "beginning on the day after the day…" and knows no calendar of business days.
deadline policy PICC_LIMITATION {
    start_count next_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
