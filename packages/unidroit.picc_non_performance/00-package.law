// Chapter 7 of the Principles: non-performance.
//
// THE COMPARISON WITH THE CONVENTION IS DENSEST HERE, AND IT IS NOT AN IDENTITY:
//  · "fundamental non-performance" (article 7.3.1) lists five circumstances,
//    whereas article 25 of the Convention gives one definition with
//    foreseeability;
//  · the right to cure (article 7.1.4) is arranged differently from articles 37
//    and 48 of the Convention and is NOT precluded by a notice of termination
//    (paragraph 2);
//  · the excuse for an impediment (article 7.1.7) is close to article 79 of the
//    Convention, but renegotiation and adaptation live elsewhere — in articles
//    6.2.1-6.2.3;
//  · interest is named as a rate (article 7.4.9), whereas article 78 of the
//    Convention names no rate at all — and that is the answer under article 7(2).

language "law.core" version "0.2";
package unidroit.picc_non_performance version "0.1.0";
namespace "urn:org:unidroit:clir:picc-non-performance";

import unidroit.picc version "0.1.0";

type Party = unidroit.picc::Party;
type Contract = unidroit.picc::Contract;
type Term = unidroit.picc::Term;
type Organ = unidroit.picc::Organ;

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
};

pub entity Obligation {
    label en official "Obligation under the contract";
}

pub entity NonPerformance {
    label en official "Non-performance";
}

pub relation obligation_of(o: Obligation, c: Contract, p: Party) kind empirical {
    label en official "the obligation arises under the contract and is owed by the party";
}

pub relation non_performance_of(n: NonPerformance, o: Obligation, p: Party) kind empirical {
    label en official "the non-performance concerns that obligation of that party";
}

pub relation party_to_contract(c: Contract, p: Party) kind empirical {
    label en official "the party is a party to that contract";
}

pub relation aggrieved_party(n: NonPerformance, p: Party) kind empirical {
    label en official "the party is the one aggrieved by that non-performance";
}

pub relation obligee_of(o: Obligation, p: Party) kind empirical {
    label en official "the party is the obligee of that obligation";
}

