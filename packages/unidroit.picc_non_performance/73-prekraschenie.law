// Статьи 7.3.1-7.3.7. Прекращение договора.
//
// ГЛАВНОЕ ОТЛИЧИЕ ОТ СТАТЬИ 25 КОНВЕНЦИИ: существенность неисполнения здесь
// не одно определение с предвидимостью, а ПЯТЬ названных обстоятельств
// пункта 2, причём последнее (несоразмерная потеря неисполнившей стороны)
// работает ПРОТИВ прекращения. Поэтому у каждого — своя голова, а пятое
// записано дефитером.

language "law.core" version "0.2";
package unidroit.picc_non_performance version "0.1.0";
namespace "urn:org:unidroit:clir:picc-non-performance";

pub external judgment relation substantially_deprives_of_expectation(n: NonPerformance) {
    authority Tribunal;
    label en official "the non-performance substantially deprives the aggrieved party of what it was entitled to expect under the contract";
    label ru unofficial "неисполнение существенно лишает потерпевшую сторону того, на что она была вправе рассчитывать по договору";
}

pub relation result_not_foreseeable(n: NonPerformance) kind empirical {
    label en official "the other party did not foresee and could not reasonably have foreseen such result";
    label ru unofficial "другая сторона не предвидела и не могла разумно предвидеть такой результат";
}

pub relation strict_compliance_of_essence(n: NonPerformance) kind empirical {
    label en official "strict compliance with the obligation which has not been performed is of essence under the contract";
    label ru unofficial "строгое соблюдение неисполненного обязательства имеет существенное значение по договору";
}

pub relation non_performance_intentional_or_reckless(n: NonPerformance) kind empirical {
    label en official "the non-performance is intentional or reckless";
    label ru unofficial "неисполнение является умышленным или совершено по грубой неосторожности";
}

pub relation no_reliance_on_future_performance(n: NonPerformance) kind empirical {
    label en official "the non-performance gives the aggrieved party reason to believe that it cannot rely on the other party's future performance";
    label ru unofficial "неисполнение даёт потерпевшей стороне основание полагать, что она не может полагаться на будущее исполнение другой стороны";
}

pub external judgment relation disproportionate_loss_on_termination(n: NonPerformance) {
    authority Tribunal;
    label en official "the non-performing party will suffer disproportionate loss as a result of the preparation or performance if the contract is terminated";
    label ru unofficial "неисполнившая сторона понесёт несоразмерные потери в результате подготовки или исполнения, если договор будет прекращён";
}

pub relation fundamental_non_performance(n: NonPerformance) kind institutional {
    label en official "the failure amounts to a fundamental non-performance (article 7.3.1)";
    label ru unofficial "нарушение является существенным неисполнением (статья 7.3.1)";
}

pub relation may_terminate_contract(c: Contract, p: Party) kind institutional {
    label en official "the party may terminate the contract (articles 7.3.1, 7.3.3, 7.3.4)";
    label ru unofficial "сторона может прекратить договор (статьи 7.3.1, 7.3.3, 7.3.4)";
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule FundamentalByDeprivation(n: NonPerformance, o: Obligation, p: Party) defeasible {
    label en official "Article 7.3.1(2)(a). Regard is to be had to whether the non-performance substantially deprives the aggrieved party of what it was entitled to expect, unless that result was not foreseeable";
    label ru unofficial "Статья 7.3.1 пункт 2 подпункт a. Учитывается, лишает ли неисполнение потерпевшую сторону того, на что она была вправе рассчитывать, если такой результат был предвидим";
    when non_performance_of(n, o, p)
        and substantially_deprives_of_expectation(n)
        and not_known(result_not_foreseeable(n));
    then fundamental_non_performance(n);
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule FundamentalByEssence(n: NonPerformance, o: Obligation, p: Party) defeasible {
    label en official "Article 7.3.1(2)(b). Regard is to be had to whether strict compliance with the obligation is of essence under the contract";
    label ru unofficial "Статья 7.3.1 пункт 2 подпункт b. Учитывается, имеет ли строгое соблюдение обязательства существенное значение по договору";
    when non_performance_of(n, o, p)
        and strict_compliance_of_essence(n);
    then fundamental_non_performance(n);
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule FundamentalByIntent(n: NonPerformance, o: Obligation, p: Party) defeasible {
    label en official "Article 7.3.1(2)(c). Regard is to be had to whether the non-performance is intentional or reckless";
    label ru unofficial "Статья 7.3.1 пункт 2 подпункт c. Учитывается, является ли неисполнение умышленным или совершённым по грубой неосторожности";
    when non_performance_of(n, o, p)
        and non_performance_intentional_or_reckless(n);
    then fundamental_non_performance(n);
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule FundamentalByLossOfConfidence(n: NonPerformance, o: Obligation, p: Party) defeasible {
    label en official "Article 7.3.1(2)(d). Regard is to be had to whether the non-performance gives the aggrieved party reason to believe that it cannot rely on the other party's future performance";
    label ru unofficial "Статья 7.3.1 пункт 2 подпункт d. Учитывается, даёт ли неисполнение основание полагать, что на будущее исполнение другой стороны положиться нельзя";
    when non_performance_of(n, o, p)
        and no_reliance_on_future_performance(n);
    then fundamental_non_performance(n);
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule DisproportionateLossAgainstFundamentality(n: NonPerformance, o: Obligation, p: Party) defeater {
    label en official "Article 7.3.1(2)(e). Regard is to be had to whether the non-performing party will suffer disproportionate loss as a result of the preparation or performance if the contract is terminated";
    label ru unofficial "Статья 7.3.1 пункт 2 подпункт e. Учитывается, понесёт ли неисполнившая сторона несоразмерные потери в результате подготовки или исполнения, если договор будет прекращён";
    when non_performance_of(n, o, p)
        and disproportionate_loss_on_termination(n);
    defeat fundamental_non_performance(n);
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule TerminationForFundamentalNonPerformance(n: NonPerformance, o: Obligation, c: Contract, p: Party, other: Party) defeasible {
    label en official "Article 7.3.1(1). A party may terminate the contract where the failure of the other party amounts to a fundamental non-performance";
    label ru unofficial "Статья 7.3.1 пункт 1. Сторона может прекратить договор, если нарушение другой стороны является существенным неисполнением";
    when obligation_of(o, c, p)
        and non_performance_of(n, o, p)
        and aggrieved_party(n, other)
        and fundamental_non_performance(n);
    then may_terminate_contract(c, other);
}

@source(PICC_ART7_3_1_EN, PICC_ART7_3_1_RU)
rule TerminationAfterAdditionalPeriodForDelayCase(n: NonPerformance, o: Obligation, c: Contract, p: Party, other: Party) defeasible {
    label en official "Article 7.3.1(3). In the case of delay the aggrieved party may also terminate the contract if the other party fails to perform before the time allowed under Article 7.1.5 has expired";
    label ru unofficial "Статья 7.3.1 пункт 3. При просрочке потерпевшая сторона может прекратить договор и тогда, когда другая сторона не исполнила до истечения срока, предоставленного по статье 7.1.5";
    when obligation_of(o, c, p)
        and non_performance_of(n, o, p)
        and aggrieved_party(n, other)
        and delay_is_not_fundamental(n)
        and additional_period_allowed_by_notice(n)
        and additional_period_expired_without_performance(n);
    then may_terminate_contract(c, other);
}

// --- Статья 7.3.2: извещение о прекращении ----------------------------------------

pub relation termination_notice_within_reasonable_time(n: NonPerformance) kind empirical {
    label en official "notice of termination was given within a reasonable time after the aggrieved party became, or ought to have become, aware of the late or non-conforming performance";
    label ru unofficial "извещение о прекращении дано в разумный срок после того, как потерпевшая сторона узнала или должна была узнать о запоздалом или несоответствующем исполнении";
}

pub relation late_or_non_conforming_performance_offered(n: NonPerformance) kind empirical {
    label en official "performance has been offered late or otherwise does not conform to the contract";
    label ru unofficial "исполнение предложено с опозданием или иным образом не соответствует договору";
}

pub relation contract_terminated(c: Contract) kind institutional {
    label en official "the contract is terminated by notice (article 7.3.2(1))";
    label ru unofficial "договор прекращён извещением (статья 7.3.2 пункт 1)";
}

pub relation termination_notice_given_by(c: Contract, p: Party) kind empirical {
    label en official "the party has given notice of termination to the other party";
    label ru unofficial "сторона дала другой стороне извещение о прекращении договора";
}

@source(PICC_ART7_3_2_EN, PICC_ART7_3_2_RU)
rule TerminationExercisedByNotice(c: Contract, p: Party) strict {
    label en official "Article 7.3.2(1). The right of a party to terminate the contract is exercised by notice to the other party";
    label ru unofficial "Статья 7.3.2 пункт 1. Право стороны прекратить договор осуществляется извещением другой стороны";
    when may_terminate_contract(c, p);
    then power TerminateByNotice {
        holder p;
        over c;
        exercise termination_notice_given_by(c, p);
        valid_when may_terminate_contract(c, p);
        effect create(contract_terminated(c));
    };
}

@source(PICC_ART7_3_2_EN, PICC_ART7_3_2_RU)
rule NoticeTerminatesContract(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.2. On notice to the other party the contract is terminated";
    label ru unofficial "Статья 7.3.2. Извещением другой стороны договор прекращается";
    when may_terminate_contract(c, p)
        and termination_notice_given_by(c, p);
    then contract_terminated(c);
}

@source(PICC_ART7_3_2_EN, PICC_ART7_3_2_RU)
rule LateNoticeLosesRightToTerminate(n: NonPerformance, o: Obligation, c: Contract, p: Party, other: Party) defeater {
    label en official "Article 7.3.2(2). If performance has been offered late or otherwise does not conform to the contract, the aggrieved party loses its right to terminate unless it gives notice within a reasonable time";
    label ru unofficial "Статья 7.3.2 пункт 2. Если исполнение предложено с опозданием или не соответствует договору, потерпевшая сторона теряет право прекратить договор, если не известит в разумный срок";
    when obligation_of(o, c, p)
        and non_performance_of(n, o, p)
        and aggrieved_party(n, other)
        and late_or_non_conforming_performance_offered(n)
        and not_known(termination_notice_within_reasonable_time(n));
    defeat may_terminate_contract(c, other);
}

// --- Статьи 7.3.3 и 7.3.4: предвидимое неисполнение и заверения ---------------------

pub relation clear_that_fundamental_non_performance_will_occur(c: Contract) kind empirical {
    label en official "prior to the date for performance it is clear that there will be a fundamental non-performance by that party";
    label ru unofficial "до наступления срока исполнения очевидно, что эта сторона допустит существенное неисполнение";
}

pub external judgment relation reasonable_belief_of_fundamental_non_performance(c: Contract, p: Party) {
    authority Tribunal;
    label en official "the party reasonably believes that there will be a fundamental non-performance by the other party";
    label ru unofficial "сторона разумно полагает, что другая сторона допустит существенное неисполнение";
}

pub relation assurance_demanded(c: Contract, p: Party) kind empirical {
    label en official "the party has demanded adequate assurance of due performance";
    label ru unofficial "сторона потребовала надлежащих заверений в должном исполнении";
}

pub relation assurance_provided_within_reasonable_time(c: Contract) kind empirical {
    label en official "adequate assurance of due performance was provided within a reasonable time";
    label ru unofficial "надлежащие заверения в должном исполнении предоставлены в разумный срок";
}

pub relation may_withhold_pending_assurance(c: Contract, p: Party) kind institutional {
    label en official "the party demanding assurance may meanwhile withhold its own performance (article 7.3.4)";
    label ru unofficial "сторона, потребовавшая заверений, может тем временем приостановить своё исполнение (статья 7.3.4)";
}

@source(PICC_ART7_3_3_EN, PICC_ART7_3_3_RU)
rule AnticipatoryNonPerformance(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.3. Where prior to the date for performance it is clear that there will be a fundamental non-performance, the other party may terminate the contract";
    label ru unofficial "Статья 7.3.3. Если до наступления срока исполнения очевидно существенное неисполнение, другая сторона может прекратить договор";
    when party_to_contract(c, p)
        and clear_that_fundamental_non_performance_will_occur(c);
    then may_terminate_contract(c, p);
}

@source(PICC_ART7_3_4_EN, PICC_ART7_3_4_RU)
rule WithholdingPendingAssurance(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.4. A party who reasonably believes that there will be a fundamental non-performance may demand adequate assurance of due performance and may meanwhile withhold its own performance";
    label ru unofficial "Статья 7.3.4. Сторона, разумно полагающая, что будет допущено существенное неисполнение, может потребовать надлежащих заверений и тем временем приостановить своё исполнение";
    when reasonable_belief_of_fundamental_non_performance(c, p)
        and assurance_demanded(c, p);
    then may_withhold_pending_assurance(c, p);
}

@source(PICC_ART7_3_4_EN, PICC_ART7_3_4_RU)
rule TerminationForMissingAssurance(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.4. Where the assurance is not provided within a reasonable time the party demanding it may terminate the contract";
    label ru unofficial "Статья 7.3.4. Если заверения не предоставлены в разумный срок, потребовавшая их сторона может прекратить договор";
    when assurance_demanded(c, p)
        and not_known(assurance_provided_within_reasonable_time(c));
    then may_terminate_contract(c, p);
}

// --- Статьи 7.3.5-7.3.7: последствия прекращения и реституция ----------------------

pub relation dispute_settlement_provision(c: Contract, t: Term) kind empirical {
    label en official "the contract contains a provision for the settlement of disputes or another term which is to operate even after termination";
    label ru unofficial "договор содержит положение о разрешении споров или иное условие, действующее и после прекращения";
}

pub relation supplied_under_contract(c: Contract, p: Party) kind empirical {
    label en official "the party has supplied something under the contract";
    label ru unofficial "сторона предоставила что-либо по договору";
}

pub relation makes_concurrent_restitution(c: Contract, p: Party) kind empirical {
    label en official "the party concurrently makes restitution of whatever it has received under the contract";
    label ru unofficial "сторона одновременно возвращает всё полученное по договору";
}

pub relation contract_to_be_performed_at_one_time(c: Contract) kind empirical {
    label en official "the contract is one to be performed at one time";
    label ru unofficial "договор подлежит единовременному исполнению";
}

pub relation long_term_and_divisible(c: Contract) kind empirical {
    label en official "the contract is a long-term contract and is divisible";
    label ru unofficial "договор является долгосрочным и делимым";
}

pub relation released_from_future_performance(c: Contract) kind institutional {
    label en official "termination releases both parties from their obligation to effect and to receive future performance (article 7.3.5(1))";
    label ru unofficial "прекращение освобождает обе стороны от обязанности осуществлять и принимать будущее исполнение (статья 7.3.5 пункт 1)";
}

pub relation damages_claim_preserved(c: Contract) kind institutional {
    label en official "termination does not preclude a claim for damages for non-performance (article 7.3.5(2))";
    label ru unofficial "прекращение не препятствует требованию убытков за неисполнение (статья 7.3.5 пункт 2)";
}

pub relation surviving_term(c: Contract, t: Term) kind institutional {
    label en official "termination does not affect any provision for the settlement of disputes or other term which is to operate even after termination (article 7.3.5(3))";
    label ru unofficial "прекращение не затрагивает положения о разрешении споров и иные условия, действующие и после прекращения (статья 7.3.5 пункт 3)";
}

pub relation may_claim_restitution(c: Contract, p: Party) kind institutional {
    label en official "the party may claim restitution of whatever it has supplied under the contract (articles 7.3.6, 7.3.7)";
    label ru unofficial "сторона может требовать возврата предоставленного по договору (статьи 7.3.6, 7.3.7)";
}

pub relation restitution_only_after_termination(c: Contract, p: Party) kind institutional {
    label en official "on termination of a long-term contract restitution can only be claimed for the period after termination has taken effect, provided the contract is divisible (article 7.3.7(1))";
    label ru unofficial "при прекращении долгосрочного договора реституция может быть потребована лишь за период после вступления прекращения в силу, если договор делим (статья 7.3.7 пункт 1)";
}

@source(PICC_ART7_3_5_EN, PICC_ART7_3_5_RU)
rule TerminationReleasesFuturePerformance(c: Contract) defeasible {
    label en official "Article 7.3.5(1). Termination of the contract releases both parties from their obligation to effect and to receive future performance";
    label ru unofficial "Статья 7.3.5 пункт 1. Прекращение договора освобождает обе стороны от обязанности осуществлять и принимать будущее исполнение";
    when contract_terminated(c);
    then released_from_future_performance(c);
}

@source(PICC_ART7_3_5_EN, PICC_ART7_3_5_RU)
rule TerminationPreservesDamages(c: Contract) defeasible {
    label en official "Article 7.3.5(2). Termination does not preclude a claim for damages for non-performance";
    label ru unofficial "Статья 7.3.5 пункт 2. Прекращение не препятствует требованию убытков за неисполнение";
    when contract_terminated(c);
    then damages_claim_preserved(c);
}

@source(PICC_ART7_3_5_EN, PICC_ART7_3_5_RU)
rule DisputeClausesSurviveTermination(c: Contract, t: Term) defeasible {
    label en official "Article 7.3.5(3). Termination does not affect any provision in the contract for the settlement of disputes or any other term which is to operate even after termination";
    label ru unofficial "Статья 7.3.5 пункт 3. Прекращение не затрагивает положения договора о разрешении споров и иные условия, действующие и после прекращения";
    when contract_terminated(c)
        and dispute_settlement_provision(c, t);
    then surviving_term(c, t);
}

@source(PICC_ART7_3_6_EN, PICC_ART7_3_6_RU)
rule RestitutionOnTerminationAtOneTime(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.6(1). On termination of a contract to be performed at one time either party may claim restitution of whatever it has supplied, provided that it concurrently makes restitution of whatever it has received";
    label ru unofficial "Статья 7.3.6 пункт 1. При прекращении договора, подлежащего единовременному исполнению, каждая сторона может требовать возврата предоставленного при условии одновременного возврата полученного";
    when contract_terminated(c)
        and contract_to_be_performed_at_one_time(c)
        and supplied_under_contract(c, p)
        and makes_concurrent_restitution(c, p);
    then may_claim_restitution(c, p);
}

@source(PICC_ART7_3_7_EN, PICC_ART7_3_7_RU)
rule RestitutionOnLongTermContract(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.7(1). On termination of a long-term contract restitution can only be claimed for the period after termination has taken effect, provided the contract is divisible";
    label ru unofficial "Статья 7.3.7 пункт 1. При прекращении долгосрочного договора реституция может быть потребована лишь за период после вступления прекращения в силу, если договор делим";
    when contract_terminated(c)
        and long_term_and_divisible(c)
        and supplied_under_contract(c, p);
    then restitution_only_after_termination(c, p);
}

// --- Статья 7.3.6 пункты 2-4 и статья 7.3.7 пункт 2: денежное возмещение --------------

pub relation restitution_in_kind_impossible(c: Contract, p: Party) kind empirical {
    label en official "restitution in kind is not possible or appropriate";
    label ru unofficial "реституция в натуре невозможна или неуместна";
}

pub external judgment relation allowance_in_money_reasonable(c: Contract, p: Party) {
    authority Tribunal;
    label en official "an allowance in money is reasonable in the circumstances";
    label ru unofficial "денежное возмещение разумно при данных обстоятельствах";
}

pub relation impossibility_attributable_to_other_party(c: Contract, p: Party) kind empirical {
    label en official "the impossibility to make restitution in kind is attributable to the other party";
    label ru unofficial "невозможность реституции в натуре вызвана другой стороной";
}

pub relation expenses_reasonably_required(c: Contract, p: Party) kind empirical {
    label en official "expenses were reasonably required to preserve or maintain the performance received";
    label ru unofficial "расходы были разумно необходимы для сохранения или поддержания полученного исполнения";
}

pub relation allowance_in_money_due(c: Contract, p: Party) kind institutional {
    label en official "an allowance in money has to be made (article 7.3.6(2))";
    label ru unofficial "должно быть сделано денежное возмещение (статья 7.3.6 пункт 2)";
}

pub relation expenses_compensable(c: Contract, p: Party) kind institutional {
    label en official "compensation may be claimed for expenses reasonably required to preserve or maintain the performance received (article 7.3.6(4))";
    label ru unofficial "может быть потребовано возмещение расходов, разумно необходимых для сохранения или поддержания полученного исполнения (статья 7.3.6 пункт 4)";
}

@source(PICC_ART7_3_6_EN, PICC_ART7_3_6_RU)
rule AllowanceInMoneyOnTermination(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.6(2). If restitution in kind is not possible or appropriate, an allowance has to be made in money whenever reasonable";
    label ru unofficial "Статья 7.3.6 пункт 2. Если реституция в натуре невозможна или неуместна, должно быть сделано денежное возмещение, когда это разумно";
    when contract_terminated(c)
        and restitution_in_kind_impossible(c, p)
        and allowance_in_money_reasonable(c, p);
    then allowance_in_money_due(c, p);
    // Пункт 3: получатель исполнения возмещения не делает, если невозможность
    // вызвана другой стороной.
    unless restitution_in_kind_impossible(c, p)
        and impossibility_attributable_to_other_party(c, p);
}

@source(PICC_ART7_3_6_EN, PICC_ART7_3_6_RU)
rule PreservationExpensesOnTermination(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.6(4). Compensation may be claimed for expenses reasonably required to preserve or maintain the performance received";
    label ru unofficial "Статья 7.3.6 пункт 4. Может быть потребовано возмещение расходов, разумно необходимых для сохранения или поддержания полученного исполнения";
    when contract_terminated(c)
        and expenses_reasonably_required(c, p);
    then expenses_compensable(c, p);
}

@source(PICC_ART7_3_7_EN, PICC_ART7_3_7_RU)
rule LongTermRestitutionFollowsArticle736(c: Contract, p: Party) defeasible {
    label en official "Article 7.3.7(2). As far as restitution has to be made on termination of a long-term contract, the provisions of Article 7.3.6 apply";
    label ru unofficial "Статья 7.3.7 пункт 2. Насколько реституция подлежит осуществлению при прекращении долгосрочного договора, применяются положения статьи 7.3.6";
    when restitution_only_after_termination(c, p)
        and supplied_under_contract(c, p)
        and makes_concurrent_restitution(c, p);
    then may_claim_restitution(c, p);
}
