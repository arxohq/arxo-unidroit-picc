// Статьи 7.4.1-7.4.13. Убытки.
//
// СТАВКА ПРОЦЕНТОВ НАЗВАНА ИСТОЧНИКОМ (ст. 7.4.9 п. 2), И ЭТО ПРЯМОЙ ОТВЕТ
// НА МОЛЧАНИЕ СТАТЬИ 78 КОНВЕНЦИИ: средняя банковская ставка краткосрочного
// кредитования первоклассных заёмщиков для валюты платежа в месте платежа.
// Само ЧИСЛО ставки остаётся фактом дела — Принципы называют ПРАВИЛО ВЫБОРА,
// а не величину; поэтому голова говорит, какая ставка применяется, и не
// подставляет догадку.

language "law.core" version "0.2";
package unidroit.picc_non_performance version "0.1.0";
namespace "urn:org:unidroit:clir:picc-non-performance";

pub relation harm_sustained(n: NonPerformance, p: Party) kind empirical {
    label en official "the aggrieved party sustained harm as a result of the non-performance";
    label ru unofficial "потерпевшая сторона понесла вред в результате неисполнения";
}

pub relation harm_established_with_certainty(n: NonPerformance) kind empirical {
    label en official "the harm, including future harm, is established with a reasonable degree of certainty";
    label ru unofficial "вред, включая будущий, установлен с разумной степенью определённости";
}

pub relation loss_of_a_chance(n: NonPerformance) kind empirical {
    label en official "the harm consists in the loss of a chance";
    label ru unofficial "вред состоит в утрате возможности";
}

pub relation amount_not_establishable(n: NonPerformance) kind empirical {
    label en official "the amount of damages cannot be established with a sufficient degree of certainty";
    label ru unofficial "размер убытков не может быть установлен с достаточной степенью определённости";
}

pub external judgment relation harm_was_foreseeable(n: NonPerformance) {
    authority Tribunal;
    label en official "the non-performing party foresaw or could reasonably have foreseen the harm at the time of the conclusion of the contract as being likely to result from its non-performance";
    label ru unofficial "неисполнившая сторона предвидела или могла разумно предвидеть при заключении договора, что такой вред вероятно последует из её неисполнения";
}

pub relation replacement_transaction_made(n: NonPerformance) kind empirical {
    label en official "the aggrieved party terminated the contract and made a replacement transaction within a reasonable time and in a reasonable manner";
    label ru unofficial "потерпевшая сторона прекратила договор и совершила заменяющую сделку в разумный срок и разумным способом";
}

pub relation current_price_exists(n: NonPerformance) kind empirical {
    label en official "there is a current price for the performance contracted for";
    label ru unofficial "для предусмотренного договором исполнения существует текущая цена";
}

pub relation harm_due_in_part_to_aggrieved_party(n: NonPerformance) kind empirical {
    label en official "the harm is due in part to an act or omission of the aggrieved party or to another event for which that party bears the risk";
    label ru unofficial "вред отчасти вызван действием или бездействием потерпевшей стороны либо иным событием, риск которого она несёт";
}

pub relation harm_could_have_been_reduced(n: NonPerformance) kind empirical {
    label en official "the harm could have been reduced by the aggrieved party's taking reasonable steps";
    label ru unofficial "вред мог быть уменьшен разумными мерами потерпевшей стороны";
}

pub relation mitigation_expenses_incurred(n: NonPerformance) kind empirical {
    label en official "the aggrieved party reasonably incurred expenses in attempting to reduce the harm";
    label ru unofficial "потерпевшая сторона разумно понесла расходы, пытаясь уменьшить вред";
}

pub relation sum_not_paid_when_due(o: Obligation) kind empirical {
    label en official "a party does not pay a sum of money when it falls due";
    label ru unofficial "сторона не уплачивает денежную сумму при наступлении срока платежа";
}

pub relation bank_rate_exists_at_place_of_payment(o: Obligation) kind empirical {
    label en official "an average bank short-term lending rate to prime borrowers exists for the currency of payment at the place for payment";
    label ru unofficial "в месте платежа существует средняя банковская ставка краткосрочного кредитования первоклассных заёмщиков для валюты платежа";
}

pub relation bank_rate_exists_in_state_of_currency(o: Obligation) kind empirical {
    label en official "such a rate exists in the State of the currency of payment";
    label ru unofficial "такая ставка существует в государстве валюты платежа";
}

pub relation greater_harm_from_non_payment(o: Obligation) kind empirical {
    label en official "the non-payment caused the aggrieved party a greater harm";
    label ru unofficial "неплатёж причинил потерпевшей стороне больший вред";
}

pub relation non_monetary_non_performance(n: NonPerformance) kind empirical {
    label en official "the non-performance concerns a non-monetary obligation";
    label ru unofficial "неисполнение касается неденежного обязательства";
}

pub relation nature_of_harm_suits_instalments(n: NonPerformance) kind empirical {
    label en official "the nature of the harm makes payment of damages in instalments appropriate";
    label ru unofficial "природа вреда делает уместной уплату убытков по частям";
}

pub relation agreed_sum_for_non_performance(c: Contract, t: Term) kind empirical {
    label en official "the contract provides that a party who does not perform is to pay a specified sum to the aggrieved party for such non-performance";
    label ru unofficial "договор предусматривает, что неисполнившая сторона уплачивает потерпевшей определённую сумму за такое неисполнение";
}

pub external judgment relation agreed_sum_grossly_excessive(c: Contract, t: Term) {
    authority Tribunal;
    label en official "the specified sum is grossly excessive in relation to the harm resulting from the non-performance and to the other circumstances";
    label ru unofficial "предусмотренная сумма явно чрезмерна по отношению к вреду от неисполнения и к иным обстоятельствам";
}

pub relation right_to_damages(n: NonPerformance, p: Party) kind institutional {
    label en official "the non-performance gives the aggrieved party a right to damages (article 7.4.1)";
    label ru unofficial "неисполнение даёт потерпевшей стороне право на убытки (статья 7.4.1)";
}

pub relation full_compensation_due(n: NonPerformance, p: Party) kind institutional {
    label en official "the aggrieved party is entitled to full compensation for the harm sustained, including non-pecuniary harm (article 7.4.2)";
    label ru unofficial "потерпевшая сторона имеет право на полную компенсацию понесённого вреда, включая неимущественный (статья 7.4.2)";
}

pub relation compensation_for_loss_of_chance(n: NonPerformance, p: Party) kind institutional {
    label en official "compensation may be due for the loss of a chance in proportion to the probability of its occurrence (article 7.4.3(2))";
    label ru unofficial "компенсация может причитаться за утрату возможности соразмерно вероятности её наступления (статья 7.4.3 пункт 2)";
}

pub relation assessment_at_discretion_of_court(n: NonPerformance) kind institutional {
    label en official "where the amount of damages cannot be established with sufficient certainty, the assessment is at the discretion of the court (article 7.4.3(3))";
    label ru unofficial "если размер убытков не может быть установлен с достаточной определённостью, его оценка относится к усмотрению суда (статья 7.4.3 пункт 3)";
}

pub relation difference_to_replacement_recoverable(n: NonPerformance, p: Party) kind institutional {
    label en official "the aggrieved party may recover the difference between the contract price and the price of the replacement transaction as well as damages for any further harm (article 7.4.5)";
    label ru unofficial "потерпевшая сторона может взыскать разницу между договорной ценой и ценой заменяющей сделки, а также убытки за любой дальнейший вред (статья 7.4.5)";
}

pub relation difference_to_current_price_recoverable(n: NonPerformance, p: Party) kind institutional {
    label en official "the aggrieved party may recover the difference between the contract price and the price current at the time of termination as well as damages for any further harm (article 7.4.6)";
    label ru unofficial "потерпевшая сторона может взыскать разницу между договорной ценой и текущей ценой на момент прекращения договора, а также убытки за любой дальнейший вред (статья 7.4.6)";
}

pub relation damages_reduced_for_contribution(n: NonPerformance, p: Party) kind institutional {
    label en official "the amount of damages is reduced to the extent that the aggrieved party's act, omission or risk contributed to the harm (article 7.4.7)";
    label ru unofficial "размер убытков уменьшается в той мере, в какой действие, бездействие или риск потерпевшей стороны способствовали вреду (статья 7.4.7)";
}

pub relation not_liable_for_avoidable_harm(n: NonPerformance, p: Party) kind institutional {
    label en official "the non-performing party is not liable for harm to the extent that it could have been reduced by reasonable steps of the aggrieved party (article 7.4.8(1))";
    label ru unofficial "неисполнившая сторона не отвечает за вред в той мере, в какой он мог быть уменьшен разумными мерами потерпевшей стороны (статья 7.4.8 пункт 1)";
}

pub relation mitigation_expenses_recoverable(n: NonPerformance, p: Party) kind institutional {
    label en official "the aggrieved party is entitled to recover expenses reasonably incurred in attempting to reduce the harm (article 7.4.8(2))";
    label ru unofficial "потерпевшая сторона может взыскать расходы, разумно понесённые в попытке уменьшить вред (статья 7.4.8 пункт 2)";
}

pub relation entitled_to_interest(o: Obligation, p: Party) kind institutional {
    label en official "the aggrieved party is entitled to interest upon the sum from the time when payment is due to the time of payment, whether or not the non-payment is excused (article 7.4.9(1))";
    label ru unofficial "потерпевшая сторона имеет право на проценты на эту сумму с момента наступления срока платежа до момента платежа независимо от того, освобождается ли неплатёж (статья 7.4.9 пункт 1)";
}

pub relation rate_is_bank_rate_at_place_of_payment(o: Obligation) kind institutional {
    label en official "the rate of interest is the average bank short-term lending rate to prime borrowers prevailing for the currency of payment at the place for payment (article 7.4.9(2))";
    label ru unofficial "ставкой процентов является средняя банковская ставка краткосрочного кредитования первоклассных заёмщиков для валюты платежа в месте платежа (статья 7.4.9 пункт 2)";
}

pub relation rate_is_bank_rate_in_state_of_currency(o: Obligation) kind institutional {
    label en official "where no such rate exists at the place for payment, the rate is the same rate in the State of the currency of payment (article 7.4.9(2))";
    label ru unofficial "если в месте платежа такой ставки нет, применяется та же ставка в государстве валюты платежа (статья 7.4.9 пункт 2)";
}

pub relation rate_is_fixed_by_law_of_currency_state(o: Obligation) kind institutional {
    label en official "in the absence of such a rate at either place, the rate is the appropriate rate fixed by the law of the State of the currency of payment (article 7.4.9(2))";
    label ru unofficial "при отсутствии такой ставки в обоих местах применяется надлежащая ставка, установленная правом государства валюты платежа (статья 7.4.9 пункт 2)";
}

pub relation additional_damages_for_non_payment(o: Obligation, p: Party) kind institutional {
    label en official "the aggrieved party is entitled to additional damages if the non-payment caused it a greater harm (article 7.4.9(3))";
    label ru unofficial "потерпевшая сторона имеет право на дополнительные убытки, если неплатёж причинил ей больший вред (статья 7.4.9 пункт 3)";
}

pub relation interest_accrues_from_non_performance(n: NonPerformance) kind institutional {
    label en official "interest on damages for non-performance of non-monetary obligations accrues as from the time of non-performance (article 7.4.10)";
    label ru unofficial "проценты на убытки за неисполнение неденежных обязательств начисляются с момента неисполнения (статья 7.4.10)";
}

pub relation damages_paid_in_lump_sum(n: NonPerformance) kind institutional {
    label en official "damages are to be paid in a lump sum (article 7.4.11(1))";
    label ru unofficial "убытки уплачиваются единовременной суммой (статья 7.4.11 пункт 1)";
}

pub relation damages_payable_in_instalments(n: NonPerformance) kind institutional {
    label en official "damages may be payable in instalments where the nature of the harm makes this appropriate, and may be indexed (article 7.4.11)";
    label ru unofficial "убытки могут уплачиваться по частям, если природа вреда делает это уместным, и могут индексироваться (статья 7.4.11)";
}

pub relation agreed_sum_payable(c: Contract, t: Term) kind institutional {
    label en official "the aggrieved party is entitled to the specified sum irrespective of its actual harm (article 7.4.13(1))";
    label ru unofficial "потерпевшая сторона имеет право на предусмотренную сумму независимо от действительного вреда (статья 7.4.13 пункт 1)";
}

pub relation agreed_sum_reduced_to_reasonable_amount(c: Contract, t: Term) kind institutional {
    label en official "the specified sum may be reduced to a reasonable amount where it is grossly excessive (article 7.4.13(2))";
    label ru unofficial "предусмотренная сумма может быть уменьшена до разумного размера, если она явно чрезмерна (статья 7.4.13 пункт 2)";
}

@source(PICC_ART7_4_1_EN, PICC_ART7_4_1_RU)
rule RightToDamages(n: NonPerformance, o: Obligation, p: Party, other: Party) defeasible {
    label en official "Article 7.4.1. Any non-performance gives the aggrieved party a right to damages, except where the non-performance is excused under these Principles";
    label ru unofficial "Статья 7.4.1. Любое неисполнение даёт потерпевшей стороне право на убытки, кроме случаев, когда неисполнение освобождается по настоящим Принципам";
    when is_non_performance(n)
        and non_performance_of(n, o, p)
        and aggrieved_party(n, other)
        and not_known(non_performance_excused(n, p));
    then right_to_damages(n, other);
}

@source(PICC_ART7_4_2_EN, PICC_ART7_4_2_RU)
rule FullCompensation(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.2. The aggrieved party is entitled to full compensation for harm sustained, which may be non-pecuniary";
    label ru unofficial "Статья 7.4.2. Потерпевшая сторона имеет право на полную компенсацию понесённого вреда, который может быть и неимущественным";
    when right_to_damages(n, p)
        and harm_sustained(n, p)
        and harm_established_with_certainty(n)
        and harm_was_foreseeable(n);
    then full_compensation_due(n, p);
}

@source(PICC_ART7_4_3_EN, PICC_ART7_4_3_RU)
rule CompensationForLossOfChance(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.3(2). Compensation may be due for the loss of a chance in proportion to the probability of its occurrence";
    label ru unofficial "Статья 7.4.3 пункт 2. Компенсация может причитаться за утрату возможности соразмерно вероятности её наступления";
    when right_to_damages(n, p)
        and loss_of_a_chance(n);
    then compensation_for_loss_of_chance(n, p);
}

@source(PICC_ART7_4_3_EN, PICC_ART7_4_3_RU)
rule AssessmentAtCourtDiscretion(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.3(3). Where the amount of damages cannot be established with a sufficient degree of certainty, the assessment is at the discretion of the court";
    label ru unofficial "Статья 7.4.3 пункт 3. Если размер убытков не может быть установлен с достаточной определённостью, его оценка относится к усмотрению суда";
    when right_to_damages(n, p)
        and amount_not_establishable(n);
    then assessment_at_discretion_of_court(n);
}

@source(PICC_ART7_4_5_EN, PICC_ART7_4_5_RU)
rule ReplacementTransactionProof(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.5. Where the aggrieved party has terminated the contract and made a replacement transaction within a reasonable time and in a reasonable manner, it may recover the difference in price as well as damages for any further harm";
    label ru unofficial "Статья 7.4.5. Если потерпевшая сторона прекратила договор и совершила заменяющую сделку в разумный срок и разумным способом, она может взыскать разницу в цене, а также убытки за дальнейший вред";
    when right_to_damages(n, p)
        and replacement_transaction_made(n);
    then difference_to_replacement_recoverable(n, p);
}

@source(PICC_ART7_4_6_EN, PICC_ART7_4_6_RU)
rule CurrentPriceProof(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.6(1). Where the aggrieved party has terminated the contract without a replacement transaction but there is a current price, it may recover the difference between the contract price and the current price";
    label ru unofficial "Статья 7.4.6 пункт 1. Если потерпевшая сторона прекратила договор без заменяющей сделки, но есть текущая цена, она может взыскать разницу между договорной и текущей ценой";
    when right_to_damages(n, p)
        and current_price_exists(n)
        and not_known(replacement_transaction_made(n));
    then difference_to_current_price_recoverable(n, p);
}

@source(PICC_ART7_4_7_EN, PICC_ART7_4_7_RU)
rule ContributionReducesDamages(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.7. Where the harm is due in part to an act or omission of the aggrieved party or to an event for which it bears the risk, the damages are reduced accordingly";
    label ru unofficial "Статья 7.4.7. Если вред отчасти вызван действием или бездействием потерпевшей стороны либо событием, риск которого она несёт, размер убытков соответственно уменьшается";
    when right_to_damages(n, p)
        and harm_due_in_part_to_aggrieved_party(n);
    then damages_reduced_for_contribution(n, p);
}

@source(PICC_ART7_4_8_EN, PICC_ART7_4_8_RU)
rule MitigationLimitsLiability(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.8(1). The non-performing party is not liable for harm to the extent that it could have been reduced by the aggrieved party's taking reasonable steps";
    label ru unofficial "Статья 7.4.8 пункт 1. Неисполнившая сторона не отвечает за вред в той мере, в какой он мог быть уменьшен разумными мерами потерпевшей стороны";
    when right_to_damages(n, p)
        and harm_could_have_been_reduced(n);
    then not_liable_for_avoidable_harm(n, p);
}

@source(PICC_ART7_4_8_EN, PICC_ART7_4_8_RU)
rule MitigationExpensesRecoverable(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.8(2). The aggrieved party is entitled to recover any expenses reasonably incurred in attempting to reduce the harm";
    label ru unofficial "Статья 7.4.8 пункт 2. Потерпевшая сторона может взыскать расходы, разумно понесённые в попытке уменьшить вред";
    when right_to_damages(n, p)
        and mitigation_expenses_incurred(n);
    then mitigation_expenses_recoverable(n, p);
}

@source(PICC_ART7_4_9_EN, PICC_ART7_4_9_RU)
rule InterestForFailureToPay(o: Obligation, c: Contract, p: Party, other: Party) strict {
    label en official "Article 7.4.9(1). If a party does not pay a sum of money when it falls due the aggrieved party is entitled to interest from the time when payment is due to the time of payment, whether or not the non-payment is excused";
    label ru unofficial "Статья 7.4.9 пункт 1. Если сторона не уплачивает денежную сумму при наступлении срока, потерпевшая сторона имеет право на проценты с момента наступления срока до момента платежа независимо от освобождения от ответственности";
    when obligation_of(o, c, p)
        and obligee_of(o, other)
        and sum_not_paid_when_due(o);
    then entitled_to_interest(o, other);
}

@source(PICC_ART7_4_9_EN, PICC_ART7_4_9_RU)
rule RateAtPlaceOfPayment(o: Obligation) defeasible {
    label en official "Article 7.4.9(2). The rate of interest shall be the average bank short-term lending rate to prime borrowers prevailing for the currency of payment at the place for payment";
    label ru unofficial "Статья 7.4.9 пункт 2. Ставкой процентов является средняя банковская ставка краткосрочного кредитования первоклассных заёмщиков для валюты платежа в месте платежа";
    when sum_not_paid_when_due(o)
        and bank_rate_exists_at_place_of_payment(o);
    then rate_is_bank_rate_at_place_of_payment(o);
}

@source(PICC_ART7_4_9_EN, PICC_ART7_4_9_RU)
rule RateInStateOfCurrency(o: Obligation) defeasible {
    label en official "Article 7.4.9(2). Where no such rate exists at the place for payment, the rate is the same rate in the State of the currency of payment";
    label ru unofficial "Статья 7.4.9 пункт 2. Если в месте платежа такой ставки нет, применяется та же ставка в государстве валюты платежа";
    when sum_not_paid_when_due(o)
        and bank_rate_exists_in_state_of_currency(o)
        and not_known(bank_rate_exists_at_place_of_payment(o));
    then rate_is_bank_rate_in_state_of_currency(o);
}

@source(PICC_ART7_4_9_EN, PICC_ART7_4_9_RU)
rule RateFixedByLawOfCurrencyState(o: Obligation) defeasible {
    label en official "Article 7.4.9(2). In the absence of such a rate at either place the rate of interest shall be the appropriate rate fixed by the law of the State of the currency of payment";
    label ru unofficial "Статья 7.4.9 пункт 2. При отсутствии такой ставки в обоих местах применяется надлежащая ставка, установленная правом государства валюты платежа";
    when sum_not_paid_when_due(o)
        and not_known(bank_rate_exists_at_place_of_payment(o))
        and not_known(bank_rate_exists_in_state_of_currency(o));
    then rate_is_fixed_by_law_of_currency_state(o);
}

@source(PICC_ART7_4_9_EN, PICC_ART7_4_9_RU)
rule AdditionalDamagesForNonPayment(o: Obligation, c: Contract, p: Party, other: Party) strict {
    label en official "Article 7.4.9(3). The aggrieved party is entitled to additional damages if the non-payment caused it a greater harm";
    label ru unofficial "Статья 7.4.9 пункт 3. Потерпевшая сторона имеет право на дополнительные убытки, если неплатёж причинил ей больший вред";
    when obligation_of(o, c, p)
        and obligee_of(o, other)
        and greater_harm_from_non_payment(o);
    then additional_damages_for_non_payment(o, other);
}

@source(PICC_ART7_4_10_EN, PICC_ART7_4_10_RU)
rule InterestOnDamagesAccrues(n: NonPerformance, o: Obligation, p: Party) defeasible {
    label en official "Article 7.4.10. Unless otherwise agreed, interest on damages for non-performance of non-monetary obligations accrues as from the time of non-performance";
    label ru unofficial "Статья 7.4.10. Если не согласовано иное, проценты на убытки за неисполнение неденежных обязательств начисляются с момента неисполнения";
    when non_performance_of(n, o, p)
        and non_monetary_non_performance(n);
    then interest_accrues_from_non_performance(n);
}

@source(PICC_ART7_4_11_EN, PICC_ART7_4_11_RU)
rule DamagesInLumpSum(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.11(1). Damages are to be paid in a lump sum";
    label ru unofficial "Статья 7.4.11 пункт 1. Убытки уплачиваются единовременной суммой";
    when full_compensation_due(n, p)
        and not_known(nature_of_harm_suits_instalments(n));
    then damages_paid_in_lump_sum(n);
}

@source(PICC_ART7_4_11_EN, PICC_ART7_4_11_RU)
rule DamagesInInstalments(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.11. Damages may be payable in instalments where the nature of the harm makes this appropriate, and such damages may be indexed";
    label ru unofficial "Статья 7.4.11. Убытки могут уплачиваться по частям, если природа вреда делает это уместным, и такие убытки могут индексироваться";
    when full_compensation_due(n, p)
        and nature_of_harm_suits_instalments(n);
    then damages_payable_in_instalments(n);
}

@source(PICC_ART7_4_13_EN, PICC_ART7_4_13_RU)
rule AgreedSumPayable(c: Contract, t: Term) defeasible {
    label en official "Article 7.4.13(1). Where the contract provides for a specified sum for non-performance, the aggrieved party is entitled to that sum irrespective of its actual harm";
    label ru unofficial "Статья 7.4.13 пункт 1. Если договор предусматривает определённую сумму за неисполнение, потерпевшая сторона имеет право на неё независимо от действительного вреда";
    when agreed_sum_for_non_performance(c, t);
    then agreed_sum_payable(c, t);
}

@source(PICC_ART7_4_13_EN, PICC_ART7_4_13_RU)
rule GrosslyExcessiveAgreedSumReduced(c: Contract, t: Term) defeasible {
    label en official "Article 7.4.13(2). Notwithstanding any agreement to the contrary the specified sum may be reduced to a reasonable amount where it is grossly excessive";
    label ru unofficial "Статья 7.4.13 пункт 2. Несмотря на любое соглашение об ином, предусмотренная сумма может быть уменьшена до разумного размера, если она явно чрезмерна";
    when agreed_sum_for_non_performance(c, t)
        and agreed_sum_grossly_excessive(c, t);
    then agreed_sum_reduced_to_reasonable_amount(c, t);
}

// --- Статьи 7.4.4, 7.4.6 пункт 2 и 7.4.12: предвидимость, текущая цена, валюта ------

pub relation harm_within_foreseeable_scope(n: NonPerformance, p: Party) kind institutional {
    label en official "the non-performing party is liable only for harm which it foresaw or could reasonably have foreseen at the time of the conclusion of the contract (article 7.4.4)";
    label ru unofficial "неисполнившая сторона отвечает только за вред, который предвидела или могла разумно предвидеть при заключении договора (статья 7.4.4)";
}

@source(PICC_ART7_4_4_EN, PICC_ART7_4_4_RU)
rule LiabilityLimitedToForeseeableHarm(n: NonPerformance, o: Obligation, p: Party, other: Party) defeasible {
    label en official "Article 7.4.4. The non-performing party is liable only for harm which it foresaw or could reasonably have foreseen at the time of the conclusion of the contract as being likely to result from its non-performance";
    label ru unofficial "Статья 7.4.4. Неисполнившая сторона отвечает только за вред, который она предвидела или могла разумно предвидеть при заключении договора как вероятное следствие своего неисполнения";
    when non_performance_of(n, o, p)
        and aggrieved_party(n, other)
        and harm_sustained(n, other)
        and harm_was_foreseeable(n);
    then harm_within_foreseeable_scope(n, p);
}

pub relation price_at_place_of_performance(n: NonPerformance) kind empirical {
    label en official "a price is generally charged for goods delivered or services rendered in comparable circumstances at the place where the contract should have been performed";
    label ru unofficial "цена обычно взимается за товары или услуги в сопоставимых обстоятельствах в месте, где договор подлежал исполнению";
}

pub external judgment relation reference_place_reasonable(n: NonPerformance) {
    authority Tribunal;
    label en official "the other place taken as a reference for the current price appears reasonable";
    label ru unofficial "иное место, взятое за ориентир текущей цены, представляется разумным";
}

pub relation current_price_is(n: NonPerformance) kind institutional {
    label en official "the current price is the price generally charged at the place of performance or, failing that, at another place reasonable to take as a reference (article 7.4.6(2))";
    label ru unofficial "текущей ценой является цена, обычно взимаемая в месте исполнения, а при её отсутствии — в ином месте, разумном для ориентира (статья 7.4.6 пункт 2)";
}

@source(PICC_ART7_4_6_EN, PICC_ART7_4_6_RU)
rule CurrentPriceAtPlaceOfPerformance(n: NonPerformance) defeasible {
    label en official "Article 7.4.6(2). Current price is the price generally charged for goods delivered or services rendered in comparable circumstances at the place where the contract should have been performed";
    label ru unofficial "Статья 7.4.6 пункт 2. Текущей ценой является цена, обычно взимаемая за товары или услуги в сопоставимых обстоятельствах в месте, где договор подлежал исполнению";
    when current_price_exists(n)
        and price_at_place_of_performance(n);
    then current_price_is(n);
}

@source(PICC_ART7_4_6_EN, PICC_ART7_4_6_RU)
rule CurrentPriceAtReferencePlace(n: NonPerformance) defeasible {
    label en official "Article 7.4.6(2). If there is no current price at the place of performance, the current price at such other place as appears reasonable to take as a reference applies";
    label ru unofficial "Статья 7.4.6 пункт 2. Если в месте исполнения текущей цены нет, применяется текущая цена иного места, разумного для ориентира";
    when current_price_exists(n)
        and reference_place_reasonable(n)
        and not_known(price_at_place_of_performance(n));
    then current_price_is(n);
}

pub relation harm_suffered_in_other_currency(n: NonPerformance) kind empirical {
    label en official "the harm was suffered in a currency other than that in which the monetary obligation was expressed";
    label ru unofficial "вред понесён в валюте, отличной от валюты выражения денежного обязательства";
}

pub external judgment relation currency_of_harm_more_appropriate(n: NonPerformance) {
    authority Tribunal;
    label en official "the currency in which the harm was suffered is the more appropriate one for assessing damages";
    label ru unofficial "валюта, в которой понесён вред, более уместна для исчисления убытков";
}

pub relation damages_assessed_in_currency_of_obligation(n: NonPerformance) kind institutional {
    label en official "damages are to be assessed in the currency in which the monetary obligation was expressed (article 7.4.12)";
    label ru unofficial "убытки исчисляются в валюте, в которой выражено денежное обязательство (статья 7.4.12)";
}

pub relation damages_assessed_in_currency_of_harm(n: NonPerformance) kind institutional {
    label en official "damages are to be assessed in the currency in which the harm was suffered (article 7.4.12)";
    label ru unofficial "убытки исчисляются в валюте, в которой понесён вред (статья 7.4.12)";
}

@source(PICC_ART7_4_12_EN, PICC_ART7_4_12_RU)
rule DamagesInCurrencyOfObligation(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.12. Damages are to be assessed in the currency in which the monetary obligation was expressed, whichever is more appropriate";
    label ru unofficial "Статья 7.4.12. Убытки исчисляются в валюте выражения денежного обязательства — смотря какая валюта более уместна";
    when full_compensation_due(n, p)
        and not_known(currency_of_harm_more_appropriate(n));
    then damages_assessed_in_currency_of_obligation(n);
}

@source(PICC_ART7_4_12_EN, PICC_ART7_4_12_RU)
rule DamagesInCurrencyOfHarm(n: NonPerformance, p: Party) defeasible {
    label en official "Article 7.4.12. Damages are to be assessed in the currency in which the harm was suffered where that is more appropriate";
    label ru unofficial "Статья 7.4.12. Убытки исчисляются в валюте, в которой понесён вред, если она более уместна";
    when full_compensation_due(n, p)
        and harm_suffered_in_other_currency(n)
        and currency_of_harm_more_appropriate(n);
    then damages_assessed_in_currency_of_harm(n);
}
