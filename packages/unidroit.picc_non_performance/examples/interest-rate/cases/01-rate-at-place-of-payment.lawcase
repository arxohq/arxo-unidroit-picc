language "law.core" version "0.2";
package examples.unidroit.interest_rate version "0.1.0";
namespace "urn:law:examples:unidroit:interest-rate";

// Case 1. An invoice is not paid, and the first step of article 7.4.9(2) works.
//
// THE SOURCE NAMES THE RATE, NOT THE NUMBER. Article 78 of the 1980 Convention
// gives the right to interest and says nothing about how much; article 7.4.9(2)
// gives a rule of choice in three steps — the bank rate at the place for
// payment, failing that the same rate in the State of the currency, failing that
// the rate fixed by the law of that State. The value itself stays a fact of the
// case: the model answers WHICH rate applies, and does not invent a percentage.
//
// The three steps are three rules that displace one another through `not_known`,
// not one rule with provisos. Here the first step applies, and the case asks the
// other two as well: they come back NEITHER, which is what "this step does not
// apply" looks like in a document.

case RateAtPlaceOfPayment {
    context {
        legal_time @2026-09-18;
        knowledge_time @2026-09-18T12:00:00Z;
        decision_time @2026-09-18T12:00:00Z;
        timezone "UTC";
    }

    const contract: unidroit.picc::Contract = entity_ref("urn:example:picc:interest:contract");
    const debt: unidroit.picc::Obligation = entity_ref("urn:example:picc:interest:invoice");
    const buyer: unidroit.picc::Party = entity_ref("urn:example:picc:interest:buyer");
    const seller: unidroit.picc::Party = entity_ref("urn:example:picc:interest:seller");

    assert "obligation": unidroit.picc_non_performance::obligation_of(debt, contract, buyer) { origin case_input; }
    assert "obligee": unidroit.picc_non_performance::obligee_of(debt, seller) { origin case_input; }

    // Article 7.4.9(1): the sum was not paid when it fell due.
    assert "unpaid": unidroit.picc_non_performance::sum_not_paid_when_due(debt) { origin case_input; }

    // Article 7.4.9(2), first step: such a rate exists at the place for payment.
    assert "rate-at-place": unidroit.picc_non_performance::bank_rate_exists_at_place_of_payment(debt) { origin case_input; }
}
