language "law.core" version "0.2";
package examples.unidroit.interest_rate version "0.1.0";
namespace "urn:law:examples:unidroit:interest-rate";

// Case 2. The same invoice, but no bank rate is available at either place.
//
// THE THIRD STEP IS NOT A DEFAULT, IT IS A RULE. Article 7.4.9(2) ends with the
// rate fixed by the law of the State of the currency of payment, and that rule
// fires only where the first two steps have nothing to work with. The case
// presents that absence the way the canon reads it: the facts about the two bank
// rates are simply not asserted, and the rules consume that silence through
// `not_known`.
//
// The right to interest itself (article 7.4.9(1)) does not depend on any of this
// and is established here as in case 1.

case NoRateAnywhere {
    context {
        legal_time @2026-09-18;
        knowledge_time @2026-09-18T12:00:00Z;
        decision_time @2026-09-18T12:00:00Z;
        timezone "UTC";
    }

    const contract: unidroit.picc::Contract = entity_ref("urn:example:picc:no-rate:contract");
    const debt: unidroit.picc::Obligation = entity_ref("urn:example:picc:no-rate:invoice");
    const buyer: unidroit.picc::Party = entity_ref("urn:example:picc:no-rate:buyer");
    const seller: unidroit.picc::Party = entity_ref("urn:example:picc:no-rate:seller");

    assert "obligation": unidroit.picc_non_performance::obligation_of(debt, contract, buyer) { origin case_input; }
    assert "obligee": unidroit.picc_non_performance::obligee_of(debt, seller) { origin case_input; }
    assert "unpaid": unidroit.picc_non_performance::sum_not_paid_when_due(debt) { origin case_input; }
}
