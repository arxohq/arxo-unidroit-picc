// Articles 9.2.1-9.2.8 and 9.3.1-9.3.7. Transfer of obligations and assignment of contracts.

language "law.core" version "0.2";
package unidroit.picc_obligations version "0.1.0";
namespace "urn:org:unidroit:clir:picc-obligations";

// --- Chapter 9, section 2: transfer of obligations ----------------------------

pub relation transfer_by_obligors_agreement(o: Obligation, original: Party, new_obligor: Party) kind empirical {
    label en official "the obligation is transferred by an agreement between the original obligor and the new obligor";
}

pub relation assumption_by_obligee_agreement(o: Obligation, obligee: Party, new_obligor: Party) kind empirical {
    label en official "the new obligor assumes the obligation by an agreement with the obligee";
}

pub relation business_transfer_rules_apply(o: Obligation) kind empirical {
    label en official "the transfer is made under the special rules governing transfers of obligations in the course of transferring a business";
}

pub relation obligee_consented_to_transfer(o: Obligation) kind empirical {
    label en official "the obligee has consented to the transfer";
}

pub relation obligee_consented_in_advance(o: Obligation) kind empirical {
    label en official "the obligee gave its consent in advance";
}

pub relation transfer_notice_given_or_acknowledged(o: Obligation) kind empirical {
    label en official "a notice of the transfer was given to the obligee or the obligee acknowledged it";
}

pub relation original_obligor_discharged_by_obligee(o: Obligation) kind empirical {
    label en official "the obligee discharged the original obligor";
}

pub relation original_obligor_retained(o: Obligation) kind empirical {
    label en official "the obligee retained the original obligor in case the new obligor does not perform properly";
}

pub relation third_party_performance_agreed(o: Obligation, other: Party) kind empirical {
    label en official "the obligor contracted with another person that this person will perform the obligation in its place";
}

pub relation obligation_personal_character(o: Obligation) kind empirical {
    label en official "the obligation in the circumstances has an essentially personal character";
}

pub relation defence_of_original_obligor(o: Obligation) kind empirical {
    label en official "the original obligor could assert a defence against the obligee";
}

pub relation set_off_of_original_obligor(o: Obligation) kind empirical {
    label en official "a right of set-off was available to the original obligor against the obligee";
}

pub relation security_by_third_person(o: Obligation) kind empirical {
    label en official "a security for the performance of the obligation was granted by a person other than the new obligor";
}

pub relation security_provider_agreed_to_continue(o: Obligation) kind empirical {
    label en official "that other person agreed that the security should continue to be available to the obligee";
}

pub relation transfer_effective(o: Obligation) kind institutional {
    label en official "the transfer of the obligation is effective (articles 9.2.1-9.2.4)";
}

pub relation obligors_jointly_and_severally_liable(o: Obligation) kind institutional {
    label en official "the original obligor and the new obligor are jointly and severally liable (article 9.2.5(3))";
}

pub relation obligee_retains_claim_against_obligor(o: Obligation) kind institutional {
    label en official "the obligee retains its claim against the obligor despite third party performance (article 9.2.6(2))";
}

pub relation third_party_may_perform(o: Obligation, other: Party) kind institutional {
    label en official "without the obligee's consent the obligor may contract with another person to perform in its place (article 9.2.6(1))";
}

pub relation new_obligor_may_assert_defence(o: Obligation) kind institutional {
    label en official "the new obligor may assert against the obligee all defences of the original obligor (article 9.2.7(1))";
}

pub relation new_obligor_may_not_set_off(o: Obligation) kind institutional {
    label en official "the new obligor may not exercise against the obligee a right of set-off available to the original obligor (article 9.2.7(2))";
}

pub relation security_discharged_with_original_obligor(o: Obligation) kind institutional {
    label en official "a security granted by a third person is discharged when the original obligor is discharged (article 9.2.8(2))";
}

pub relation obligee_rights_against_new_obligor(o: Obligation) kind institutional {
    label en official "the obligee may assert against the new obligor all its rights under the contract in respect of the obligation transferred (article 9.2.8(1))";
}

@source(PICC_ART9_2_1_EN, PICC_ART9_2_3_EN)
rule TransferByObligorsWithConsent(o: Obligation, original: Party, new_obligor: Party) defeasible {
    label en official "Article 9.2.1(a) with 9.2.3. An obligation may be transferred by an agreement between the original obligor and the new obligor, which requires the consent of the obligee";
    when transfer_by_obligors_agreement(o, original, new_obligor)
        and obligee_consented_to_transfer(o);
    then transfer_effective(o);
}

@source(PICC_ART9_2_1_EN, PICC_ART9_2_1_FR)
rule AssumptionByObligeeAgreement(o: Obligation, obligee: Party, new_obligor: Party) defeasible {
    label en official "Article 9.2.1(b). An obligation may be transferred by an agreement between the obligee and the new obligor by which the new obligor assumes the obligation";
    when assumption_by_obligee_agreement(o, obligee, new_obligor);
    then transfer_effective(o);
}

@source(PICC_ART9_2_2_EN, PICC_ART9_2_2_FR)
rule BusinessTransferExcluded(o: Obligation) defeater {
    label en official "Article 9.2.2. This Section does not apply to transfers of obligations made in the course of transferring a business";
    when business_transfer_rules_apply(o);
    defeat transfer_effective(o);
}

@source(PICC_ART9_2_4_EN, PICC_ART9_2_4_FR)
rule AdvanceConsentEffectiveOnNotice(o: Obligation, original: Party, new_obligor: Party) defeasible {
    label en official "Article 9.2.4. If the obligee has given its consent in advance, the transfer becomes effective when a notice of the transfer is given to the obligee or when the obligee acknowledges it";
    when transfer_by_obligors_agreement(o, original, new_obligor)
        and obligee_consented_in_advance(o)
        and transfer_notice_given_or_acknowledged(o);
    then transfer_effective(o);
}

@source(PICC_ART9_2_5_EN, PICC_ART9_2_5_FR)
rule JointAndSeveralLiabilityAfterTransfer(o: Obligation) defeasible {
    label en official "Article 9.2.5(3). Otherwise the original obligor and the new obligor are jointly and severally liable";
    when transfer_effective(o)
        and not_known(original_obligor_discharged_by_obligee(o))
        and not_known(original_obligor_retained(o));
    then obligors_jointly_and_severally_liable(o);
}

@source(PICC_ART9_2_6_EN, PICC_ART9_2_6_FR)
rule ThirdPartyPerformanceWithoutConsent(o: Obligation, other: Party) defeasible {
    label en official "Article 9.2.6(1). Without the obligee's consent, the obligor may contract with another person to perform the obligation in its place, unless the obligation has an essentially personal character";
    when third_party_performance_agreed(o, other)
        and not_known(obligation_personal_character(o));
    then third_party_may_perform(o, other);
}

@source(PICC_ART9_2_6_EN, PICC_ART9_2_6_FR)
rule ObligeeRetainsClaimDespiteThirdParty(o: Obligation, other: Party) strict {
    label en official "Article 9.2.6(2). The obligee retains its claim against the obligor";
    when third_party_performance_agreed(o, other);
    then obligee_retains_claim_against_obligor(o);
}

@source(PICC_ART9_2_7_EN, PICC_ART9_2_7_FR)
rule NewObligorAssertsDefences(o: Obligation) defeasible {
    label en official "Article 9.2.7(1). The new obligor may assert against the obligee all defences which the original obligor could assert";
    when transfer_effective(o)
        and defence_of_original_obligor(o);
    then new_obligor_may_assert_defence(o);
}

@source(PICC_ART9_2_7_EN, PICC_ART9_2_7_FR)
rule NewObligorCannotSetOff(o: Obligation) defeasible {
    label en official "Article 9.2.7(2). The new obligor may not exercise against the obligee any right of set-off available to the original obligor";
    when transfer_effective(o)
        and set_off_of_original_obligor(o);
    then new_obligor_may_not_set_off(o);
}

@source(PICC_ART9_2_8_EN, PICC_ART9_2_8_FR)
rule ObligeeRightsAgainstNewObligor(o: Obligation) defeasible {
    label en official "Article 9.2.8(1). The obligee may assert against the new obligor all its rights to payment or other performance under the contract in respect of the obligation transferred";
    when transfer_effective(o);
    then obligee_rights_against_new_obligor(o);
}

@source(PICC_ART9_2_8_EN, PICC_ART9_2_8_FR)
rule SecurityOfThirdPersonDischarged(o: Obligation) defeasible {
    label en official "Article 9.2.8(2). If the original obligor is discharged, a security granted by any person other than the new obligor is discharged, unless that person agrees that it should continue";
    when original_obligor_discharged_by_obligee(o)
        and security_by_third_person(o)
        and not_known(security_provider_agreed_to_continue(o));
    then security_discharged_with_original_obligor(o);
}

// --- Chapter 9, section 3: assignment of contracts ----------------------------

pub relation contract_assignment(c: Contract, assignor: Party, assignee: Party, other: Party) kind empirical {
    label en official "the assignor transfers by agreement its rights and obligations arising out of the contract with the other party";
}

pub relation business_transfer_of_contract(c: Contract) kind empirical {
    label en official "the assignment of the contract is made under the special rules governing transfers of contracts in the course of transferring a business";
}

pub relation other_party_consented(c: Contract) kind empirical {
    label en official "the other party has consented to the assignment of the contract";
}

pub relation other_party_consented_in_advance(c: Contract) kind empirical {
    label en official "the other party gave its consent in advance";
}

pub relation assignment_notice_given_or_acknowledged(c: Contract) kind empirical {
    label en official "a notice of the assignment was given to the other party or the other party acknowledged it";
}

pub relation assignor_discharged(c: Contract) kind empirical {
    label en official "the other party discharged the assignor";
}

pub relation assignor_retained(c: Contract) kind empirical {
    label en official "the other party retained the assignor as an obligor in case the assignee does not perform properly";
}

pub relation assignment_involves_rights(c: Contract) kind empirical {
    label en official "the assignment of the contract involves an assignment of rights";
}

pub relation assignment_involves_obligations(c: Contract) kind empirical {
    label en official "the assignment of the contract involves a transfer of obligations";
}

pub relation contract_assignment_effective(c: Contract) kind institutional {
    label en official "the assignment of the contract is effective (articles 9.3.1-9.3.4)";
}

pub relation assignor_and_assignee_jointly_liable(c: Contract) kind institutional {
    label en official "otherwise the assignor and the assignee are jointly and severally liable (article 9.3.5(3))";
}

pub relation rules_on_rights_apply(c: Contract) kind institutional {
    label en official "to the extent that the assignment involves an assignment of rights, articles 9.1.13 and 9.1.14 apply accordingly (articles 9.3.6(1), 9.3.7(1))";
}

pub relation rules_on_obligations_apply(c: Contract) kind institutional {
    label en official "to the extent that the assignment involves a transfer of obligations, articles 9.2.7 and 9.2.8 apply accordingly (articles 9.3.6(2), 9.3.7(2))";
}

@source(PICC_ART9_3_1_EN, PICC_ART9_3_3_EN)
rule ContractAssignmentRequiresConsent(c: Contract, assignor: Party, assignee: Party, other: Party) defeasible {
    label en official "Articles 9.3.1 and 9.3.3. The assignment of a contract is the transfer of the assignor's rights and obligations and requires the consent of the other party";
    when contract_assignment(c, assignor, assignee, other)
        and other_party_consented(c);
    then contract_assignment_effective(c);
}

@source(PICC_ART9_3_2_EN, PICC_ART9_3_2_FR)
rule BusinessContractTransferExcluded(c: Contract) defeater {
    label en official "Article 9.3.2. This Section does not apply to the assignment of contracts made in the course of transferring a business";
    when business_transfer_of_contract(c);
    defeat contract_assignment_effective(c);
}

@source(PICC_ART9_3_4_EN, PICC_ART9_3_4_FR)
rule AdvanceConsentToContractAssignment(c: Contract, assignor: Party, assignee: Party, other: Party) defeasible {
    label en official "Article 9.3.4. If the other party has given its consent in advance, the assignment becomes effective when a notice is given to the other party or when it acknowledges the assignment";
    when contract_assignment(c, assignor, assignee, other)
        and other_party_consented_in_advance(c)
        and assignment_notice_given_or_acknowledged(c);
    then contract_assignment_effective(c);
}

@source(PICC_ART9_3_5_EN, PICC_ART9_3_5_FR)
rule AssignorAndAssigneeJointlyLiable(c: Contract) defeasible {
    label en official "Article 9.3.5(3). Otherwise the assignor and the assignee are jointly and severally liable";
    when contract_assignment_effective(c)
        and not_known(assignor_discharged(c))
        and not_known(assignor_retained(c));
    then assignor_and_assignee_jointly_liable(c);
}

@source(PICC_ART9_3_6_EN, PICC_ART9_3_6_FR)
rule RightsRulesApplyToContractAssignment(c: Contract) defeasible {
    label en official "Articles 9.3.6(1) and 9.3.7(1). To the extent that the assignment involves an assignment of rights, the rules on defences, set-off and related rights apply accordingly";
    when contract_assignment_effective(c)
        and assignment_involves_rights(c);
    then rules_on_rights_apply(c);
}

@source(PICC_ART9_3_7_EN, PICC_ART9_3_7_FR)
rule ObligationRulesApplyToContractAssignment(c: Contract) defeasible {
    label en official "Articles 9.3.6(2) and 9.3.7(2). To the extent that the assignment involves a transfer of obligations, the rules on defences and related rights of the obligee apply accordingly";
    when contract_assignment_effective(c)
        and assignment_involves_obligations(c);
    then rules_on_obligations_apply(c);
}
