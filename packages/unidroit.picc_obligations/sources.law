language "law.core" version "0.2";
package unidroit.picc_obligations version "0.1.0";
namespace "urn:org:unidroit:clir:picc-obligations";

source PICC_2016 {
    kind doctrine;
    jurisdiction International;
    number "UNIDROIT Principles of International Commercial Contracts 2016";
    label en official "UNIDROIT Principles of International Commercial Contracts";
    label ru unofficial "Принципы международных коммерческих договоров УНИДРУА";
}

edition PICC_2016_EN of PICC_2016 {
    label en official "English black-letter rules, 2016 edition";
    language en;
    officiality official;
    adopted @2016-05-10;
    in_force @2016-05-10;
    materialization_status PINNED_UNOFFICIAL_COPY;
}

