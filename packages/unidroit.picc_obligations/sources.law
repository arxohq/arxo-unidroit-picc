    label ru unofficial "Русский текст black-letter rules, редакция 2016 года";
    language ru;
    officiality unofficial;
    adopted @2016-05-10;
    in_force @2016-05-10;
    materialization_status PINNED_UNOFFICIAL_COPY;
}

publication PICC_2016_RU_TEXT of PICC_2016_RU {
    media_type "text/plain; charset=utf-8";
    uri "https://www.unidroit.org/wp-content/uploads/2021/06/Unidroit-Principles-2016-Russian-bl.pdf";
    retrieved_at @2026-09-17T12:30:00Z;
    content_hash "sha256:89f86961c82987fe324c43d46146cc31aa20e8965511158dcf7fe5b43012066a";
    local_path "sources/picc-ru/ru.txt";
}

// Article 8.1 (English black-letter rules)
fragment PICC_ART8_1_EN in PICC_2016_EN {
    kind article;
    locator "article/8_1";
    text en official """ARTICLE 8.1
(Conditions of set-off)
(1) Where two parties owe each other money or other performances of the same
kind, either of them (“the first party”) may set off its obligation against that of its
obligee (“the other party”) if at the time of set-off,
(a) the first party is entitled to perform its obligation;
(b) the other party’s obligation is ascertained as to its existence and amount and
performance is due.
(2) If the obligations of both parties arise from the same contract, the first party
may also set off its obligation against an obligation of the other party which is not
ascertained as to its existence or to its amount.""";
    content_hash "sha256:5354ab6044dec82e75b970f8d01c92e7049356e2d451ec03b852c6e6e96e23f7";
}

// Статья 8.1 (русский парный якорь, unofficial)
fragment PICC_ART8_1_RU in PICC_2016_RU {
    kind article;
    locator "article/8_1";
    text ru unofficial """Статья 8.1
(Условия зачета)
(1) Если две стороны должны уплатить друг другу деньги или
совершить другое однородное исполнение, любая из них («первая сторона»)
может зачесть свое обязательство против обязательства своего кредитора
(«другой стороны»), если на момент зачета
(а) первая сторона вправе исполнить свое обязательство;
(b) обязательство другой стороны является определенным в
отношении его наличия и суммы, и срок его исполнения наступил.
(2) Если обязательства двух сторон возникли из одного договора,
первая сторона может также зачесть свое обязательство против
обязательства другой стороны, которое не является определенным в части
его существования или суммы.""";
    content_hash "sha256:25f3b4b68805ff73ab5d3c8d514ceba60bfe30e8e5356685391bb7cca0317b98";
}

// Article 8.2 (English black-letter rules)
fragment PICC_ART8_2_EN in PICC_2016_EN {
    kind article;
    locator "article/8_2";
    text en official """ARTICLE 8.2
(Foreign currency set-off)
Where the obligations are to pay money in different currencies, the right of set-off
may be exercised, provided that both currencies are freely convertible and the parties
have not agreed that the first party shall pay only in a specified currency.""";
    content_hash "sha256:8734fa0ee7351393a8d3efb6e572376a8d3a9ebab4fc196d703b25df2076fe60";
}

// Статья 8.2 (русский парный якорь, unofficial)
fragment PICC_ART8_2_RU in PICC_2016_RU {
    kind article;
    locator "article/8_2";
    text ru unofficial """Статья 8.2
(Зачет обязательств в иностранной валюте)
Когда обязательства состоят в уплате денежных сумм в разных
валютах, право зачета может быть осуществлено, если обе валюты свободно
конвертируемы и отсутствует соглашение сторон о том, что первая сторона
должна совершить платеж только в определенной валюте.""";
    content_hash "sha256:6b69fca223b832098daf2b578d0a726489aa6d9999e0d4e6a28aa6bf1a79c1d5";
}

// Article 8.3 (English black-letter rules)
fragment PICC_ART8_3_EN in PICC_2016_EN {
    kind article;
    locator "article/8_3";
    text en official """ARTICLE 8.3
(Set-off by notice)
The right of set-off is exercised by notice to the other party.""";
    content_hash "sha256:5f2e260bf786e65f69af24067d7feb4cc16d09d4aeb7783ca88d2357453199cc";
}

// Статья 8.3 (русский парный якорь, unofficial)
fragment PICC_ART8_3_RU in PICC_2016_RU {
    kind article;
    locator "article/8_3";
    text ru unofficial """Статья 8.3
(Зачет посредством уведомления)
Право зачета осуществляется посредством уведомления другой
стороны.""";
    content_hash "sha256:e8b0d15936f5f42db6478227708934ec50488cbb6d2f70d57200d983aeac9653";
}

// Article 8.4 (English black-letter rules)
fragment PICC_ART8_4_EN in PICC_2016_EN {
    kind article;
    locator "article/8_4";
    text en official """ARTICLE 8.4
(Content of notice)
(1) The notice must specify the obligations to which it relates.
(2) If the notice does not specify the obligation against which set-off is exercised,
the other party may, within a reasonable time, declare to the first party the obligation to
which set-off relates. If no such declaration is made, the set-off will relate to all the
obligations proportionally.""";
    content_hash "sha256:53a6756d64f1a7426c4a6d27d25fc090c3f002e591151ca29d288f8eec2b003c";
}

// Статья 8.4 (русский парный якорь, unofficial)
fragment PICC_ART8_4_RU in PICC_2016_RU {
    kind article;
    locator "article/8_4";
    text ru unofficial """Статья 8.4
(Содержание уведомления)
(1) В уведомлении должны быть указаны обязательства, к которым
оно относится.
(2) Если в уведомлении не указано обязательство, против которого
осуществляется зачет, другая сторона может в течение разумного срока
заявить первой стороне, по какому обязательству произведен зачет. Если
такого заявления не сделано, зачет будет относиться ко всем обязательствам
пропорционально.""";
    content_hash "sha256:62771d4c00047b98a933939cb848839f58cb921da315d5e42b904cf5ea2bb258";
}

// Article 8.5 (English black-letter rules)
fragment PICC_ART8_5_EN in PICC_2016_EN {
    kind article;
    locator "article/8_5";
    text en official """ARTICLE 8.5
(Effect of set-off)
(1) Set-off discharges the obligations.
(2) If obligations differ in amount, set-off discharges the obligations up to the
amount of the lesser obligation.
(3) Set-off takes effect as from the time of notice.""";
    content_hash "sha256:483f3bf9bf8396d55c18cd928751763cb88ce1fb4bcbc245bd4fb64fafb4df04";
}

// Статья 8.5 (русский парный якорь, unofficial)
fragment PICC_ART8_5_RU in PICC_2016_RU {
    kind article;
    locator "article/8_5";
    text ru unofficial """Статья 8.5
(Последствия зачета)
(1) Зачет прекращает обязательства.
(2) Если суммы обязательств различны, обязательства прекращаются
в объеме меньшего обязательства.
(3) Зачет вступает в силу с момента уведомления.""";
    content_hash "sha256:71579b4080fde5c3db1fd324207fa3c0e5284ebbd12e95732850eebe7a59c218";
}

// Article 9.1.1 (English black-letter rules)
fragment PICC_ART9_1_1_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_1";
    text en official """ARTICLE 9.1.1
(Definitions)
“Assignment of a right” means the transfer by agreement from one person (the
“assignor”) to another person (the “assignee”), including transfer by way of security, of
the assignor’s right to payment of a monetary sum or other performance from a third
person (“the obligor”).""";
    content_hash "sha256:7f65d81f1b187b9058eb6bb3db3b1fb3553bd27846569582c956d1392b5af62d";
}

// Статья 9.1.1 (русский парный якорь, unofficial)
fragment PICC_ART9_1_1_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_1";
    text ru unofficial """Статья 9.1.1
(Определения)
«Уступка права» означает передачу по соглашению от одного лица
(«цедента») другому лицу («цессионарию»), включая передачу в порядке
обеспечения, права цедента на получение денежной суммы или другого
исполнения от третьего лица («должника»).""";
    content_hash "sha256:6334851dafc608266d304e2f7c097b5e5de306ae7c037ea6c65118755ee1b945";
}

// Article 9.1.2 (English black-letter rules)
fragment PICC_ART9_1_2_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_2";
    text en official """ARTICLE 9.1.2
(Exclusions)
This Section does not apply to transfers made under the special rules governing the
transfers:
(a) of instruments such as negotiable instruments, documents of title or financial
instruments, or
(b) of rights in the course of transferring a business.""";
    content_hash "sha256:82a7867f63f00adab7799898f7b0aa6a40b89b30fca191dbcb3008eeeaf7e9dc";
}

// Статья 9.1.2 (русский парный якорь, unofficial)
fragment PICC_ART9_1_2_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_2";
    text ru unofficial """Статья 9.1.2
(Исключения)
Настоящий Раздел не применяется к передаче, совершаемой по
специальным правилам, регулирующим передачу
(а)
таких
документов,
как
ценные
бумаги,
документы,
удостоверяющие права собственности (титульные документы), финансовые
бумаги, или
(b) прав при передаче предприятия.""";
    content_hash "sha256:3dd23ac18557876e49aa19519aaea5c8e2cff48f89172c9fd0251e7f29904013";
}

// Article 9.1.3 (English black-letter rules)
fragment PICC_ART9_1_3_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_3";
    text en official """ARTICLE 9.1.3
(Assignability of non-monetary rights)
A right to non-monetary performance may be assigned only if the assignment does
not render the obligation significantly more burdensome.""";
    content_hash "sha256:1dd6ac17bb31ec1230aca2348bd6b597b3cba0ea01b6901f5620a21368c72f61";
}

// Статья 9.1.3 (русский парный якорь, unofficial)
fragment PICC_ART9_1_3_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_3";
    text ru unofficial """Статья 9.1.3.
(Возможность уступки неденежных прав)
Право на исполнение, имеющее неденежный характер, может быть
передано, только, если уступка не сделает обязательство значительно более
обременительным.""";
    content_hash "sha256:864e24796749fa776e682beba8b5e85a2429107788390a32df5fd253f22006b7";
}

// Article 9.1.4 (English black-letter rules)
fragment PICC_ART9_1_4_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_4";
    text en official """ARTICLE 9.1.4
(Partial assignment)
(1) A right to the payment of a monetary sum may be assigned partially.
(2) A right to other performance may be assigned partially only if it is divisible,
and the assignment does not render the obligation significantly more burdensome.""";
    content_hash "sha256:0a972829315bd8799974e1c0d42a4d4067607b403b962573dc9793145da9cea2";
}

// Статья 9.1.4 (русский парный якорь, unofficial)
fragment PICC_ART9_1_4_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_4";
    text ru unofficial """Статья 9.1.4
(Частичная уступка)
(1)
Право на получение денежной суммы может быть передано
частично.
(2) Право на получение другого исполнения может быть передано
частично, только, если соответствующее обязательство делимо, и уступка не
сделает обязательство значительно более обременительным.""";
    content_hash "sha256:4cadfd9f71361760891a3a15e798166c60789347a2d81c74ca910b141e43d410";
}

// Article 9.1.5 (English black-letter rules)
fragment PICC_ART9_1_5_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_5";
    text en official """ARTICLE 9.1.5
(Future rights)
A future right is deemed to be transferred at the time of the agreement, provided the
right, when it comes into existence, can be identified as the right to which the
assignment relates.""";
    content_hash "sha256:b294f3ecf852359c77ff23d4358e9ae179c30424d61c1f5f6c7a9c618b193393";
}

// Статья 9.1.5 (русский парный якорь, unofficial)
fragment PICC_ART9_1_5_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_5";
    text ru unofficial """Статья 9.1.5
(Будущие права)
Будущее право считается переданным в момент заключения
соответствующего соглашения, при условии, что это право, как только оно
возникает, может быть определено как право, подлежащее уступке.""";
    content_hash "sha256:ae313429f11b08252629220c348a80a0a519a9e7834edd30eb186e42a07b7dd3";
}

// Article 9.1.6 (English black-letter rules)
fragment PICC_ART9_1_6_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_6";
    text en official """ARTICLE 9.1.6
(Rights assigned without individual specification)
A number of rights may be assigned without individual specification, provided such
rights can be identified as rights to which the assignment relates at the time of the
assignment or when they come into existence.""";
    content_hash "sha256:fafcd030d6638d51337bb33117c0d5038751ffb5dda8f8649f37a63c900b6b49";
}

// Статья 9.1.6 (русский парный якорь, unofficial)
fragment PICC_ART9_1_6_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_6";
    text ru unofficial """Статья 9.1.6
(Уступка прав без индивидуализации)
Некоторые
права
могут
быть
переданы,
не
будучи
индивидуализированными, при условии, что такие права в момент их
уступки или возникновения могут быть индивидуализированы как права,
подлежащие уступке.""";
    content_hash "sha256:2cf8b2b28ae88874f5d121a86502479fad41c44e1d0eb4b711628a461523e671";
}

// Article 9.1.7 (English black-letter rules)
fragment PICC_ART9_1_7_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_7";
    text en official """ARTICLE 9.1.7
(Agreement between assignor and assignee sufficient)
(1) A right is assigned by mere agreement between the assignor and the assignee,
without notice to the obligor.
(2) The consent of the obligor is not required unless the obligation in the circumstances is of an essentially personal character.""";
    content_hash "sha256:dd33187be75c74a203c63bede046c2d5af001d982bf0400e7e791a4655b7093e";
}

// Статья 9.1.7 (русский парный якорь, unofficial)
fragment PICC_ART9_1_7_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_7";
    text ru unofficial """Статья 9.1.7
(Достаточность соглашения между цедентом и цессионарием)
(1) Право уступается лишь в силу соглашения между цедентом и
цессионарием, без уведомления должника.
(2) Согласие должника не требуется, если только обязательство в
конкретных обстоятельствах в существенном объеме не имеет личный
характер.""";
    content_hash "sha256:0c12c3dc80d7b5c8ad2245481f16ae257568371e34b7baf41ce79f7c102caa0f";
}

// Article 9.1.8 (English black-letter rules)
fragment PICC_ART9_1_8_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_8";
    text en official """ARTICLE 9.1.8
(Obligor’s additional costs)
The obligor has a right to be compensated by the assignor or the assignee for any
additional costs caused by the assignment.""";
    content_hash "sha256:581b3d40698f9029e9051cdf3bbdbc162974b3360aa1865a7a68f37a1b638739";
}

// Статья 9.1.8 (русский парный якорь, unofficial)
fragment PICC_ART9_1_8_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_8";
    text ru unofficial """Статья 9.1.8
(Дополнительные расходы должника)
Должник имеет право на компенсацию со стороны цедента или
цессионария любых дополнительных расходов, вызванных уступкой.""";
    content_hash "sha256:bb2ff75563293cbc2a99d4cd9db036284a3699bddfcb800d45e1ac3323be5bef";
}

// Article 9.1.9 (English black-letter rules)
fragment PICC_ART9_1_9_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_9";
    text en official """ARTICLE 9.1.9
(Non-assignment clauses)
(1) The assignment of a right to the payment of a monetary sum is effective
notwithstanding an agreement between the assignor and the obligor limiting or
prohibiting such an assignment. However, the assignor may be liable to the obligor for
breach of contract.
(2) The assignment of a right to other performance is ineffective if it is contrary to
an agreement between the assignor and the obligor limiting or prohibiting the
assignment. Nevertheless, the assignment is effective if the assignee, at the time of the
assignment, neither knew nor ought to have known of the agreement. The assignor may
then be liable to the obligor for breach of contract.""";
    content_hash "sha256:f2d94d9d3f84b9d3b6275c809fa6e2b42913d83eb3766b10984a76fe433b61d7";
}

// Статья 9.1.9 (русский парный якорь, unofficial)
fragment PICC_ART9_1_9_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_9";
    text ru unofficial """Статья 9.1.9
(Оговорки о запрете уступки прав)
(1) Уступка права на выплату денежной суммы имеет силу, несмотря
на соглашение цедента и должника, ограничивающее или запрещающее
такую уступку. Тем не менее, цедент может нести ответственность перед
должником за нарушение договора.
(2) Уступка права на получение другого исполнения, совершенная
вопреки соглашению цедента и должника, ограничивающему или
запрещающему такую уступку, не имеет силы. Тем не менее, уступка имеет
силу, если в момент уступки цессионарий не знал и не обязан был знать о
таком соглашении. В последнем случае цедент может нести ответственность
перед должником за нарушение договора.""";
    content_hash "sha256:694ea23dc6765ef75b4abd9700fa86f681ce50b7d0cac9570d3c1193fd4a0d5a";
}

// Article 9.1.10 (English black-letter rules)
fragment PICC_ART9_1_10_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_10";
    text en official """ARTICLE 9.1.10
(Notice to the obligor)
(1) Until the obligor receives a notice of the assignment from either the assignor
or the assignee, it is discharged by paying the assignor.
(2) After the obligor receives such a notice, it is discharged only by paying the
assignee.""";
    content_hash "sha256:371460bdcae0b75fd120a62d2e8804d707b365012a66af63272c813dd4c93ab9";
}

// Статья 9.1.10 (русский парный якорь, unofficial)
fragment PICC_ART9_1_10_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_10";
    text ru unofficial """Статья 9.1.10
(Уведомление должника)
(1) До получения уведомления об уступке от цедента или цессионария,
обязательство должника прекращается платежом цеденту.
(2) После получения такого уведомления должником его обязательство
прекращается только уплатой цессионарию.""";
    content_hash "sha256:496691cb99f0876f31f46af5068e4230a756639fae32ed998fe816832d5f608e";
}

// Article 9.1.11 (English black-letter rules)
fragment PICC_ART9_1_11_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_11";
    text en official """ARTICLE 9.1.11
(Successive assignments)
If the same right has been assigned by the same assignor to two or more successive
assignees, the obligor is discharged by paying according to the order in which the
notices were received.""";
    content_hash "sha256:a6e37557864be1f2d08de9bbf7ca3d7ce70289fd31c0a81f225a8c0c46dfb9fe";
}

// Статья 9.1.11 (русский парный якорь, unofficial)
fragment PICC_ART9_1_11_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_11";
    text ru unofficial """Статья 9.1.11
(Последующие уступки)
Если одно и то же право было уступлено одним и тем же цедентом
двум или более цессионариям, обязательство должника прекращается
уплатой в том порядке, в котором были получены уведомления.""";
    content_hash "sha256:b4c7dd3855cc9f2dc4cce1bb23aa2b8b1acc7203550cc1c7c4ebde63fc99c39f";
}

// Article 9.1.12 (English black-letter rules)
fragment PICC_ART9_1_12_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_12";
    text en official """ARTICLE 9.1.12
(Adequate proof of assignment)
(1) If notice of the assignment is given by the assignee, the obligor may request
the assignee to provide within a reasonable time adequate proof that the assignment has
been made.
(2) Until adequate proof is provided, the obligor may withhold payment.
(3) Unless adequate proof is provided, notice is not effective.
(4) Adequate proof includes, but is not limited to, any writing emanating from the
assignor and indicating that the assignment has taken place.""";
    content_hash "sha256:a7344043bd8f09d81778d9f767362b8952953fee6a7fced30ddd46409f56ecd1";
}

// Статья 9.1.12 (русский парный якорь, unofficial)
fragment PICC_ART9_1_12_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_12";
    text ru unofficial """Статья 9.1.12
(Надлежащее подтверждение уступки)
(1) Если уведомление об уступке направляется цессионарием, должник
может потребовать от последнего представить в разумный срок надлежащее
подтверждение совершения уступки.
(2) До представления надлежащего подтверждения должник может
задержать платеж.
(3) Уведомление не имеет силы без надлежащего подтверждения.
(4) Надлежащее подтверждение включает, но не ограничивается,
любой письменный документ, исходящий от цедента и подтверждающий, что
уступка имела место.""";
    content_hash "sha256:98f9f37d9e90e87f057004fd908797a83672d444923f25faa7bd458d41ed40a2";
}

// Article 9.1.13 (English black-letter rules)
fragment PICC_ART9_1_13_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_13";
    text en official """ARTICLE 9.1.13
(Defences and rights of set-off)
(1) The obligor may assert against the assignee all defences that the obligor could
assert against the assignor.
(2) The obligor may exercise against the assignee any right of set-off available to
the obligor against the assignor up to the time notice of assignment was received.""";
    content_hash "sha256:b990af445f1a33a63ef4a5c46b646baa59ac9ae0e3d38aabc51f4fed81056152";
}

// Статья 9.1.13 (русский парный якорь, unofficial)
fragment PICC_ART9_1_13_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_13";
    text ru unofficial """Статья 9.1.13
(Возражения и право зачета)
(1) Должник может выдвинуть против цессионария все возражения,
которые должник мог бы выдвинуть против цедента.
(2) Должник может осуществить в отношении цессионария любые
права зачета, которые имелись у должника в отношении цедента до момента,
когда было получено уведомление об уступке.""";
    content_hash "sha256:f42f38106a31ae8bd046b28dc039580ca536591542250bcf9b6650a8937aa59a";
}

// Article 9.1.14 (English black-letter rules)
fragment PICC_ART9_1_14_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_14";
    text en official """ARTICLE 9.1.14
(Rights related to the right assigned)
The assignment of a right transfers to the assignee:
(a) all the assignor’s rights to payment or other performance under the contract in
respect of the right assigned, and
(b) all rights securing performance of the right assigned.""";
    content_hash "sha256:d327cb5a6579bc4157bc3269d7f1a7144d4fb94a3e6f48edab92436e2d6351b4";
}

// Статья 9.1.14 (русский парный якорь, unofficial)
fragment PICC_ART9_1_14_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_14";
    text ru unofficial """Статья 9.1.14
(Права, связанные с переданным правом)
При уступке права к цессионарию переходят:
(а) все права цедента на получение платежа или иного исполнения по
договору, связанные с переданным правом, и
(b) все права, обеспечивающие переданное право.""";
    content_hash "sha256:e560997fb7c4808ada5b1392c1bbb4b12053f2772a191d9c4220b09b1298eccd";
}

// Article 9.1.15 (English black-letter rules)
fragment PICC_ART9_1_15_EN in PICC_2016_EN {
    kind article;
    locator "article/9_1_15";
    text en official """ARTICLE 9.1.15
(Undertakings of the assignor)
The assignor undertakes towards the assignee, except as otherwise disclosed to the
assignee, that:
(a) the assigned right exists at the time of the assignment, unless the right is a
future right;
(b) the assignor is entitled to assign the right;
(c) the right has not been previously assigned to another assignee, and it is free
from any right or claim from a third party;
(d) the obligor does not have any defences;
(e) neither the obligor nor the assignor has given notice of set-off concerning the
assigned right and will not give any such notice;
(f) the assignor will reimburse the assignee for any payment received from the
obligor before notice of the assignment was given.""";
    content_hash "sha256:b4c9e5fa597188e0f2091791b3b67c04f16b25192ab3a626c9a6984a3ffb8f90";
}

// Статья 9.1.15 (русский парный якорь, unofficial)
fragment PICC_ART9_1_15_RU in PICC_2016_RU {
    kind article;
    locator "article/9_1_15";
    text ru unofficial """Статья 9.1.15
(Обязательства цедента)
Если иное не заявлено цессионарию, цедент несет перед цессионарием
ответственность за то, что:
(а) уступленное право существует на момент уступки, если только речь
не идет об уступке будущего права;
(b) цедент имеет право на уступку;
(c) данное право не было ранее уступлено другому цессионарию и
свободно от любых прав и притязаний третьих лиц;
(d) у должника отсутствует право на возражения;
(e) ни должник, ни цедент не направили уведомление о зачете,
касающемся переданного права, и не направит такого уведомления;
(f) цедент возместит цессионарию любой платеж, полученный от
должника до направления уведомления об уступке.""";
    content_hash "sha256:afaf42c7d8fa56cc80df5c851d7af8daf75babe2e6800e4ae2c6f6a7ba7d9e2c";
}

// Article 9.2.1 (English black-letter rules)
fragment PICC_ART9_2_1_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_1";
    text en official """ARTICLE 9.2.1
(Modes of transfer)
An obligation to pay money or render other performance may be transferred from
one person (the “original obligor”) to another person (the “new obligor”) either
(a) by an agreement between the original obligor and the new obligor subject to
Article 9.2.3, or
(b) by an agreement between the obligee and the new obligor, by which the new
obligor assumes the obligation.""";
    content_hash "sha256:661923f2b4e343959d204d4e667d55644289666c292de3e535ec87e42c30d37c";
}

// Статья 9.2.1 (русский парный якорь, unofficial)
fragment PICC_ART9_2_1_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_1";
    text ru unofficial """Статья 9.2.1
(Способы перевода)
Обязательство уплатить денежную сумму или произвести иное
исполнение может быть переведено с одного лица («первоначальный
должник») на другое лицо («новый должник») путем
а) соглашения между первоначальным должником и новым
должником на основании статьи 9.2.3, или
b) соглашения между кредитором и новым должником, согласно
которому новый должник принимает на себя обязательство.""";
    content_hash "sha256:fad144af67803916e8dff16604df79617851c81ad3cb8be0be054ec6b18a5740";
}

// Article 9.2.2 (English black-letter rules)
fragment PICC_ART9_2_2_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_2";
    text en official """ARTICLE 9.2.2
(Exclusion)
This Section does not apply to transfers of obligations made under the special rules
governing transfers of obligations in the course of transferring a business.""";
    content_hash "sha256:287594c54a57d01460b1066cc4180c25f844c9374ddfc6adc1d49dc76906a84d";
}

// Статья 9.2.2 (русский парный якорь, unofficial)
fragment PICC_ART9_2_2_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_2";
    text ru unofficial """Статья 9.2.2
(Исключение)
Настоящий Раздел не применяется к переводу обязательств,
совершаемому по особым правилам, регулирующим перевод обязательств в
процессе передачи предприятия.""";
    content_hash "sha256:58a073f5e7249cf29e6e2d2602882544c9161d32d6b8f49a985461651e2fd8a0";
}

// Article 9.2.3 (English black-letter rules)
fragment PICC_ART9_2_3_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_3";
    text en official """ARTICLE 9.2.3
(Requirement of obligee’s consent to transfer)
The transfer of an obligation by an agreement between the original obligor and the
new obligor requires the consent of the obligee.""";
    content_hash "sha256:2107ccc2daee8ba5be2a4e4beb50ff46708919f6626f3f6d9bca69c803893c1b";
}

// Статья 9.2.3 (русский парный якорь, unofficial)
fragment PICC_ART9_2_3_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_3";
    text ru unofficial """Статья 9.2.3
(Необходимость согласия кредитора на перевод)
Для
перевода
обязательства
путем
соглашения
между
первоначальным должником и новым должником требуется согласие
кредитора.""";
    content_hash "sha256:dc88d0ac974348b55d7255bd48bd3d2e03255a66f3f9b669ef02190228d9efee";
}

// Article 9.2.4 (English black-letter rules)
fragment PICC_ART9_2_4_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_4";
    text en official """ARTICLE 9.2.4
(Advance consent of obligee)
(1) The obligee may give its consent in advance.
(2) If the obligee has given its consent in advance, the transfer of the obligation
becomes effective when a notice of the transfer is given to the obligee or when the
obligee acknowledges it.
(1)""";
    content_hash "sha256:baf10bd1f065976470cbc8420b95a5f83f6c5e05d488f219a4a8429ebc7c5a71";
}

// Статья 9.2.4 (русский парный якорь, unofficial)
fragment PICC_ART9_2_4_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_4";
    text ru unofficial """Статья 9.2.4
(Согласие кредитора на будущее)
(1) Кредитор может дать согласие на будущее.
(2) Если кредитор дал такое согласие, перевод обязательства вступает
в силу в момент, когда кредитор получает уведомление о переводе, либо
когда кредитор его подтвердит.""";
    content_hash "sha256:474a12f3de07098dbbb0be06154cd008dc67e6959da78725efd5afd153d2d299";
}

// Article 9.2.5 (English black-letter rules)
fragment PICC_ART9_2_5_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_5";
    text en official """ARTICLE 9.2.5
(Discharge of original obligor)
The obligee may discharge the original obligor.
(2) The obligee may also retain the original obligor as an obligor in case the new
obligor does not perform properly.
(3) Otherwise the original obligor and the new obligor are jointly and severally
liable.""";
    content_hash "sha256:3ef4a0c33a1598929bdabda451ff8f321247468aef46e92a35f84a60ce80cb1f";
}

// Статья 9.2.5 (русский парный якорь, unofficial)
fragment PICC_ART9_2_5_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_5";
    text ru unofficial """Статья 9.2.5
(Освобождение первоначального должника от обязательства)
(1) Кредитор может освободить первоначального должника от
обязательства.
(2) Кредитор может также предъявить требование к первоначальному
должнику, если новый должник не исполняет обязательство надлежащим
образом.
(3) В иных случаях первоначальный должник и новый должник несут
солидарную ответственность.""";
    content_hash "sha256:eb08bb5d031d2590e8381c71bb76e010b0fb967a4970f8ae24ee783ed64c6068";
}

// Article 9.2.6 (English black-letter rules)
fragment PICC_ART9_2_6_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_6";
    text en official """ARTICLE 9.2.6
(Third party performance)
(1) Without the obligee’s consent, the obligor may contract with another person that
this person will perform the obligation in place of the obligor, unless the obligation in the
circumstances has an essentially personal character.
(2) The obligee retains its claim against the obligor.""";
    content_hash "sha256:a5244ef218831aeff47d8e0a33ad4c4cc9a33b3f97f4612ec9ec4739cd030c66";
}

// Статья 9.2.6 (русский парный якорь, unofficial)
fragment PICC_ART9_2_6_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_6";
    text ru unofficial """Статья 9.2.6
(Исполнение третьим лицом)
(1) Должник может без согласия кредитора договориться с третьим
лицом, о том, что такое лицо исполнит обязательство вместо должника, если
только обязательство в конкретных обстоятельствах не носит по существу
личный характер.
(2) Кредитор сохраняет право требования к должнику.""";
    content_hash "sha256:3aab3e0704f9c6de592adf05703917686acdd652c96469486ec51c82d0f26c68";
}

// Article 9.2.7 (English black-letter rules)
fragment PICC_ART9_2_7_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_7";
    text en official """ARTICLE 9.2.7
(Defences and rights of set-off)
(1) The new obligor may assert against the obligee all defences which the original
obligor could assert against the obligee.
(2) The new obligor may not exercise against the obligee any right of set-off
available to the original obligor against the obligee.""";
    content_hash "sha256:05e12cbfa95b38c9536fb2880f4c1dd68b598e280d4bcc0adf8c766ab732f3c2";
}

// Статья 9.2.7 (русский парный якорь, unofficial)
fragment PICC_ART9_2_7_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_7";
    text ru unofficial """Статья 9.2.7
(Возражения и право зачета)
(1) Новый должник может выдвинуть против кредитора все
возражения, которые первоначальный должник мог бы выдвинуть против
кредитора.
(2) Новый должник не может осуществить в отношении кредитора
никакие права зачета, которыми обладал первоначальный должник в
отношении кредитора.""";
    content_hash "sha256:99e51917d4532d0905ef735735d360f0ec0d5339a548a975380cdbc1906041d3";
}

// Article 9.2.8 (English black-letter rules)
fragment PICC_ART9_2_8_EN in PICC_2016_EN {
    kind article;
    locator "article/9_2_8";
    text en official """ARTICLE 9.2.8
(Rights related to the obligation transferred)
(1) The obligee may assert against the new obligor all its rights to payment or
other performance under the contract in respect of the obligation transferred.
(2) If the original obligor is discharged under Article 9.2.5(1), a security granted
by any person other than the new obligor for the performance of the obligation is
discharged, unless that other person agrees that it should continue to be available to the
obligee.
(3) Discharge of the original obligor also extends to any security of the original
obligor given to the obligee for the performance of the obligation, unless the security is
over an asset which is transferred as part of a transaction between the original obligor
and the new obligor.""";
    content_hash "sha256:2fb728694e6eff3ad564d4211c13b70fa4a18d541c33a0b6c8900ebca57ecede";
}

// Статья 9.2.8 (русский парный якорь, unofficial)
fragment PICC_ART9_2_8_RU in PICC_2016_RU {
    kind article;
    locator "article/9_2_8";
    text ru unofficial """Статья 9.2.8
(Права, связанные с переданным обязательством)
(1) Кредитор может осуществить в отношении нового должника все
свои права на получение платежа или иного исполнения по договору,
связанные с переданным обязательством.
(2) Если первоначальный должник освобожден от обязательства на
основании статьи 9.2.5(1), то обеспечение, предоставленное любым лицом,
помимо нового должника, теряет силу, если только такое лицо не согласится
на то, что его обязательство в отношении кредитора сохранит силу.
(3) Освобождение первоначального должника от обязательства также
распространяется на любое обеспечение исполнения обязательства,
предоставленное первоначальным должником кредитору, если только такое
обеспечение
не
распространяется
на
имущество,
переданное
первоначальным должником новому должнику в результате сделки между
ними.""";
    content_hash "sha256:8fbb7f1bd0c0082745dd25013e49b7d84b8d0ca41535ae91bceaa26e6cc8ce49";
}

// Article 9.3.1 (English black-letter rules)
fragment PICC_ART9_3_1_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_1";
    text en official """ARTICLE 9.3.1
(Definitions)
“Assignment of a contract” means the transfer by agreement from one person (the
“assignor”) to another person (the “assignee”) of the assignor’s rights and obligations
arising out of a contract with another person (the “other party”).""";
    content_hash "sha256:4e89126106a88acb3f8d78e62b90b414af384be6ea4f742bbb75ae422f987bd0";
}

// Статья 9.3.1 (русский парный якорь, unofficial)
fragment PICC_ART9_3_1_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_1";
    text ru unofficial """Статья 9.3.1
(Определения)
«Уступка договора» означает передачу путем соглашения одним
лицом («цедентом») другому лицу («цессионарию») прав и обязанностей
цедента, вытекающих из договора с третьим лицом («другой стороной»).""";
    content_hash "sha256:1cd0f67ec482f33256f0537a2527ef9885ce4502b0cb9ef99c24824e733ca6d6";
}

// Article 9.3.2 (English black-letter rules)
fragment PICC_ART9_3_2_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_2";
    text en official """ARTICLE 9.3.2
(Exclusion)
This Section does not apply to the assignment of contracts made under the special
rules governing transfers of contracts in the course of transferring a business.""";
    content_hash "sha256:b93dfaa86861f8dd82c6f4ee6076f7ebdff9530034426bfdde356fa26c5fb06e";
}

// Статья 9.3.2 (русский парный якорь, unofficial)
fragment PICC_ART9_3_2_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_2";
    text ru unofficial """Статья 9.3.2
(Исключение)
Настоящий Раздел не применяется к уступке договоров, совершаемой
по особым правилам, регулирующим уступку договоров в процессе передачи
предприятия.""";
    content_hash "sha256:5b878d7cc972b27b18aaa599ecdf1e38f80dbb9b26c93c726866c83061550640";
}

// Article 9.3.3 (English black-letter rules)
fragment PICC_ART9_3_3_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_3";
    text en official """ARTICLE 9.3.3
(Requirement of consent of the other party)
The assignment of a contract requires the consent of the other party.
(1)""";
    content_hash "sha256:4f2ad457f9b4d56ed58e7a5b0c8e3fe9cf8ddff23736361dfef4f0af13cb1064";
}

// Статья 9.3.3 (русский парный якорь, unofficial)
fragment PICC_ART9_3_3_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_3";
    text ru unofficial """Статья 9.3.3
(Необходимость согласия другой стороны)
Для уступки договора требуется согласие другой стороны.""";
    content_hash "sha256:c610e7bcfbddb4b24265b06b707a4a3656f782fae235a64419b3d10696ca61e0";
}

// Article 9.3.4 (English black-letter rules)
fragment PICC_ART9_3_4_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_4";
    text en official """ARTICLE 9.3.4
(Advance consent of the other party)
The other party may give its consent in advance.
(2) If the other party has given its consent in advance, the assignment of the
contract becomes effective when a notice of the assignment is given to the other party or
when the other party acknowledges it.""";
    content_hash "sha256:743654937be296cb2bd3ff2b7e0eec53e67926eb5043e6645491dde27230a2d9";
}

// Статья 9.3.4 (русский парный якорь, unofficial)
fragment PICC_ART9_3_4_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_4";
    text ru unofficial """Статья 9.3.4
(Согласие другой стороны на будущее)
(1) Другая сторона может дать согласие на будущее (авансом).
(2) Если другая сторона дала такое согласие, уступка договора
вступает в силу в момент, когда другая сторона получает уведомление об
уступке либо когда другая сторона ознакомится с ним.""";
    content_hash "sha256:b003cbf875d0f8d2a45076d95ba5f3804bde0dcf96b1bdd51f17c68dda84d0c2";
}

// Article 9.3.5 (English black-letter rules)
fragment PICC_ART9_3_5_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_5";
    text en official """ARTICLE 9.3.5
(Discharge of the assignor)
(1) The other party may discharge the assignor.
(2) The other party may also retain the assignor as an obligor in case the assignee
does not perform properly.
(3) Otherwise the assignor and the assignee are jointly and severally liable.""";
    content_hash "sha256:81e85e98644ae28454368e43238318ac297bd16743922a8762e0f4881ca4e52e";
}

// Статья 9.3.5 (русский парный якорь, unofficial)
fragment PICC_ART9_3_5_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_5";
    text ru unofficial """Статья 9.3.5
(Освобождение цедента от обязательств)
(1) Другая сторона может освободить цедента от обязательств.
(2) Другая сторона может также рассматривать цедента в качестве
должника, если цессионарий не исполняет обязательство надлежащим
образом.
(3) В иных случаях цедент и цессионарий несут солидарную
ответственность.""";
    content_hash "sha256:fc925437bab5cf22db028f759ace49e2db87fe3221cd97e6d1ad78d950cee7b8";
}

// Article 9.3.6 (English black-letter rules)
fragment PICC_ART9_3_6_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_6";
    text en official """ARTICLE 9.3.6
(Defences and rights of set-off)
(1) To the extent that the assignment of a contract involves an assignment of
rights, Article 9.1.13 applies accordingly.
(2) To the extent that the assignment of a contract involves a transfer of
obligations, Article 9.2.7 applies accordingly.""";
    content_hash "sha256:c73830be3a59dc8ac7e7e7d507bfe0b95578069bc724273d7b35ace442ca17b5";
}

// Статья 9.3.6 (русский парный якорь, unofficial)
fragment PICC_ART9_3_6_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_6";
    text ru unofficial """Статья 9.3.6
(Возражения и право зачета)
(1) В той мере, в которой переуступка договора затрагивает уступку
прав, соответственно применяется статья 9.1.13.
(2) В той мере, в которой уступка договора затрагивает перевод
обязательств, соответственно применяется статья 9.2.7.""";
    content_hash "sha256:ef7692109ac02b129f31087adcf86d9a41dde2d1ada17adbf1597f443a004b69";
}

// Article 9.3.7 (English black-letter rules)
fragment PICC_ART9_3_7_EN in PICC_2016_EN {
    kind article;
    locator "article/9_3_7";
    text en official """ARTICLE 9.3.7
(Rights transferred with the contract)
(1) To the extent that the assignment of a contract involves an assignment of
rights, Article 9.1.14 applies accordingly.
(2) To the extent that the assignment of a contract involves a transfer of
obligations, Article 9.2.8 applies accordingly.""";
    content_hash "sha256:788c822fea35c2fa502f479cff57eb58d7011e3d5829fcfe5882b62f5867e48e";
}

// Статья 9.3.7 (русский парный якорь, unofficial)
fragment PICC_ART9_3_7_RU in PICC_2016_RU {
    kind article;
    locator "article/9_3_7";
    text ru unofficial """Статья 9.3.7
(Права, уступленные вместе с договором)
(1) В той мере, в которой уступка договора затрагивает уступку прав,
соответственно применяется статья 9.1.14.
(2) В той мере, в которой уступка договора затрагивает перевод
обязательств, соответственно применяется статья 9.2.8.""";
    content_hash "sha256:d6e797eaf7b31ff49e23fdb4a6ae904dd9d52d0dfe52ecaa9cf36bc2b0ce0096";
}

// Article 11.1.1 (English black-letter rules)
fragment PICC_ART11_1_1_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_1";
    text en official """ARTICLE 11.1.1
(Definitions)
When several obligors are bound by the same obligation towards an obligee:
(a) the obligations are joint and several when each obligor is bound for the whole
obligation;
(b) the obligations are separate when each obligor is bound only for its share.""";
    content_hash "sha256:544115badd8f95df2a8dba9acfe7cae5f15e3561b750824d4fe9654c9c4e4dc9";
}

// Статья 11.1.1 (русский парный якорь, unofficial)
fragment PICC_ART11_1_1_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_1";
    text ru unofficial """Статья 11.1.1
(Определения)
Если несколько должников связаны одним и тем же обязательством по
отношению к кредитору:
(а) обязательства считаются солидарными, если каждый должник
отвечает за обязательство в полном объеме;
(b) обязательство считаются долевыми,
если каждый должник
отвечает только за свою часть (долю).""";
    content_hash "sha256:aee95ea76d0d334a6f65af793d226c4abed387c71a9325bbabf6c20efe7582a9";
}

// Article 11.1.2 (English black-letter rules)
fragment PICC_ART11_1_2_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_2";
    text en official """ARTICLE 11.1.2
(Presumption of joint and several obligations)
When several obligors are bound by the same obligation towards an obligee, they
are presumed to be jointly and severally bound, unless the circumstances indicate
otherwise.""";
    content_hash "sha256:9450a6f5b7b62b8eed6d0d9cf676fa8b6b7754eadc4e6dec6008955e1acca7b3";
}

// Статья 11.1.2 (русский парный якорь, unofficial)
fragment PICC_ART11_1_2_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_2";
    text ru unofficial """Статья 11.1.2
(Презумпция солидарной ответственности)
Если несколько должников связаны одним и тем же обязательством по
отношению к кредитору, предполагается, что они являются солидарными
должниками, если иное не следует из обстоятельств.""";
    content_hash "sha256:7c3bae47ad545ed82b261df2dd605540ae3dd1fdb38cd9120fe5dd2f320ae854";
}

// Article 11.1.3 (English black-letter rules)
fragment PICC_ART11_1_3_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_3";
    text en official """ARTICLE 11.1.3
(Obligee’s rights against joint and several obligors)
When obligors are jointly and severally bound, the obligee may require performance
from any one of them, until full performance has been received.""";
    content_hash "sha256:b1e9fd7ff7f93cf4fee7d5cafac362c3a251dae36d48ab39f16a5d2feaddaf18";
}

// Статья 11.1.3 (русский парный якорь, unofficial)
fragment PICC_ART11_1_3_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_3";
    text ru unofficial """Статья 11.1.3
(Права кредитора в отношении солидарных должников)
Кредитор может требовать исполнение от любого из солидарных
должников до тех пор, пока он не получил полного исполнения.""";
    content_hash "sha256:fd8894110a478eff7ed668cb38ef3afc74f4b01f9b34fce0e8a9bb150cfbc412";
}

// Article 11.1.4 (English black-letter rules)
fragment PICC_ART11_1_4_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_4";
    text en official """ARTICLE 11.1.4
(Availability of defences and rights of set-off)
A joint and several obligor against whom a claim is made by the obligee may assert
all the defences and rights of set-off that are personal to it or that are common to all the
co-obligors, but may not assert defences or rights of set-off that are personal to one or
several of the other co-obligors.""";
    content_hash "sha256:231f35dcd6d5a7e8c569cadac75a1831c268c35c093d2c08b58f0c637ce20eff";
}

// Статья 11.1.4 (русский парный якорь, unofficial)
fragment PICC_ART11_1_4_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_4";
    text ru unofficial """Статья 11.1.4
(Наличие возражений и право зачета)
Солидарный должник, которому кредитор предъявил требование,
может заявить возражения и произвести зачет требований, принадлежащих
лично ему или которые являются общими для всех должников, однако он не
может этого сделать, если эти права принадлежат только одному или
нескольким из других должников.""";
    content_hash "sha256:7ec6ae2868b0d42b6f41d03e8eb7b62709b33b6cb4eaeed0bc9c2fc4c1f0693d";
}

// Article 11.1.5 (English black-letter rules)
fragment PICC_ART11_1_5_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_5";
    text en official """ARTICLE 11.1.5
(Effect of performance or set-off)
Performance or set-off by a joint and several obligor or set-off by the obligee against
one joint and several obligor discharges the other obligors in relation to the obligee to
the extent of the performance or set-off.""";
    content_hash "sha256:cf95306ec2809f36c5678d87a6e75f08beca7712e4c75ff2f10222c1cfaca269";
}

// Статья 11.1.5 (русский парный якорь, unofficial)
fragment PICC_ART11_1_5_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_5";
    text ru unofficial """Статья 11.1.5
(Последствия исполнения или зачета)
Исполнение или зачет, произведенный солидарным должником, или
зачет кредитора по отношению к одному из солидарных должников,
освобождает от обязательства других должников в отношении кредитора в
объеме произведенного исполнения или зачета.""";
    content_hash "sha256:fde3a3499d8ef68e70aa65fbeb48829cc6ea6c7523bf79692e0ff8c11396d525";
}

// Article 11.1.6 (English black-letter rules)
fragment PICC_ART11_1_6_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_6";
    text en official """ARTICLE 11.1.6
(Effect of release or settlement)
(1) Release of one joint and several obligor, or settlement with one joint and
several obligor, discharges all the other obligors for the share of the released or settling
obligor, unless the circumstances indicate otherwise.
(2) When the other obligors are discharged for the share of the released obligor,
they no longer have a contributory claim against the released obligor under Article
11.1.10.""";
    content_hash "sha256:36046c700ea7acf14393ffbc765e579280fbaedbb25d13ea63f0585c2d7728b9";
}

// Статья 11.1.6 (русский парный якорь, unofficial)
fragment PICC_ART11_1_6_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_6";
    text ru unofficial """Статья 11.1.6
(Последствия освобождения или мирного урегулирования)
(1) Освобождение одного из солидарных должников от обязательства
или мирное урегулирование с одним из солидарных должников, освобождает
всех остальных должников в соответствующей части обязательства, если
обстоятельства не указывают на иное.
(2) Если другие должники освобождаются от части обязательства,
принадлежащей освобожденному должнику, они больше не имеют к нему
регрессного права в соответствии со статьей 11.1.10.""";
    content_hash "sha256:e2f9d2e1427247f355b68e162f6051d32de7aca390e0469d970425447bcd862b";
}

// Article 11.1.7 (English black-letter rules)
fragment PICC_ART11_1_7_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_7";
    text en official """ARTICLE 11.1.7
(Effect of expiration or suspension of limitation period)
(1) Expiration of the limitation period of the obligee’s rights against one joint and
several obligor does not affect:
(a) the obligations to the obligee of the other joint and several obligors; or
(b) the rights of recourse between the joint and several obligors under Article
11.1.10.
(2) If the obligee initiates proceedings under Articles 10.5, 10.6 or 10.7 against
one joint and several obligor, the running of the limitation period is also suspended
against the other joint and several obligors.""";
    content_hash "sha256:731fe98cf6fb7d373817ebd5597995ee0790c1f53def688a2adaddcd80123e4e";
}

// Статья 11.1.7 (русский парный якорь, unofficial)
fragment PICC_ART11_1_7_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_7";
    text ru unofficial """Статья 11.1.7
(Последствия истечения, перерыва или приостановления исковой давности)
(1) Истечение исковой давности в отношении права требования
кредитора к одному солидарному должнику не затрагивает:
(а) обязательств других солидарных должников в отношении
кредитора, или
(b) прав регресса между солидарными должниками в соответствии со
статьей 11.1.10.
(2) Если кредитор возбуждает судебное разбирательство в
соответствии со статьями 10.5, 10.6 или 10.7 против одного солидарного
должника, течение исковой давности соответственно прерывается или
приостанавливается в отношении остальных солидарных должников.""";
    content_hash "sha256:1d8e9e6980b7cb570632a7bcd4943e52001209c1b2ef3b8cdb6ddd83d75ca7f1";
}

// Article 11.1.8 (English black-letter rules)
fragment PICC_ART11_1_8_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_8";
    text en official """ARTICLE 11.1.8
(Effect of judgment)
(1) A decision by a court as to the liability to the obligee of one joint and several
obligor does not affect:
(a) the obligations to the obligee of the other joint and several obligors; or
(b) the rights of recourse between the joint and several obligors under Article
11.1.10.
(2) However, the other joint and several obligors may rely on such a decision,
except if it was based on grounds personal to the obligor concerned. In such a case, the
rights of recourse between the joint and several obligors under Article 11.1.10 are
affected accordingly.""";
    content_hash "sha256:34ea25241395fc085eb9363900866ce1a6c4b49a5f061bf47d3be6a9d8445b96";
}

// Статья 11.1.8 (русский парный якорь, unofficial)
fragment PICC_ART11_1_8_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_8";
    text ru unofficial """Статья 11.1.8
(Последствия судебного решения)
(1) Судебное решение об ответственности перед кредитором одного
солидарного должника не затрагивает:
(а) обязательств других солидарных должников в отношении
кредитора, или
(b) прав регресса между солидарными должниками в соответствии со
статьей 11.1.10.
(2) Однако, другие солидарные кредиторы могут полагаться на такое
решение, кроме случая, когда оно было основано на обстоятельствах,
имеющих личный характер для указанного должника. В таком случае права
регресса между солидарными должниками в соответствии со статьей 11.1.10
затрагиваются соответственно.""";
    content_hash "sha256:e436f255b474a86e12c400ffb4ecf8e4fce45c6997f1427b2bf521f40d610935";
}

// Article 11.1.9 (English black-letter rules)
fragment PICC_ART11_1_9_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_9";
    text en official """ARTICLE 11.1.9
(Apportionment among joint and several obligors)
As among themselves, joint and several obligors are bound in equal shares, unless
the circumstances indicate otherwise.""";
    content_hash "sha256:da39dcc21002ec16462c25b75ae61a303ddd9b04dcacb7b34cd7efd52d4ed408";
}

// Статья 11.1.9 (русский парный якорь, unofficial)
fragment PICC_ART11_1_9_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_9";
    text ru unofficial """Cтатья 11.1.9
(Распределение между солидарными должниками)
Солидарные должники между собой отвечают в равных долях, если
только обстоятельства не указывают на иное.""";
    content_hash "sha256:4b565ba2646262e81992d59391a6ca3d49f3d06b80fbbe9c4de83f083ae38a61";
}

// Article 11.1.10 (English black-letter rules)
fragment PICC_ART11_1_10_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_10";
    text en official """ARTICLE 11.1.10
(Extent of contributory claim)
A joint and several obligor who has performed more than its share may claim the
excess from any of the other obligors to the extent of each obligor’s unperformed share.""";
    content_hash "sha256:c14f7eb530bb23e90145a6b71260b06c75ea54285fe0a1f6310580b6d3167648";
}

// Статья 11.1.10 (русский парный якорь, unofficial)
fragment PICC_ART11_1_10_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_10";
    text ru unofficial """Статья 11.1.10
(Размер регрессного требования)
Солидарный должник, исполнивший более того, что составляло его
долю, может требовать превышение с любого из других солидарных
должников в пределах неисполненной каждым должником доли.""";
    content_hash "sha256:2ee8320708edd183c0c63764c9c47df63a0ac5c868ba40de1f3eaa7472e093c5";
}

// Article 11.1.11 (English black-letter rules)
fragment PICC_ART11_1_11_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_11";
    text en official """ARTICLE 11.1.11
(Rights of the obligee)
(1) A joint and several obligor to whom Article 11.1.10 applies may also exercise
the rights of the obligee, including all rights securing their performance, to recover the
excess from all or any of the other obligors to the extent of each obligor’s unperformed
share.
(2) An obligee who has not received full performance retains its rights against the
co-obligors to the extent of the unperformed part, with precedence over co-obligors
exercising contributory claims.""";
    content_hash "sha256:f0155c50984da6038e62d19fa7e685462f84eee6f311c269459e5fc479bd8671";
}

// Статья 11.1.11 (русский парный якорь, unofficial)
fragment PICC_ART11_1_11_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_11";
    text ru unofficial """Статья 11.1.11
(Права кредитора)
(1) Солидарный должник, к которому применяется статья 11.1.10 ,
может также осуществить права кредитора в целях компенсации
превышения его доли, включая все права, обеспечивающие исполнение, со
всех или с любого должника в пределах неисполненной каждым должником
доли.
(2) Кредитор, который не получил полное исполнение, сохраняет свои
права в отношении других должников в пределах неисполненной части, имея
преимущество перед другими должниками при предъявлении ими
регрессных требований.""";
    content_hash "sha256:9979fa38a15a3c4eb3fb309e75d1506f2f89996a92faf560f530cba38a20214c";
}

// Article 11.1.12 (English black-letter rules)
fragment PICC_ART11_1_12_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_12";
    text en official """ARTICLE 11.1.12
(Defences in contributory claims)
A joint and several obligor against whom a claim is made by the co-obligor who has
performed the obligation:
(a) may raise any common defences and rights of set-off that were available to be
asserted by the co-obligor against the obligee ;
(b) may assert defences which are personal to itself ;
(c) may not assert defences and rights of set-off which are personal to one or
several of the other co-obligors.""";
    content_hash "sha256:ba5a5eeae6503033bd666afec9e77dff9062dd8b5f8dab40de5b5a8df345068c";
}

// Статья 11.1.12 (русский парный якорь, unofficial)
fragment PICC_ART11_1_12_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_12";
    text ru unofficial """Статья 11.1.12
(Возражения по регрессным требованиям)
Солидарный должник, которому заявлено требование другим
солидарным должником, который исполнил обязательство:
(а) может использовать любые общие возражения и право зачета, если
таковые имеются для предъявления кредитору другим солидарным
должником;
(b) может использовать возражения, имеющиеся лично у него;
(с) не может использовать возражения и право зачета, которые
принадлежат только один или несколько других солидарных должников.""";
    content_hash "sha256:e0af29c7a1beb41682ae1ea7f8de26b6f3f78308d20a0504a6d51873e2a3e50d";
}

// Article 11.1.13 (English black-letter rules)
fragment PICC_ART11_1_13_EN in PICC_2016_EN {
    kind article;
    locator "article/11_1_13";
    text en official """ARTICLE 11.1.13
(Inability to recover)
If a joint and several obligor who has performed more than that obligor’s share is
unable, despite all reasonable efforts, to recover contribution from another joint and
several obligor, the share of the others, including the one who has performed, is
increased proportionally.""";
    content_hash "sha256:afdc9cb3cf6badd393d980b2e98cd803bb85db4b6b8f9ee4cfa68e2e52bb43a3";
}

// Статья 11.1.13 (русский парный якорь, unofficial)
fragment PICC_ART11_1_13_RU in PICC_2016_RU {
    kind article;
    locator "article/11_1_13";
    text ru unofficial """Статья 11.1.13
(Невозможность возмещения)
Если солидарный должник, который исполнил более своей доли, не
может, несмотря на все разумные попытки, получить возмещение от другого
солидарного должника, доля других солидарных должников, включая того,
который осуществил исполнение, соответственно увеличивается.""";
    content_hash "sha256:09f1726587a1a3d0d43062c5a33389ae4d0d762eed6bae599970488777a36a0d";
}

// Article 11.2.1 (English black-letter rules)
fragment PICC_ART11_2_1_EN in PICC_2016_EN {
    kind article;
    locator "article/11_2_1";
    text en official """ARTICLE 11.2.1
(Definitions)
When several obligees can claim performance of the same obligation from an
obligor:
(a) the claims are separate when each obligee can only claim its share;
(b) the claims are joint and several when each obligee can claim the whole
performance;
(c) the claims are joint when all obligees have to claim performance together.""";
    content_hash "sha256:2269a074848b2f01d830c1ae6b7cc5c8c677da323e7c1b4d7576d3c1cf0eae48";
}

// Статья 11.2.1 (русский парный якорь, unofficial)
fragment PICC_ART11_2_1_RU in PICC_2016_RU {
    kind article;
    locator "article/11_2_1";
    text ru unofficial """Статья 11.2.1
(Определения)
В случае, когда несколько кредиторов могут требовать исполнение
одного и того же обязательства от должника:
(а) требования являются долевыми, если каждый кредитор может
требовать только свою долю;
(b) требования являются солидарными, если каждый кредитор может
требовать полного исполнения;
(с) требования являются совместными, если кредиторы должны
требовать исполнения все вместе.""";
    content_hash "sha256:ebb6aefce36fcb28e38f1e9daecc2464f8d3f46dbc6735ca045bbd397166f867";
}

// Article 11.2.2 (English black-letter rules)
fragment PICC_ART11_2_2_EN in PICC_2016_EN {
    kind article;
    locator "article/11_2_2";
    text en official """ARTICLE 11.2.2
(Effects of joint and several claims)
Full performance of an obligation in favour of one of the joint and several obligees
discharges the obligor towards the other obligees.""";
    content_hash "sha256:2086f59f35a77bfa93e95b331c2adf050f68129b87ef1a97ec0b36e906913ae8";
}

// Статья 11.2.2 (русский парный якорь, unofficial)
fragment PICC_ART11_2_2_RU in PICC_2016_RU {
    kind article;
    locator "article/11_2_2";
    text ru unofficial """Статья 11.2.2
(Последствия солидарных требований)
Полное исполнение обязательства в пользу одного солидарного
кредитора освобождает должника от обязательства в отношении других
кредиторов.""";
    content_hash "sha256:e15cc951219a38139b19abb5cc14a463b2a1fadd5d0939127fcae6fed47bebf7";
}

// Article 11.2.3 (English black-letter rules)
fragment PICC_ART11_2_3_EN in PICC_2016_EN {
    kind article;
    locator "article/11_2_3";
    text en official """ARTICLE 11.2.3
(Availability of defences against joint and several obligees)
(1) The obligor may assert against any of the joint and several obligees all the
defences and rights of set-off that are personal to its relationship to that obligee or that it
can assert against all the co-obligees, but may not assert defences and rights of set-off
that are personal to its relationship to one or several of the other co-obligees.
(2) The provisions of Articles 11.1.5, 11.1.6, 11.1.7 and 11.1.8 apply, with
appropriate adaptations, to joint and several claims.""";
    content_hash "sha256:cc4ebe4139ef822f949b503f9c47f59684f9854efe272cc9eacec38ecd4e4a1f";
}

// Статья 11.2.3 (русский парный якорь, unofficial)
fragment PICC_ART11_2_3_RU in PICC_2016_RU {
    kind article;
    locator "article/11_2_3";
    text ru unofficial """Статья 11.2.3
(Наличие возражений к солидарным кредиторам)
(1) Должник может заявить любому солидарному кредитору все
возражения и права на зачет, которые вытекают из его отношений только с
этим кредитором, или которые он может предъявить ко всем солидарным
кредиторам, однако, он не может заявить возражения и права на зачет,
которые вытекают из отношений только с одним или несколькими другими
кредиторами.
(2) Положения статей 11.1.5, 11.1.6, 11.1.7 и 11.1.8, применяются с
соответствующими поправками к солидарным требованиям.""";
    content_hash "sha256:11198a289d13fc4339da9aaa344487644d6695d2afcc2b57b738b881f0ccad7b";
}

// Article 11.2.4 (English black-letter rules)
fragment PICC_ART11_2_4_EN in PICC_2016_EN {
    kind article;
    locator "article/11_2_4";
    text en official """ARTICLE 11.2.4
(Allocation between joint and several obligees)
(1) As among themselves, joint and several obligees are entitled to equal shares,
unless the circumstances indicate otherwise.
(2) An obligee who has received more than its share must transfer the excess to
the other obligees to the extent of their respective shares.""";
    content_hash "sha256:e738a6222e41f848e388d603f151080edfcd63d31244f5a7a584be028926cf67";
}

// Статья 11.2.4 (русский парный якорь, unofficial)
fragment PICC_ART11_2_4_RU in PICC_2016_RU {
    kind article;
    locator "article/11_2_4";
    text ru unofficial """Статья 11.2.4
(Распределение между солидарными кредиторами)
(1) Солидарные кредиторы в отношениях между собой имеют право на
равные доли, если иное не вытекает из обстоятельств.
(2) Кредитор, получивший более причитающейся ему доли, должен
передать превышение другим кредиторам в пределах их соответствующих
долей.""";
    content_hash "sha256:23d6e2d00885bd1fd433c501463bb1c3eed0b1cca59abd9d2bb52b938468b788";
}
