language "law.core" version "0.2";
package unidroit.picc_obligations version "0.1.0";
namespace "urn:org:unidroit:clir:picc-obligations";

// Дело 3. Перевод обязательств (9.2.1-9.2.8) и уступка договора (9.3.1-9.3.7).
//
// СОГЛАСИЕ КРЕДИТОРА — УСЛОВИЕ, А НЕ ФОРМАЛЬНОСТЬ: перевод соглашением
// должников без согласия кредитора силы не имеет, а данное заранее согласие
// действует с извещения или признания.

test "PICCO-03-TRANSFER-AND-CONTRACT-ASSIGNMENT" {
    given {
        context {
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": transfer_by_obligors_agreement(entity_ref("urn:case:picco:ob-1"), entity_ref("urn:case:picco:original"), entity_ref("urn:case:picco:new")) { origin case_input; }
        assert "a1": obligee_consented_to_transfer(entity_ref("urn:case:picco:ob-1")) { origin case_input; }
        assert "a2": defence_of_original_obligor(entity_ref("urn:case:picco:ob-1")) { origin case_input; }
        assert "a3": set_off_of_original_obligor(entity_ref("urn:case:picco:ob-1")) { origin case_input; }
        assert "a4": transfer_by_obligors_agreement(entity_ref("urn:case:picco:ob-2"), entity_ref("urn:case:picco:original"), entity_ref("urn:case:picco:new")) { origin case_input; }
        assert "a5": obligee_consented_in_advance(entity_ref("urn:case:picco:ob-2")) { origin case_input; }
        assert "a6": transfer_notice_given_or_acknowledged(entity_ref("urn:case:picco:ob-2")) { origin case_input; }
        assert "a7": assumption_by_obligee_agreement(entity_ref("urn:case:picco:ob-3"), entity_ref("urn:case:picco:obligee"), entity_ref("urn:case:picco:new")) { origin case_input; }
        assert "a8": transfer_by_obligors_agreement(entity_ref("urn:case:picco:ob-4"), entity_ref("urn:case:picco:original"), entity_ref("urn:case:picco:new")) { origin case_input; }
        assert "a9": obligee_consented_to_transfer(entity_ref("urn:case:picco:ob-4")) { origin case_input; }
        assert "a10": business_transfer_rules_apply(entity_ref("urn:case:picco:ob-4")) { origin case_input; }
        assert "a11": original_obligor_discharged_by_obligee(entity_ref("urn:case:picco:ob-3")) { origin case_input; }
        assert "a12": security_by_third_person(entity_ref("urn:case:picco:ob-3")) { origin case_input; }
        assert "a13": third_party_performance_agreed(entity_ref("urn:case:picco:ob-5"), entity_ref("urn:case:picco:helper")) { origin case_input; }
        assert "a14": third_party_performance_agreed(entity_ref("urn:case:picco:ob-6"), entity_ref("urn:case:picco:helper")) { origin case_input; }
        assert "a15": obligation_personal_character(entity_ref("urn:case:picco:ob-6")) { origin case_input; }
        assert "a16": contract_assignment(entity_ref("urn:case:picco:contract-1"), entity_ref("urn:case:picco:assignor"), entity_ref("urn:case:picco:assignee"), entity_ref("urn:case:picco:other")) { origin case_input; }
        assert "a17": other_party_consented(entity_ref("urn:case:picco:contract-1")) { origin case_input; }
        assert "a18": assignment_involves_rights(entity_ref("urn:case:picco:contract-1")) { origin case_input; }
        assert "a19": assignment_involves_obligations(entity_ref("urn:case:picco:contract-1")) { origin case_input; }
        assert "a20": contract_assignment(entity_ref("urn:case:picco:contract-2"), entity_ref("urn:case:picco:assignor"), entity_ref("urn:case:picco:assignee"), entity_ref("urn:case:picco:other")) { origin case_input; }
        assert "a21": other_party_consented_in_advance(entity_ref("urn:case:picco:contract-2")) { origin case_input; }
        assert "a22": assignment_notice_given_or_acknowledged(entity_ref("urn:case:picco:contract-2")) { origin case_input; }
        assert "a23": contract_assignment(entity_ref("urn:case:picco:contract-3"), entity_ref("urn:case:picco:assignor"), entity_ref("urn:case:picco:assignee"), entity_ref("urn:case:picco:other")) { origin case_input; }
        assert "a24": other_party_consented(entity_ref("urn:case:picco:contract-3")) { origin case_input; }
        assert "a25": business_transfer_of_contract(entity_ref("urn:case:picco:contract-3")) { origin case_input; }
    }

    evaluate truth(transfer_effective(entity_ref("urn:case:picco:ob-1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(TransferByObligorsWithConsent);

    evaluate truth(transfer_effective(entity_ref("urn:case:picco:ob-2")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AdvanceConsentEffectiveOnNotice);

    evaluate truth(transfer_effective(entity_ref("urn:case:picco:ob-3")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AssumptionByObligeeAgreement);

    // Передача предприятия выведена из раздела самим источником.
    evaluate truth(transfer_effective(entity_ref("urn:case:picco:ob-4")));
    expect truth_status == NEITHER;

    evaluate truth(obligors_jointly_and_severally_liable(entity_ref("urn:case:picco:ob-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(JointAndSeveralLiabilityAfterTransfer);

    evaluate truth(new_obligor_may_assert_defence(entity_ref("urn:case:picco:ob-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(NewObligorAssertsDefences);

    // А вот зачёт первоначального должника новому не переходит.
    evaluate truth(new_obligor_may_not_set_off(entity_ref("urn:case:picco:ob-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(NewObligorCannotSetOff);

    evaluate truth(obligee_rights_against_new_obligor(entity_ref("urn:case:picco:ob-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ObligeeRightsAgainstNewObligor);

    evaluate truth(security_discharged_with_original_obligor(entity_ref("urn:case:picco:ob-3")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(SecurityOfThirdPersonDischarged);

    evaluate truth(third_party_may_perform(entity_ref("urn:case:picco:ob-5"), entity_ref("urn:case:picco:helper")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ThirdPartyPerformanceWithoutConsent);

    // Существенно личное обязательство исполнить за должника нельзя.
    evaluate truth(third_party_may_perform(entity_ref("urn:case:picco:ob-6"), entity_ref("urn:case:picco:helper")));
    expect truth_status == NEITHER;

    evaluate truth(obligee_retains_claim_against_obligor(entity_ref("urn:case:picco:ob-5")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ObligeeRetainsClaimDespiteThirdParty);

    evaluate truth(contract_assignment_effective(entity_ref("urn:case:picco:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ContractAssignmentRequiresConsent);

    evaluate truth(contract_assignment_effective(entity_ref("urn:case:picco:contract-2")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AdvanceConsentToContractAssignment);

    evaluate truth(contract_assignment_effective(entity_ref("urn:case:picco:contract-3")));
    expect truth_status == NEITHER;

    evaluate truth(assignor_and_assignee_jointly_liable(entity_ref("urn:case:picco:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AssignorAndAssigneeJointlyLiable);

    evaluate truth(rules_on_rights_apply(entity_ref("urn:case:picco:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(RightsRulesApplyToContractAssignment);

    evaluate truth(rules_on_obligations_apply(entity_ref("urn:case:picco:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ObligationRulesApplyToContractAssignment);
}
