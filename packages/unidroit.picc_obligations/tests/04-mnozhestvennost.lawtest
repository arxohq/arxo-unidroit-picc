language "law.core" version "0.2";
package unidroit.picc_obligations version "0.1.0";
namespace "urn:org:unidroit:clir:picc-obligations";

// Дело 4. Множественность должников и кредиторов (11.1.1-11.2.4).
//
// СОЛИДАРНОСТЬ ПРЕЗЮМИРУЕТСЯ: несколько должников по одному обязательству
// предполагаются солидарными, и опровергают презумпцию обстоятельства дела.

test "PICCO-04-PLURALITY" {
    given {
        context {
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": several_obligors_bound(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")) { origin case_input; }
        assert "a1": several_obligors_bound(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")) { origin case_input; }
        assert "a2": defence_personal_to_obligor(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")) { origin case_input; }
        assert "a3": performance_or_set_off_by_obligor(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")) { origin case_input; }
        assert "a4": performed_more_than_share(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")) { origin case_input; }
        assert "a5": unable_to_recover_contribution(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")) { origin case_input; }
        assert "a6": released_or_settled(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")) { origin case_input; }
        assert "a7": limitation_expired_against_one(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")) { origin case_input; }
        assert "a8": proceedings_against_one_obligor(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")) { origin case_input; }
        assert "a9": judgment_on_one_obligor(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")) { origin case_input; }
        assert "a10": several_obligors_bound(entity_ref("urn:case:picco:ob-s"), entity_ref("urn:case:picco:third")) { origin case_input; }
        assert "a11": bound_only_for_share(entity_ref("urn:case:picco:ob-s"), entity_ref("urn:case:picco:third")) { origin case_input; }
        assert "a12": circumstances_indicate_separate(entity_ref("urn:case:picco:ob-s")) { origin case_input; }
        assert "a13": several_obligors_bound(entity_ref("urn:case:picco:ob-pers"), entity_ref("urn:case:picco:fourth")) { origin case_input; }
        assert "a14": defence_personal_to_other_obligor(entity_ref("urn:case:picco:ob-pers"), entity_ref("urn:case:picco:fourth")) { origin case_input; }
        assert "a15": defence_personal_to_obligor(entity_ref("urn:case:picco:ob-pers"), entity_ref("urn:case:picco:fourth")) { origin case_input; }
        assert "a16": several_obligors_bound(entity_ref("urn:case:picco:ob-pg"), entity_ref("urn:case:picco:fifth")) { origin case_input; }
        assert "a17": judgment_on_one_obligor(entity_ref("urn:case:picco:ob-pg"), entity_ref("urn:case:picco:fifth")) { origin case_input; }
        assert "a18": judgment_on_personal_grounds(entity_ref("urn:case:picco:ob-pg"), entity_ref("urn:case:picco:fifth")) { origin case_input; }
        assert "a19": several_obligees(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")) { origin case_input; }
        assert "a20": several_obligees(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-b")) { origin case_input; }
        assert "a21": each_obligee_may_claim_whole(entity_ref("urn:case:picco:ob-c")) { origin case_input; }
        assert "a22": full_performance_to_one_obligee(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")) { origin case_input; }
        assert "a23": defence_personal_to_obligee(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")) { origin case_input; }
        assert "a24": obligee_received_more_than_share(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")) { origin case_input; }
    }

    evaluate truth(joint_and_several_obligation(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(PresumptionOfJointAndSeveralObligations);

    // Обстоятельства опровергли презумпцию: обязательства раздельны.
    evaluate truth(joint_and_several_obligation(entity_ref("urn:case:picco:ob-s"), entity_ref("urn:case:picco:third")));
    expect truth_status == NEITHER;

    evaluate truth(separate_obligation(entity_ref("urn:case:picco:ob-s"), entity_ref("urn:case:picco:third")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ObligationsSeparateWhenEachBoundForShare);

    evaluate truth(obligee_may_require_from_any(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ObligeeMayRequireFromAnyObligor);

    evaluate truth(defence_assertable_by_obligor(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(DefencesOfJointObligor);

    // Возражение, личное другому содолжнику, заявить нельзя.
    evaluate truth(defence_assertable_by_obligor(entity_ref("urn:case:picco:ob-pers"), entity_ref("urn:case:picco:fourth")));
    expect truth_status == NEITHER;

    evaluate truth(others_discharged_by_performance(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(PerformanceDischargesOthers);

    evaluate truth(others_discharged_for_share(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ReleaseDischargesForShare);

    evaluate truth(other_obligations_unaffected(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ExpirationAgainstOneDoesNotAffectOthers);

    evaluate truth(suspension_extends_to_others(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(SuspensionAgainstOneExtendsToOthers);

    evaluate truth(judgment_may_be_relied_on(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:second")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(OthersMayRelyOnJudgment);

    // Решение на личных основаниях другим должникам не помогает.
    evaluate truth(judgment_may_be_relied_on(entity_ref("urn:case:picco:ob-pg"), entity_ref("urn:case:picco:fifth")));
    expect truth_status == NEITHER;

    evaluate truth(equal_shares_among_obligors(entity_ref("urn:case:picco:ob-j")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(EqualSharesAmongObligors);

    evaluate truth(contributory_claim(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ContributoryClaimOfPerformingObligor);

    evaluate truth(obligee_has_precedence(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ObligeePrecedenceOverContribution);

    evaluate truth(shares_increased_proportionally(entity_ref("urn:case:picco:ob-j"), entity_ref("urn:case:picco:first")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(SharesIncreasedWhenRecoveryImpossible);

    evaluate truth(joint_and_several_claim(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(JointAndSeveralClaims);

    evaluate truth(obligor_discharged_towards_others(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(PerformanceToOneObligeeDischarges);

    evaluate truth(defence_assertable_against_obligee(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(DefencesAgainstJointObligee);

    evaluate truth(equal_shares_among_obligees(entity_ref("urn:case:picco:ob-c")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(EqualSharesAmongObligees);

    evaluate truth(excess_transferred_to_obligees(entity_ref("urn:case:picco:ob-c"), entity_ref("urn:case:picco:creditor-a")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ExcessTransferredToOtherObligees);
}
