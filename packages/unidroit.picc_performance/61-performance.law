// Articles 6.1.1-6.1.17. Performance of obligations: time, order, place, payment,
// imputation of payments and public permission.

language "law.core" version "0.2";
package unidroit.picc_performance version "0.1.0";
namespace "urn:org:unidroit:clir:picc-performance";

// --- Article 6.1.1: time of performance ---------------------------------------

pub relation time_fixed_by_contract(o: Obligation) kind empirical {
    label en official "a time is fixed by or determinable from the contract";
}

pub relation period_fixed_by_contract(o: Obligation) kind empirical {
    label en official "a period of time is fixed by or determinable from the contract";
}

pub relation circumstances_indicate_other_party_chooses(o: Obligation) kind empirical {
    label en official "the circumstances indicate that the other party is to choose a time within the period";
}

pub relation must_perform_at_fixed_time(o: Obligation) kind institutional {
    label en official "the party must perform at the time fixed by or determinable from the contract (article 6.1.1(a))";
}

pub relation may_perform_within_period(o: Obligation) kind institutional {
    label en official "the party may perform at any time within the period fixed by or determinable from the contract (article 6.1.1(b))";
}

pub relation must_perform_within_reasonable_time(o: Obligation) kind institutional {
    label en official "the party must perform within a reasonable time after the conclusion of the contract (article 6.1.1(c))";
}

@source(PICC_ART6_1_1_EN, PICC_ART6_1_1_FR)
rule PerformanceAtFixedTime(o: Obligation) strict {
    label en official "Article 6.1.1(a). If a time is fixed by or determinable from the contract, a party must perform at that time";
    when time_fixed_by_contract(o);
    then must_perform_at_fixed_time(o);
}

@source(PICC_ART6_1_1_EN, PICC_ART6_1_1_FR)
rule PerformanceWithinPeriod(o: Obligation) defeasible {
    label en official "Article 6.1.1(b). If a period of time is fixed by or determinable from the contract, a party may perform at any time within that period unless circumstances indicate that the other party is to choose a time";
    when period_fixed_by_contract(o);
    then may_perform_within_period(o);
    unless period_fixed_by_contract(o)
        and circumstances_indicate_other_party_chooses(o);
}

@source(PICC_ART6_1_1_EN, PICC_ART6_1_1_FR)
rule PerformanceWithinReasonableTime(o: Obligation, c: Contract, p: Party) defeasible {
    label en official "Article 6.1.1(c). In any other case a party must perform within a reasonable time after the conclusion of the contract";
    when obligation_of(o, c, p)
        and not_known(time_fixed_by_contract(o))
        and not_known(period_fixed_by_contract(o));
    then must_perform_within_reasonable_time(o);
}

// --- Article 6.1.2: performance at one time -----------------------------------

pub relation performance_can_be_rendered_at_one_time(o: Obligation) kind empirical {
    label en official "the performance can be rendered at one time";
}

pub relation circumstances_indicate_instalments(o: Obligation) kind empirical {
    label en official "the circumstances indicate performance in instalments";
}

pub relation must_perform_at_one_time(o: Obligation) kind institutional {
    label en official "the party must perform at one time (article 6.1.2)";
}

@source(PICC_ART6_1_2_EN, PICC_ART6_1_2_FR)
rule PerformanceAtOneTime(o: Obligation) defeasible {
    label en official "Article 6.1.2. In cases under Article 6.1.1(b) or (c), a party must perform at one time if that performance can be rendered at one time and the circumstances do not indicate otherwise";
    when performance_can_be_rendered_at_one_time(o)
        and not_known(circumstances_indicate_instalments(o));
    then must_perform_at_one_time(o);
}

// --- Articles 6.1.3 and 6.1.5: partial and earlier performance ----------------

pub relation offer_to_perform_in_part(o: Obligation) kind empirical {
    label en official "an offer to perform in part is made at the time performance is due";
}

pub relation offer_of_earlier_performance(o: Obligation) kind empirical {
    label en official "an earlier performance is offered";
}

pub external judgment relation obligee_has_no_legitimate_interest(o: Obligation) {
    authority Tribunal;
    label en official "the obligee has no legitimate interest in rejecting the offer to perform";
}

pub relation additional_expenses_caused(o: Obligation) kind empirical {
    label en official "additional expenses were caused to the obligee by the partial or earlier performance";
}

pub relation time_of_own_performance_fixed_independently(o: Obligation) kind empirical {
    label en official "the time for the performance of the party's own obligations has been fixed irrespective of the performance of the other party's obligations";
}

pub relation may_reject_partial_performance(o: Obligation) kind institutional {
    label en official "the obligee may reject the offer to perform in part (article 6.1.3(1))";
}

pub relation may_reject_earlier_performance(o: Obligation) kind institutional {
    label en official "the obligee may reject an earlier performance (article 6.1.5(1))";
}

pub relation expenses_borne_by_obligor(o: Obligation) kind institutional {
    label en official "the additional expenses are to be borne by the obligor, without prejudice to any other remedy (articles 6.1.3(2), 6.1.5(3))";
}

pub relation own_performance_time_unaffected(o: Obligation) kind institutional {
    label en official "acceptance of an earlier performance does not affect the time for the performance of the party's own obligations (article 6.1.5(2))";
}

@source(PICC_ART6_1_3_EN, PICC_ART6_1_3_FR)
rule RejectionOfPartialPerformance(o: Obligation) defeasible {
    label en official "Article 6.1.3(1). The obligee may reject an offer to perform in part, whether or not coupled with an assurance as to the balance, unless it has no legitimate interest in so doing";
    when offer_to_perform_in_part(o);
    then may_reject_partial_performance(o);
    unless offer_to_perform_in_part(o)
        and obligee_has_no_legitimate_interest(o);
}

@source(PICC_ART6_1_5_EN, PICC_ART6_1_5_FR)
rule RejectionOfEarlierPerformance(o: Obligation) defeasible {
    label en official "Article 6.1.5(1). The obligee may reject an earlier performance unless it has no legitimate interest in so doing";
    when offer_of_earlier_performance(o);
    then may_reject_earlier_performance(o);
    unless offer_of_earlier_performance(o)
        and obligee_has_no_legitimate_interest(o);
}

@source(PICC_ART6_1_3_EN, PICC_ART6_1_5_EN)
rule AdditionalExpensesBorneByObligor(o: Obligation) strict {
    label en official "Articles 6.1.3(2) and 6.1.5(3). Additional expenses caused to the obligee by partial or earlier performance are to be borne by the obligor";
    when additional_expenses_caused(o);
    then expenses_borne_by_obligor(o);
}

@source(PICC_ART6_1_5_EN, PICC_ART6_1_5_FR)
rule EarlierPerformanceDoesNotShiftOwnTime(o: Obligation) strict {
    label en official "Article 6.1.5(2). Acceptance of an earlier performance does not affect the time for the performance of the party's own obligations if that time has been fixed irrespective of the other party's performance";
    when offer_of_earlier_performance(o)
        and time_of_own_performance_fixed_independently(o);
    then own_performance_time_unaffected(o);
}

// --- Article 6.1.4: order of performance --------------------------------------

pub relation performances_can_be_simultaneous(c: Contract) kind empirical {
    label en official "the performances of the parties can be rendered simultaneously";
}

pub relation performance_requires_period(o: Obligation) kind empirical {
    label en official "the performance of only one party requires a period of time";
}

pub relation circumstances_indicate_other_order(c: Contract) kind empirical {
    label en official "the circumstances indicate another order of performance";
}

pub relation bound_to_perform_simultaneously(c: Contract) kind institutional {
    label en official "the parties are bound to render their performances simultaneously (article 6.1.4(1))";
}

pub relation bound_to_perform_first(o: Obligation) kind institutional {
    label en official "the party whose performance requires a period of time is bound to render its performance first (article 6.1.4(2))";
}

@source(PICC_ART6_1_4_EN, PICC_ART6_1_4_FR)
rule SimultaneousPerformance(c: Contract) defeasible {
    label en official "Article 6.1.4(1). To the extent that the performances can be rendered simultaneously, the parties are bound to render them simultaneously unless the circumstances indicate otherwise";
    when performances_can_be_simultaneous(c);
    then bound_to_perform_simultaneously(c);
    unless performances_can_be_simultaneous(c)
        and circumstances_indicate_other_order(c);
}

@source(PICC_ART6_1_4_EN, PICC_ART6_1_4_FR)
rule LongerPerformanceGoesFirst(o: Obligation, c: Contract, p: Party) defeasible {
    label en official "Article 6.1.4(2). To the extent that the performance of only one party requires a period of time, that party is bound to render its performance first, unless the circumstances indicate otherwise";
    when obligation_of(o, c, p)
        and performance_requires_period(o);
    then bound_to_perform_first(o);
    unless obligation_of(o, c, p)
        and circumstances_indicate_other_order(c);
}

// --- Article 6.1.6: place of performance --------------------------------------

pub relation place_of_performance_fixed(o: Obligation) kind empirical {
    label en official "the place of performance is fixed by, or determinable from, the contract";
}

pub relation monetary_obligation(o: Obligation) kind empirical {
    label en official "the obligation is a monetary one";
}

pub relation place_of_business_changed_after_conclusion(o: Obligation) kind empirical {
    label en official "the party's place of business changed subsequent to the conclusion of the contract and that change increased the expenses incidental to performance";
}

pub relation performed_at_obligee_place(o: Obligation) kind institutional {
    label en official "a monetary obligation is to be performed at the obligee's place of business (article 6.1.6(1)(a))";
}

pub relation performed_at_obligor_place(o: Obligation) kind institutional {
    label en official "any other obligation is to be performed at the obligor's own place of business (article 6.1.6(1)(b))";
}

pub relation increase_in_expenses_borne_by_party(o: Obligation) kind institutional {
    label en official "the party must bear any increase in the expenses incidental to performance caused by the change in its place of business (article 6.1.6(2))";
}

@source(PICC_ART6_1_6_EN, PICC_ART6_1_6_FR)
rule MonetaryObligationAtObligeePlace(o: Obligation) defeasible {
    label en official "Article 6.1.6(1)(a). If the place of performance is neither fixed by nor determinable from the contract, a monetary obligation is to be performed at the obligee's place of business";
    when monetary_obligation(o)
        and not_known(place_of_performance_fixed(o));
    then performed_at_obligee_place(o);
}

@source(PICC_ART6_1_6_EN, PICC_ART6_1_6_FR)
rule OtherObligationAtObligorPlace(o: Obligation, c: Contract, p: Party) defeasible {
    label en official "Article 6.1.6(1)(b). If the place of performance is neither fixed by nor determinable from the contract, any other obligation is to be performed at the obligor's own place of business";
    when obligation_of(o, c, p)
        and not_known(monetary_obligation(o))
        and not_known(place_of_performance_fixed(o));
    then performed_at_obligor_place(o);
}

@source(PICC_ART6_1_6_EN, PICC_ART6_1_6_FR)
rule IncreasedExpensesOfMoving(o: Obligation) strict {
    label en official "Article 6.1.6(2). A party must bear any increase in the expenses incidental to performance which is caused by a change in its place of business subsequent to the conclusion of the contract";
    when place_of_business_changed_after_conclusion(o);
    then increase_in_expenses_borne_by_party(o);
}

// --- Articles 6.1.7 and 6.1.8: form of payment and transfer of funds ----------

pub relation payment_of(pay: Payment, o: Obligation) kind empirical {
    label en official "the payment is tendered under that monetary obligation";
}

pub relation form_used_in_ordinary_course(pay: Payment) kind empirical {
    label en official "the form of payment is one used in the ordinary course of business at the place for payment";
}

pub relation instrument_accepted_by_obligee(pay: Payment) kind empirical {
    label en official "the obligee accepted a cheque, another order to pay or a promise to pay";
}

pub relation instrument_honoured(pay: Payment) kind empirical {
    label en official "the instrument has been honoured";
}

pub relation transfer_to_institution_effective(pay: Payment) kind empirical {
    label en official "the transfer to the obligee's financial institution has become effective";
}

pub relation account_indicated_by_obligee(pay: Payment) kind empirical {
    label en official "the obligee has indicated a particular account";
}

pub relation institution_made_known_by_obligee(pay: Payment) kind empirical {
    label en official "the obligee has made it known that it has an account in that financial institution";
}

pub relation payment_may_be_made_in_this_form(pay: Payment) kind institutional {
    label en official "payment may be made in that form (articles 6.1.7(1), 6.1.8(1))";
}

pub relation acceptance_conditional_on_honour(pay: Payment) kind institutional {
    label en official "the obligee is presumed to accept the instrument only on condition that it will be honoured (article 6.1.7(2))";
}

pub relation obligation_discharged(o: Obligation) kind institutional {
    label en official "the obligation of the obligor is discharged (article 6.1.8(2))";
}

@source(PICC_ART6_1_7_EN, PICC_ART6_1_7_FR)
rule PaymentInOrdinaryForm(pay: Payment, o: Obligation) strict {
    label en official "Article 6.1.7(1). Payment may be made in any form used in the ordinary course of business at the place for payment";
    when payment_of(pay, o)
        and form_used_in_ordinary_course(pay);
    then payment_may_be_made_in_this_form(pay);
}

@source(PICC_ART6_1_7_EN, PICC_ART6_1_7_FR)
rule InstrumentAcceptedOnConditionOfHonour(pay: Payment, o: Obligation) strict {
    label en official "Article 6.1.7(2). An obligee who accepts a cheque, any other order to pay or a promise to pay is presumed to do so only on condition that it will be honoured";
    when payment_of(pay, o)
        and instrument_accepted_by_obligee(pay);
    then acceptance_conditional_on_honour(pay);
}

@source(PICC_ART6_1_8_EN, PICC_ART6_1_8_FR)
rule PaymentByTransferToKnownInstitution(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.8(1). Unless the obligee has indicated a particular account, payment may be made by a transfer to any of the financial institutions in which the obligee has made it known that it has an account";
    when payment_of(pay, o)
        and institution_made_known_by_obligee(pay)
        and not_known(account_indicated_by_obligee(pay));
    then payment_may_be_made_in_this_form(pay);
}

@source(PICC_ART6_1_8_EN, PICC_ART6_1_8_FR)
rule TransferDischargesObligation(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.8(2). In case of payment by a transfer the obligation of the obligor is discharged when the transfer to the obligee's financial institution becomes effective";
    when payment_of(pay, o)
        and transfer_to_institution_effective(pay);
    then obligation_discharged(o);
}

// --- Articles 6.1.9-6.1.11: currency of payment and costs of performance ------

pub relation expressed_in_foreign_currency(o: Obligation) kind empirical {
    label en official "the monetary obligation is expressed in a currency other than that of the place for payment";
}

pub relation currency_not_freely_convertible(o: Obligation) kind empirical {
    label en official "the currency of the place for payment is not freely convertible";
}

pub relation parties_agreed_on_currency_of_expression(o: Obligation) kind empirical {
    label en official "the parties have agreed that payment should be made only in the currency in which the monetary obligation is expressed";
}

pub relation payment_in_currency_of_expression_impossible(o: Obligation) kind empirical {
    label en official "it is impossible for the obligor to make payment in the currency in which the monetary obligation is expressed";
}

pub relation currency_not_expressed(o: Obligation) kind empirical {
    label en official "the monetary obligation is not expressed in a particular currency";
}

pub relation obligor_did_not_pay_when_due(o: Obligation) kind empirical {
    label en official "the obligor has not paid at the time when payment is due";
}

pub relation costs_of_performance_incurred(o: Obligation) kind empirical {
    label en official "costs of performance of the obligation have been incurred";
}

pub relation may_pay_in_currency_of_place(o: Obligation) kind institutional {
    label en official "the obligor may pay in the currency of the place for payment (article 6.1.9(1))";
}

pub relation obligee_may_require_currency_of_place(o: Obligation) kind institutional {
    label en official "the obligee may require payment in the currency of the place for payment (article 6.1.9(2))";
}

pub relation rate_prevailing_when_due_applies(o: Obligation) kind institutional {
    label en official "payment is to be made according to the applicable rate of exchange prevailing at the place for payment when payment is due (article 6.1.9(3))";
}

pub relation obligee_may_choose_rate(o: Obligation) kind institutional {
    label en official "the obligee may require payment according to the rate prevailing either when payment is due or at the time of actual payment (article 6.1.9(4))";
}

pub relation payment_in_currency_of_place_required(o: Obligation) kind institutional {
    label en official "payment must be made in the currency of the place where payment is to be made (article 6.1.10)";
}

pub relation costs_borne_by_performing_party(o: Obligation) kind institutional {
    label en official "each party bears the costs of performance of its own obligations (article 6.1.11)";
}

@source(PICC_ART6_1_9_EN, PICC_ART6_1_9_FR)
rule PaymentInCurrencyOfPlace(o: Obligation) defeasible {
    label en official "Article 6.1.9(1). If a monetary obligation is expressed in a currency other than that of the place for payment, it may be paid in the currency of the place for payment";
    when expressed_in_foreign_currency(o)
        and not_known(currency_not_freely_convertible(o))
        and not_known(parties_agreed_on_currency_of_expression(o));
    then may_pay_in_currency_of_place(o);
}

@source(PICC_ART6_1_9_EN, PICC_ART6_1_9_FR)
rule ObligeeMayRequireCurrencyOfPlace(o: Obligation) strict {
    label en official "Article 6.1.9(2). If it is impossible for the obligor to pay in the currency of expression, the obligee may require payment in the currency of the place for payment, even where the parties agreed otherwise";
    when payment_in_currency_of_expression_impossible(o);
    then obligee_may_require_currency_of_place(o);
}

@source(PICC_ART6_1_9_EN, PICC_ART6_1_9_FR)
rule RatePrevailingWhenDue(o: Obligation) defeasible {
    label en official "Article 6.1.9(3). Payment in the currency of the place for payment is to be made according to the applicable rate of exchange prevailing there when payment is due";
    when may_pay_in_currency_of_place(o);
    then rate_prevailing_when_due_applies(o);
}

@source(PICC_ART6_1_9_EN, PICC_ART6_1_9_FR)
rule ObligeeChoosesRateAfterDefault(o: Obligation) strict {
    label en official "Article 6.1.9(4). If the obligor has not paid when payment is due, the obligee may require payment according to the rate prevailing either when payment is due or at the time of actual payment";
    when obligor_did_not_pay_when_due(o);
    then obligee_may_choose_rate(o);
}

@source(PICC_ART6_1_10_EN, PICC_ART6_1_10_FR)
rule CurrencyNotExpressed(o: Obligation) strict {
    label en official "Article 6.1.10. Where a monetary obligation is not expressed in a particular currency, payment must be made in the currency of the place where payment is to be made";
    when currency_not_expressed(o);
    then payment_in_currency_of_place_required(o);
}

@source(PICC_ART6_1_11_EN, PICC_ART6_1_11_FR)
rule EachPartyBearsItsCosts(o: Obligation) strict {
    label en official "Article 6.1.11. Each party shall bear the costs of performance of its obligations";
    when costs_of_performance_incurred(o);
    then costs_borne_by_performing_party(o);
}

// --- Articles 6.1.12 and 6.1.13: imputation of payments -----------------------
//
// THE ORDER WITHIN A SINGLE PAYMENT IS NAMED BY THE SOURCE ITSELF: expenses,
// then interest, then principal — and it applies EVEN WHERE THE OBLIGOR GIVES
// AN INDICATION. The sequence of criteria in paragraph 3 is four distinct heads
// rather than one with provisos; their mutual displacement is declared by §116
// priorities.

pub relation several_obligations_to_same_obligee(pay: Payment, o: Obligation) kind empirical {
    label en official "the obligor owes several monetary obligations to the same obligee and this is one of them";
}

pub relation obligor_specified_obligation(pay: Payment, o: Obligation) kind empirical {
    label en official "the obligor specified at the time of payment the debt to which it intends the payment to be applied";
}

pub relation obligee_declared_imputation(pay: Payment, o: Obligation) kind empirical {
    label en official "the obligee declared to the obligor, within a reasonable time after payment, the obligation to which it imputes the payment";
}

pub relation obligation_due_and_undisputed(o: Obligation) kind empirical {
    label en official "the obligation is due and undisputed";
}

pub relation obligation_is_expenses(o: Obligation) kind empirical {
    label en official "the obligation is one for expenses";
}

pub relation obligation_is_interest(o: Obligation) kind empirical {
    label en official "the obligation is one for interest due";
}

pub relation obligation_first_to_fall_due(o: Obligation) kind empirical {
    label en official "the obligation is due or is the first to fall due";
}

pub relation obligation_with_least_security(o: Obligation) kind empirical {
    label en official "the obligation is the one for which the obligee has least security";
}

pub relation obligation_most_burdensome(o: Obligation) kind empirical {
    label en official "the obligation is the most burdensome for the obligor";
}

pub relation obligation_arisen_first(o: Obligation) kind empirical {
    label en official "the obligation has arisen first";
}

pub relation non_monetary_imputation(pay: Payment, o: Obligation) kind empirical {
    label en official "the imputation concerns the performance of non-monetary obligations";
}

pub relation payment_imputed_to(pay: Payment, o: Obligation) kind institutional {
    label en official "the payment is imputed to that obligation (articles 6.1.12, 6.1.13)";
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ExpensesDischargedFirst(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(1). The payment discharges first any expenses";
    when several_obligations_to_same_obligee(pay, o)
        and obligation_is_expenses(o);
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule InterestDischargedSecond(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(1). The payment discharges then interest due and finally the principal";
    when several_obligations_to_same_obligee(pay, o)
        and obligation_is_interest(o);
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ImputationBySpecification(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(1). An obligor owing several monetary obligations may specify at the time of payment the debt to which the payment is to be applied";
    when several_obligations_to_same_obligee(pay, o)
        and obligor_specified_obligation(pay, o);
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ImputationByObligeeDeclaration(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(2). If the obligor makes no specification, the obligee may within a reasonable time declare the obligation to which it imputes the payment, provided that obligation is due and undisputed";
    when several_obligations_to_same_obligee(pay, o)
        and obligee_declared_imputation(pay, o)
        and obligation_due_and_undisputed(o)
        and not_known(obligor_specified_obligation(pay, o));
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ImputationByFirstDue(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(3)(a). In the absence of imputation, payment is imputed to an obligation which is due or which is the first to fall due";
    when several_obligations_to_same_obligee(pay, o)
        and obligation_first_to_fall_due(o)
        and not_known(obligor_specified_obligation(pay, o))
        and not_known(obligee_declared_imputation(pay, o));
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ImputationByLeastSecurity(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(3)(b). Failing that, payment is imputed to the obligation for which the obligee has least security";
    when several_obligations_to_same_obligee(pay, o)
        and obligation_with_least_security(o)
        and not_known(obligor_specified_obligation(pay, o))
        and not_known(obligee_declared_imputation(pay, o));
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ImputationByMostBurdensome(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(3)(c). Failing that, payment is imputed to the obligation which is the most burdensome for the obligor";
    when several_obligations_to_same_obligee(pay, o)
        and obligation_most_burdensome(o)
        and not_known(obligor_specified_obligation(pay, o))
        and not_known(obligee_declared_imputation(pay, o));
    then payment_imputed_to(pay, o);
}

@source(PICC_ART6_1_12_EN, PICC_ART6_1_12_FR)
rule ImputationByEarliestOrigin(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.12(3)(d). Failing that, payment is imputed to the obligation which has arisen first";
    when several_obligations_to_same_obligee(pay, o)
        and obligation_arisen_first(o)
        and not_known(obligor_specified_obligation(pay, o))
        and not_known(obligee_declared_imputation(pay, o));
    then payment_imputed_to(pay, o);
}

priority ExpensesBeforeSpecification {
    prefer ExpensesDischargedFirst over ImputationBySpecification;
    reason lex_specialis;
}

priority InterestBeforeSpecification {
    prefer InterestDischargedSecond over ImputationBySpecification;
    reason lex_specialis;
}

priority SpecificationBeforeFirstDue {
    prefer ImputationBySpecification over ImputationByFirstDue;
    reason lex_specialis;
}

priority FirstDueBeforeLeastSecurity {
    prefer ImputationByFirstDue over ImputationByLeastSecurity;
    reason lex_specialis;
}

priority LeastSecurityBeforeMostBurdensome {
    prefer ImputationByLeastSecurity over ImputationByMostBurdensome;
    reason lex_specialis;
}

priority MostBurdensomeBeforeEarliestOrigin {
    prefer ImputationByMostBurdensome over ImputationByEarliestOrigin;
    reason lex_specialis;
}

@source(PICC_ART6_1_13_EN, PICC_ART6_1_13_FR)
rule ImputationOfNonMonetaryPerformance(pay: Payment, o: Obligation) defeasible {
    label en official "Article 6.1.13. Article 6.1.12 applies with appropriate adaptations to the imputation of performance of non-monetary obligations";
    when non_monetary_imputation(pay, o)
        and obligation_first_to_fall_due(o);
    then payment_imputed_to(pay, o);
}

// --- Articles 6.1.14-6.1.17: public permission --------------------------------

pub relation permission_required_by_law(perm: Permission, c: Contract) kind empirical {
    label en official "the law of a State requires a public permission affecting the validity of the contract or its performance";
}

pub relation only_one_party_in_that_state(perm: Permission, p: Party) kind empirical {
    label en official "only one party has its place of business in that State";
}

pub relation performance_requires_permission(perm: Permission, p: Party) kind empirical {
    label en official "the party whose performance requires the permission";
}

pub relation law_or_circumstances_indicate_otherwise(perm: Permission) kind empirical {
    label en official "that law or the circumstances indicate otherwise";
}

pub relation measures_taken_without_undue_delay(perm: Permission) kind empirical {
    label en official "the party required to take the measures did so without undue delay";
}

pub relation permission_neither_granted_nor_refused(perm: Permission) kind empirical {
    label en official "permission is neither granted nor refused within an agreed period or, where none is agreed, within a reasonable time from the conclusion of the contract";
}

pub relation permission_refused(perm: Permission) kind empirical {
    label en official "the permission has been refused";
}

pub relation permission_affects_some_terms_only(perm: Permission, t: Term) kind empirical {
    label en official "the permission affects some terms only";
}

pub external judgment relation reasonable_to_uphold_remaining_contract(perm: Permission, c: Contract) {
    authority Tribunal;
    label en official "having regard to the circumstances, it is reasonable to uphold the remaining contract";
}

pub relation refusal_makes_performance_impossible(perm: Permission, c: Contract) kind empirical {
    label en official "the refusal of the permission renders the performance of the contract impossible in whole or in part";
}

pub relation must_take_measures_for_permission(perm: Permission, p: Party) kind institutional {
    label en official "that party shall take the measures necessary to obtain the permission (article 6.1.14)";
}

pub relation must_bear_permission_expenses(perm: Permission, p: Party) kind institutional {
    label en official "the party required to take the measures shall act without undue delay and bear any expenses incurred (article 6.1.15(1))";
}

pub relation must_notify_of_outcome(perm: Permission, p: Party) kind institutional {
    label en official "that party shall whenever appropriate give the other party notice of the grant or refusal of the permission without undue delay (article 6.1.15(2))";
}

pub relation either_party_may_terminate(perm: Permission, c: Contract) kind institutional {
    label en official "either party is entitled to terminate the contract (article 6.1.16(1))";
}

pub relation contract_void_for_refusal(perm: Permission, c: Contract) kind institutional {
    label en official "the refusal of a permission affecting the validity of the contract renders the contract void (article 6.1.17(1))";
}

pub relation only_terms_void(perm: Permission, t: Term) kind institutional {
    label en official "only such terms are void where the refusal affects the validity of some terms only and it is reasonable to uphold the remaining contract (article 6.1.17(1))";
}

pub relation rules_on_non_performance_apply(perm: Permission, c: Contract) kind institutional {
    label en official "the rules on non-performance apply (article 6.1.17(2))";
}

@source(PICC_ART6_1_14_EN, PICC_ART6_1_14_FR)
rule SolePartyInStateAppliesForPermission(perm: Permission, c: Contract, p: Party) defeasible {
    label en official "Article 6.1.14(a). If only one party has its place of business in that State, that party shall take the measures necessary to obtain the permission";
    when permission_required_by_law(perm, c)
        and only_one_party_in_that_state(perm, p)
        and not_known(law_or_circumstances_indicate_otherwise(perm));
    then must_take_measures_for_permission(perm, p);
}

@source(PICC_ART6_1_14_EN, PICC_ART6_1_14_FR)
rule PartyWhosePerformanceNeedsPermission(perm: Permission, c: Contract, p: Party) defeasible {
    label en official "Article 6.1.14(b). In any other case the party whose performance requires permission shall take the necessary measures";
    when permission_required_by_law(perm, c)
        and performance_requires_permission(perm, p)
        and not_known(only_one_party_in_that_state(perm, p))
        and not_known(law_or_circumstances_indicate_otherwise(perm));
    then must_take_measures_for_permission(perm, p);
}

@source(PICC_ART6_1_15_EN, PICC_ART6_1_15_FR)
rule ExpensesAndDiligenceOfApplicant(perm: Permission, p: Party) defeasible {
    label en official "Article 6.1.15(1). The party required to take the measures shall do so without undue delay and shall bear any expenses incurred";
    when must_take_measures_for_permission(perm, p);
    then must_bear_permission_expenses(perm, p);
}

@source(PICC_ART6_1_15_EN, PICC_ART6_1_15_FR)
rule NoticeOfGrantOrRefusal(perm: Permission, p: Party) defeasible {
    label en official "Article 6.1.15(2). That party shall whenever appropriate give the other party notice of the grant or refusal of such permission without undue delay";
    when must_take_measures_for_permission(perm, p);
    then must_notify_of_outcome(perm, p);
}

@source(PICC_ART6_1_16_EN, PICC_ART6_1_16_FR)
rule TerminationWhenPermissionSilent(perm: Permission, c: Contract, t: Term) defeasible {
    label en official "Article 6.1.16(1). If permission is neither granted nor refused within the agreed or a reasonable period although all required measures were taken, either party is entitled to terminate the contract";
    when permission_required_by_law(perm, c)
        and measures_taken_without_undue_delay(perm)
        and permission_neither_granted_nor_refused(perm);
    then either_party_may_terminate(perm, c);
    // Paragraph 2: where the permission affects some terms only, there is no
    // termination if it is reasonable to uphold the remaining contract.
    unless permission_affects_some_terms_only(perm, t)
        and reasonable_to_uphold_remaining_contract(perm, c);
}

@source(PICC_ART6_1_17_EN, PICC_ART6_1_17_FR)
rule RefusalMakesContractVoid(perm: Permission, c: Contract, t: Term) defeasible {
    label en official "Article 6.1.17(1). The refusal of a permission affecting the validity of the contract renders the contract void";
    when permission_required_by_law(perm, c)
        and permission_refused(perm);
    then contract_void_for_refusal(perm, c);
    unless permission_affects_some_terms_only(perm, t)
        and reasonable_to_uphold_remaining_contract(perm, c);
}

@source(PICC_ART6_1_17_EN, PICC_ART6_1_17_FR)
rule OnlyAffectedTermsVoid(perm: Permission, c: Contract, t: Term) defeasible {
    label en official "Article 6.1.17(1). If the refusal affects the validity of some terms only, only such terms are void where it is reasonable to uphold the remaining contract";
    when permission_refused(perm)
        and permission_affects_some_terms_only(perm, t)
        and reasonable_to_uphold_remaining_contract(perm, c);
    then only_terms_void(perm, t);
}

@source(PICC_ART6_1_17_EN, PICC_ART6_1_17_FR)
rule RefusalLeadsToNonPerformanceRules(perm: Permission, c: Contract) strict {
    label en official "Article 6.1.17(2). Where the refusal of a permission renders performance impossible in whole or in part, the rules on non-performance apply";
    when refusal_makes_performance_impossible(perm, c);
    then rules_on_non_performance_apply(perm, c);
}
