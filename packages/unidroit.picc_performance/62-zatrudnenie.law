// Статьи 6.2.1-6.2.3. Затруднения (hardship).
//
// ЭТО ГЛАВНОЕ, ЧЕГО У КОНВЕНЦИИ НЕТ. Статья 79 Конвенции освобождает от
// ОТВЕТСТВЕННОСТИ при препятствии вне контроля, но договор остаётся как есть:
// ни пересмотра, ни адаптации она не знает. Статьи 6.2.2 и 6.2.3 дают право
// требовать пересмотра и власть суда прекратить или адаптировать договор.
// Сравнение наблюдается делом, а не объявляется комментарием.
//
// ДОГОВОР СОБЛЮДАЕТСЯ И ПРИ УДОРОЖАНИИ (ст. 6.2.1): удорожание само по себе
// от исполнения не освобождает. Поэтому «обязан исполнять» — строгая голова,
// а затруднение — отдельный состав с четырьмя условиями пункта 2.

language "law.core" version "0.2";
package unidroit.picc_performance version "0.1.0";
namespace "urn:org:unidroit:clir:picc-performance";

pub relation performance_became_more_onerous(c: Contract, p: Party) kind empirical {
    label en official "the performance of the contract has become more onerous for one of the parties";
    label ru unofficial "исполнение договора стало более обременительным для одной из сторон";
}

pub relation bound_to_perform_nevertheless(c: Contract, p: Party) kind institutional {
    label en official "that party is nevertheless bound to perform its obligations, subject to the provisions on hardship (article 6.2.1)";
    label ru unofficial "эта сторона тем не менее обязана исполнять свои обязательства с учётом положений о затруднениях (статья 6.2.1)";
}

@source(PICC_ART6_2_1_EN, PICC_ART6_2_1_RU)
rule ContractToBeObserved(c: Contract, p: Party) strict {
    label en official "Article 6.2.1. Where the performance of a contract becomes more onerous for one of the parties, that party is nevertheless bound to perform its obligations subject to the following provisions on hardship";
    label ru unofficial "Статья 6.2.1. Если исполнение договора становится более обременительным для одной из сторон, эта сторона тем не менее обязана исполнять свои обязательства с учётом следующих положений о затруднениях";
    when performance_became_more_onerous(c, p);
    then bound_to_perform_nevertheless(c, p);
}

// --- Статья 6.2.2: состав затруднения --------------------------------------------

pub external judgment relation equilibrium_fundamentally_altered(c: Contract, p: Party) {
    authority Tribunal;
    label en official "the occurrence of events fundamentally alters the equilibrium of the contract, either because the cost of a party's performance has increased or because the value of the performance a party receives has diminished";
    label ru unofficial "наступление событий существенно изменяет равновесие договора — из-за возросшей стоимости исполнения стороны либо из-за уменьшившейся ценности получаемого ею исполнения";
}

pub relation events_after_conclusion_or_later_known(c: Contract, p: Party) kind empirical {
    label en official "the events occur or become known to the disadvantaged party after the conclusion of the contract";
    label ru unofficial "события наступают или становятся известны потерпевшей стороне после заключения договора";
}

pub external judgment relation events_could_not_be_taken_into_account(c: Contract, p: Party) {
    authority Tribunal;
    label en official "the events could not reasonably have been taken into account by the disadvantaged party at the time of the conclusion of the contract";
    label ru unofficial "события не могли быть разумно учтены потерпевшей стороной при заключении договора";
}

pub relation events_beyond_control(c: Contract, p: Party) kind empirical {
    label en official "the events are beyond the control of the disadvantaged party";
    label ru unofficial "события находятся вне контроля потерпевшей стороны";
}

pub relation risk_of_events_assumed(c: Contract, p: Party) kind empirical {
    label en official "the risk of the events was assumed by the disadvantaged party";
    label ru unofficial "риск событий был принят потерпевшей стороной";
}

pub relation hardship_exists(c: Contract, p: Party) kind institutional {
    label en official "there is hardship (article 6.2.2)";
    label ru unofficial "имеет место затруднение (статья 6.2.2)";
}

@source(PICC_ART6_2_2_EN, PICC_ART6_2_2_RU)
rule HardshipExists(c: Contract, p: Party) defeasible {
    label en official "Article 6.2.2. There is hardship where events fundamentally alter the equilibrium of the contract and the four conditions (a) to (d) are met";
    label ru unofficial "Статья 6.2.2. Затруднение имеет место, если события существенно изменяют равновесие договора и соблюдены четыре условия подпунктов a-d";
    when performance_became_more_onerous(c, p)
        and equilibrium_fundamentally_altered(c, p)
        and events_after_conclusion_or_later_known(c, p)
        and events_could_not_be_taken_into_account(c, p)
        and events_beyond_control(c, p)
        and not_known(risk_of_events_assumed(c, p));
    then hardship_exists(c, p);
}

// --- Статья 6.2.3: последствия затруднения ----------------------------------------

pub relation renegotiation_requested_without_undue_delay(c: Contract, p: Party) kind empirical {
    label en official "the request for renegotiation was made without undue delay and indicates the grounds on which it is based";
    label ru unofficial "просьба о пересмотре заявлена без неоправданной задержки и указывает основания, на которых она заявлена";
}

pub relation performance_withheld(c: Contract, p: Party) kind empirical {
    label en official "the disadvantaged party withholds performance";
    label ru unofficial "потерпевшая сторона приостанавливает исполнение";
}

pub relation no_agreement_within_reasonable_time(c: Contract) kind empirical {
    label en official "the parties failed to reach agreement within a reasonable time after the request for renegotiation";
    label ru unofficial "стороны не достигли соглашения в разумный срок после просьбы о пересмотре";
}

pub external judgment relation termination_or_adaptation_reasonable(c: Contract) {
    authority Tribunal;
    label en official "termination of the contract, or its adaptation with a view to restoring its equilibrium, is reasonable";
    label ru unofficial "прекращение договора или его адаптация с целью восстановления равновесия разумны";
}

pub relation entitled_to_request_renegotiation(c: Contract, p: Party) kind institutional {
    label en official "the disadvantaged party is entitled to request renegotiations (article 6.2.3(1))";
    label ru unofficial "потерпевшая сторона вправе требовать пересмотра договора (статья 6.2.3 пункт 1)";
}

pub relation request_does_not_entitle_to_withhold(c: Contract, p: Party) kind institutional {
    label en official "the request for renegotiation does not in itself entitle the disadvantaged party to withhold performance (article 6.2.3(2))";
    label ru unofficial "просьба о пересмотре сама по себе не даёт потерпевшей стороне права приостановить исполнение (статья 6.2.3 пункт 2)";
}

pub relation may_resort_to_court(c: Contract, p: Party) kind institutional {
    label en official "either party may resort to the court (article 6.2.3(3))";
    label ru unofficial "каждая из сторон может обратиться в суд (статья 6.2.3 пункт 3)";
}

pub relation contract_terminated_by_court(c: Contract) kind institutional {
    label en official "the court terminates the contract at a date and on terms to be fixed (article 6.2.3(4)(a))";
    label ru unofficial "суд прекращает договор с даты и на условиях, которые он определит (статья 6.2.3 пункт 4 подпункт a)";
}

pub relation contract_adapted_by_court(c: Contract) kind institutional {
    label en official "the court adapts the contract with a view to restoring its equilibrium (article 6.2.3(4)(b))";
    label ru unofficial "суд адаптирует договор с целью восстановления его равновесия (статья 6.2.3 пункт 4 подпункт b)";
}

pub relation court_terminated(c: Contract) kind empirical {
    label en official "the court has ordered termination of the contract";
    label ru unofficial "суд вынес решение о прекращении договора";
}

pub relation court_adapted(c: Contract) kind empirical {
    label en official "the court has ordered adaptation of the contract";
    label ru unofficial "суд вынес решение об адаптации договора";
}

@source(PICC_ART6_2_3_EN, PICC_ART6_2_3_RU)
rule RenegotiationMayBeRequested(c: Contract, p: Party) defeasible {
    label en official "Article 6.2.3(1). In case of hardship the disadvantaged party is entitled to request renegotiations; the request shall be made without undue delay and indicate the grounds on which it is based";
    label ru unofficial "Статья 6.2.3 пункт 1. При затруднении потерпевшая сторона вправе требовать пересмотра договора; просьба заявляется без неоправданной задержки и указывает основания";
    when hardship_exists(c, p)
        and renegotiation_requested_without_undue_delay(c, p);
    then entitled_to_request_renegotiation(c, p);
}

@source(PICC_ART6_2_3_EN, PICC_ART6_2_3_RU)
rule RequestDoesNotSuspendPerformance(c: Contract, p: Party) defeasible {
    label en official "Article 6.2.3(2). The request for renegotiation does not in itself entitle the disadvantaged party to withhold performance";
    label ru unofficial "Статья 6.2.3 пункт 2. Просьба о пересмотре сама по себе не даёт права приостановить исполнение";
    when entitled_to_request_renegotiation(c, p);
    then request_does_not_entitle_to_withhold(c, p);
}

@source(PICC_ART6_2_3_EN, PICC_ART6_2_3_RU)
rule ResortToCourtOnFailure(c: Contract, p: Party) defeasible {
    label en official "Article 6.2.3(3). Upon failure to reach agreement within a reasonable time either party may resort to the court";
    label ru unofficial "Статья 6.2.3 пункт 3. При недостижении соглашения в разумный срок каждая из сторон может обратиться в суд";
    when entitled_to_request_renegotiation(c, p)
        and no_agreement_within_reasonable_time(c);
    then may_resort_to_court(c, p);
}

@source(PICC_ART6_2_3_EN, PICC_ART6_2_3_RU)
rule CourtPowerOnHardship(c: Contract, p: Party) strict {
    label en official "Article 6.2.3(4). If the court finds hardship it may, if reasonable, terminate the contract at a date and on terms to be fixed, or adapt the contract with a view to restoring its equilibrium";
    label ru unofficial "Статья 6.2.3 пункт 4. Если суд устанавливает затруднение, он может, если это разумно, прекратить договор с даты и на условиях, которые определит, либо адаптировать договор для восстановления его равновесия";
    when may_resort_to_court(c, p);
    then power AdaptOrTerminateForHardship {
        holder Tribunal;
        over c;
        exercise court_adapted(c);
        valid_when termination_or_adaptation_reasonable(c);
        effect create(contract_adapted_by_court(c));
    };
}

@source(PICC_ART6_2_3_EN, PICC_ART6_2_3_RU)
rule CourtTerminatesForHardship(c: Contract, p: Party) defeasible {
    label en official "Article 6.2.3(4)(a). The court may terminate the contract at a date and on terms to be fixed";
    label ru unofficial "Статья 6.2.3 пункт 4 подпункт a. Суд может прекратить договор с даты и на условиях, которые он определит";
    when may_resort_to_court(c, p)
        and termination_or_adaptation_reasonable(c)
        and court_terminated(c);
    then contract_terminated_by_court(c);
}

@source(PICC_ART6_2_3_EN, PICC_ART6_2_3_RU)
rule CourtAdaptsForHardship(c: Contract, p: Party) defeasible {
    label en official "Article 6.2.3(4)(b). The court may adapt the contract with a view to restoring its equilibrium";
    label ru unofficial "Статья 6.2.3 пункт 4 подпункт b. Суд может адаптировать договор с целью восстановления его равновесия";
    when may_resort_to_court(c, p)
        and termination_or_adaptation_reasonable(c)
        and court_adapted(c);
    then contract_adapted_by_court(c);
}
