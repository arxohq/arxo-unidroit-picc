language "law.core" version "0.2";
package examples.unidroit.hardship version "0.1.0";
namespace "urn:law:examples:unidroit:hardship";

// Case 1. A supply contract whose equilibrium is destroyed after conclusion.
//
// THE CONTRACT IS TO BE OBSERVED FIRST (article 6.2.1): the increased cost does
// not of itself excuse performance, and the answer to "must I still perform?"
// stays positive throughout the case. Hardship is a separate case with the four
// conditions of article 6.2.2, two of which are evaluative and are answered by
// the organ (the §47.3 channel): whether the equilibrium is fundamentally
// altered, and whether the events could reasonably have been taken into account.
//
// THE COURT'S POWER IS A §127 POWER, NOT A FACT. Article 6.2.3(4) lets the court
// terminate or adapt the contract if that is reasonable; here the court adapts
// it, and the conclusion about adaptation follows from the exercise of that
// power together with the organ's answer on reasonableness.

case HardshipAndAdaptation {
    context {
        legal_time @2026-09-18;
        knowledge_time @2026-09-18T12:00:00Z;
        decision_time @2026-09-18T12:00:00Z;
        timezone "UTC";
    }

    const contract: unidroit.picc::Contract = entity_ref("urn:example:picc:hardship:contract");
    const supplier: unidroit.picc::Party = entity_ref("urn:example:picc:hardship:supplier");

    // Article 6.2.1: performance became more onerous for the supplier.
    assert "onerous": unidroit.picc_performance::performance_became_more_onerous(contract, supplier) { origin case_input; }

    // Article 6.2.2: the four conditions. Two of them are answered by the organ.
    assert "equilibrium": unidroit.picc_performance::equilibrium_fundamentally_altered(contract, supplier) { origin adjudicated; }
    assert "after": unidroit.picc_performance::events_after_conclusion_or_later_known(contract, supplier) { origin case_input; }
    assert "unforeseen": unidroit.picc_performance::events_could_not_be_taken_into_account(contract, supplier) { origin adjudicated; }
    assert "beyond-control": unidroit.picc_performance::events_beyond_control(contract, supplier) { origin case_input; }

    // Article 6.2.3: renegotiation requested in time, no agreement reached.
    assert "renegotiation": unidroit.picc_performance::renegotiation_requested_without_undue_delay(contract, supplier) { origin case_input; }
    assert "no-agreement": unidroit.picc_performance::no_agreement_within_reasonable_time(contract) { origin case_input; }

    // Article 6.2.3(4): the organ finds adaptation reasonable and the court adapts.
    assert "reasonable": unidroit.picc_performance::termination_or_adaptation_reasonable(contract) { origin adjudicated; }
    assert "adapted": unidroit.picc_performance::court_adapted(contract) { origin case_input; }
}
