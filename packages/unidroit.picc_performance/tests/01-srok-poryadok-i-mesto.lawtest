language "law.core" version "0.2";
package unidroit.picc_performance version "0.1.0";
namespace "urn:org:unidroit:clir:picc-performance";

// Дело 1. Срок исполнения (6.1.1), единовременность (6.1.2), частичное и
// досрочное исполнение (6.1.3, 6.1.5), очерёдность (6.1.4) и место (6.1.6).

test "PICCP-01-TIME-ORDER-AND-PLACE" {
    given {
        context {
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": obligation_of(entity_ref("urn:case:piccp:o-fixed"), entity_ref("urn:case:piccp:contract-1"), entity_ref("urn:case:piccp:seller")) { origin case_input; }
        assert "a1": time_fixed_by_contract(entity_ref("urn:case:piccp:o-fixed")) { origin case_input; }
        assert "a2": obligation_of(entity_ref("urn:case:piccp:o-period"), entity_ref("urn:case:piccp:contract-1"), entity_ref("urn:case:piccp:seller")) { origin case_input; }
        assert "a3": period_fixed_by_contract(entity_ref("urn:case:piccp:o-period")) { origin case_input; }
        assert "a4": performance_can_be_rendered_at_one_time(entity_ref("urn:case:piccp:o-period")) { origin case_input; }
        assert "a5": obligation_of(entity_ref("urn:case:piccp:o-open"), entity_ref("urn:case:piccp:contract-1"), entity_ref("urn:case:piccp:buyer")) { origin case_input; }
        assert "a6": obligation_of(entity_ref("urn:case:piccp:o-chosen"), entity_ref("urn:case:piccp:contract-1b"), entity_ref("urn:case:piccp:seller")) { origin case_input; }
        assert "a7": period_fixed_by_contract(entity_ref("urn:case:piccp:o-chosen")) { origin case_input; }
        assert "a8": circumstances_indicate_other_party_chooses(entity_ref("urn:case:piccp:o-chosen")) { origin case_input; }
        assert "a9": offer_to_perform_in_part(entity_ref("urn:case:piccp:o-fixed")) { origin case_input; }
        assert "a10": additional_expenses_caused(entity_ref("urn:case:piccp:o-fixed")) { origin case_input; }
        assert "a11": offer_of_earlier_performance(entity_ref("urn:case:piccp:o-period")) { origin case_input; }
        assert "a12": time_of_own_performance_fixed_independently(entity_ref("urn:case:piccp:o-period")) { origin case_input; }
        assert "a13": offer_of_earlier_performance(entity_ref("urn:case:piccp:o-nointerest")) { origin case_input; }
        assert "a14": obligee_has_no_legitimate_interest(entity_ref("urn:case:piccp:o-nointerest")) { origin adjudicated; }
        assert "a15": performances_can_be_simultaneous(entity_ref("urn:case:piccp:contract-1")) { origin case_input; }
        assert "a16": obligation_of(entity_ref("urn:case:piccp:o-long"), entity_ref("urn:case:piccp:contract-1c"), entity_ref("urn:case:piccp:seller")) { origin case_input; }
        assert "a17": performance_requires_period(entity_ref("urn:case:piccp:o-long")) { origin case_input; }
        assert "a18": monetary_obligation(entity_ref("urn:case:piccp:o-open")) { origin case_input; }
        assert "a19": obligation_of(entity_ref("urn:case:piccp:o-goods"), entity_ref("urn:case:piccp:contract-1"), entity_ref("urn:case:piccp:seller")) { origin case_input; }
        assert "a20": place_of_business_changed_after_conclusion(entity_ref("urn:case:piccp:o-goods")) { origin case_input; }
    }

    evaluate truth(must_perform_at_fixed_time(entity_ref("urn:case:piccp:o-fixed")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(PerformanceAtFixedTime);

    evaluate truth(may_perform_within_period(entity_ref("urn:case:piccp:o-period")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(PerformanceWithinPeriod);

    // Если срок внутри периода выбирает другая сторона, свободы выбора нет.
    evaluate truth(may_perform_within_period(entity_ref("urn:case:piccp:o-chosen")));
    expect truth_status == NEITHER;

    // Срок не назван вовсе — разумный срок после заключения договора.
    evaluate truth(must_perform_within_reasonable_time(entity_ref("urn:case:piccp:o-open")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(PerformanceWithinReasonableTime);

    evaluate truth(must_perform_at_one_time(entity_ref("urn:case:piccp:o-period")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(PerformanceAtOneTime);

    evaluate truth(may_reject_partial_performance(entity_ref("urn:case:piccp:o-fixed")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(RejectionOfPartialPerformance);

    evaluate truth(expenses_borne_by_obligor(entity_ref("urn:case:piccp:o-fixed")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AdditionalExpensesBorneByObligor);

    evaluate truth(may_reject_earlier_performance(entity_ref("urn:case:piccp:o-period")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(RejectionOfEarlierPerformance);

    // Отсутствие законного интереса снимает право отклонить досрочное исполнение.
    evaluate truth(may_reject_earlier_performance(entity_ref("urn:case:piccp:o-nointerest")));
    expect truth_status == NEITHER;

    evaluate truth(own_performance_time_unaffected(entity_ref("urn:case:piccp:o-period")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(EarlierPerformanceDoesNotShiftOwnTime);

    evaluate truth(bound_to_perform_simultaneously(entity_ref("urn:case:piccp:contract-1")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(SimultaneousPerformance);

    evaluate truth(bound_to_perform_first(entity_ref("urn:case:piccp:o-long")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(LongerPerformanceGoesFirst);

    evaluate truth(performed_at_obligee_place(entity_ref("urn:case:piccp:o-open")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(MonetaryObligationAtObligeePlace);

    evaluate truth(performed_at_obligor_place(entity_ref("urn:case:piccp:o-goods")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(OtherObligationAtObligorPlace);

    evaluate truth(increase_in_expenses_borne_by_party(entity_ref("urn:case:piccp:o-goods")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(IncreasedExpensesOfMoving);
}
