// Chapter 3 of the Principles: validity of the contract.
//
// HERE THE CONVENTION IS SILENT BY ITS OWN DECLARATION. Article 4(a) of the
// Convention expressly takes the validity of the contract out of its subject
// matter: "this Convention is not concerned with the validity of the contract
// or of any of its provisions". Chapter 3 of the Principles is what fills that
// gap where the parties or the organ take the Principles; the package therefore
// does not duplicate the Convention but answers where it declines to answer.
//
// THE THREE GROUNDS OF AVOIDANCE ARE SEPARATED BY FACTS, NOT BY PROVISOS:
// mistake (3.2.1-3.2.4), fraud and threat (3.2.5-3.2.6), gross disparity
// (3.2.7). Each has its own head and its own defeating circumstances.
//
// THE CHAPTER IS MANDATORY IN PART (article 3.1.4): the provisions on fraud,
// threat, gross disparity and illegality may not be excluded. This is written
// as a rule rather than a comment, and is observed by case 04.
//
// THE CHAPTER DOES NOT DEAL WITH CAPACITY (article 3.1.1) — a boundary from the text.

language "law.core" version "0.2";
package unidroit.picc_validity version "0.1.0";
namespace "urn:org:unidroit:clir:picc-validity";

import unidroit.picc version "0.1.0";

type Party = unidroit.picc::Party;
type Contract = unidroit.picc::Contract;
type Term = unidroit.picc::Term;
type Organ = unidroit.picc::Organ;

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
};

pub entity Mistake {
    label en official "Mistake";
}

pub entity Declaration {
    label en official "Unilateral communication of intention";
}

pub relation contract_under_consideration(c: Contract) kind empirical {
    label en official "the contract is the one in question before the tribunal";
}
