// Глава 3 Принципов: действительность договора.
//
// ЗДЕСЬ КОНВЕНЦИЯ МОЛЧИТ ПО СОБСТВЕННОМУ ЗАЯВЛЕНИЮ. Статья 4 подпункт a
// Конвенции прямо выводит действительность договора из своего предмета:
// «настоящая Конвенция не касается действительности самого договора или
// каких-либо его положений». Глава 3 Принципов — то, чем этот пробел
// закрывается, когда стороны или орган берут Принципы; поэтому пакет не
// дублирует Конвенцию, а отвечает там, где она отказывается отвечать.
//
// ТРИ ОСНОВАНИЯ ОСПАРИВАНИЯ РАЗВЕДЕНЫ ФАКТАМИ, А НЕ ОГОВОРКАМИ: заблуждение
// (3.2.1-3.2.4), обман и угроза (3.2.5-3.2.6), существенное неравновесие
// (3.2.7). У каждого своя голова и свои поражающие обстоятельства.
//
// ГЛАВА ИМПЕРАТИВНА ЧАСТЬЮ (ст. 3.1.4): положения об обмане, угрозе,
// существенном неравновесии и незаконности исключить нельзя. Это записано
// нормой, а не комментарием, и наблюдается делом 04.
//
// ДЕЕСПОСОБНОСТЬ ГЛАВА НЕ РЕГУЛИРУЕТ (ст. 3.1.1) — граница из текста.

language "law.core" version "0.2";
package unidroit.picc_validity version "0.1.0";
namespace "urn:org:unidroit:clir:picc-validity";

import unidroit.picc version "0.1.0";

type Party = unidroit.picc::Party;
type Contract = unidroit.picc::Contract;
type Term = unidroit.picc::Term;
type Organ = unidroit.picc::Organ;

const Tribunal: Organ = entity_ref("urn:org:unidroit:clir:picc#Tribunal") {
    label en official "the court or arbitral tribunal seised of the dispute (article 1.11)";
    label ru unofficial "суд или арбитраж, рассматривающий спор (статья 1.11)";
};

pub entity Mistake {
    label en official "Mistake";
    label ru unofficial "Заблуждение";
}

pub entity Declaration {
    label en official "Unilateral communication of intention";
    label ru unofficial "Одностороннее сообщение о намерении";
}

pub relation contract_under_consideration(c: Contract) kind empirical {
    label en official "the contract is the one in question before the tribunal";
    label ru unofficial "договор является тем, о котором идёт спор";
}
