// Статьи 3.2.1-3.2.17. Основания оспаривания договора и последствия оспаривания.
//
// ОДНА ГОЛОВА НА ТРИ ОСНОВАНИЯ, НО РАЗНЫЕ ПОСЫЛКИ. Обман (3.2.5), угроза
// (3.2.6) и существенное неравновесие (3.2.7) дают право оспорить договор;
// заблуждение (3.2.2) ведёт к своей голове, потому что его поражают
// собственные обстоятельства — грубая неосторожность, принятый риск и
// доступное средство защиты от неисполнения (3.2.4).
//
// ОЦЕНОЧНЫЕ ПРИЗНАКИ ИДУТ КАНАЛОМ СУЖДЕНИЯ §47.3: существенность заблуждения
// для разумного лица, разумные коммерческие стандарты честной практики,
// неоправданность и серьёзность угрозы, чрезмерность преимущества, разумный
// срок извещения. Модель не решает их сама.

language "law.core" version "0.2";
package unidroit.picc_validity version "0.1.0";
namespace "urn:org:unidroit:clir:picc-validity";

// --- Статьи 3.2.1 и 3.2.3: что является заблуждением ---------------------------

pub relation mistake_of(m: Mistake, c: Contract, p: Party) kind empirical {
    label en official "the assumption is that of the party in relation to the contract";
    label ru unofficial "предположение принадлежит стороне и относится к договору";
}

pub relation erroneous_assumption_about_facts_or_law(m: Mistake) kind empirical {
    label en official "the assumption is erroneous and relates to facts or to law existing when the contract was concluded";
    label ru unofficial "предположение ошибочно и относится к фактам или праву, существовавшим при заключении договора";
}

pub relation error_in_expression_or_transmission(m: Mistake) kind empirical {
    label en official "an error occurred in the expression or transmission of a declaration";
    label ru unofficial "ошибка допущена в выражении или передаче заявления";
}

pub relation is_mistake(m: Mistake) kind institutional {
    label en official "the erroneous assumption is a mistake (article 3.2.1)";
    label ru unofficial "ошибочное предположение является заблуждением (статья 3.2.1)";
}

@source(PICC_ART3_2_1_EN, PICC_ART3_2_1_RU)
rule ErroneousAssumptionIsMistake(m: Mistake, c: Contract, p: Party) defeasible {
    label en official "Article 3.2.1. Mistake is an erroneous assumption relating to facts or to law existing when the contract was concluded";
    label ru unofficial "Статья 3.2.1. Заблуждением является ошибочное предположение, относящееся к фактам или праву, существовавшим при заключении договора";
    when mistake_of(m, c, p)
        and erroneous_assumption_about_facts_or_law(m);
    then is_mistake(m);
}

@source(PICC_ART3_2_3_EN, PICC_ART3_2_3_RU)
rule ErrorInTransmissionIsMistake(m: Mistake, c: Contract, p: Party) defeasible {
    label en official "Article 3.2.3. An error occurring in the expression or transmission of a declaration is considered to be a mistake of the person from whom the declaration emanated";
    label ru unofficial "Статья 3.2.3. Ошибка в выражении или передаче заявления считается заблуждением лица, от которого заявление исходит";
    when mistake_of(m, c, p)
        and error_in_expression_or_transmission(m);
    then is_mistake(m);
}

// --- Статья 3.2.2: относимое заблуждение ---------------------------------------

pub external judgment relation mistake_of_decisive_importance(m: Mistake) {
    authority Tribunal;
    label en official "the mistake was of such importance that a reasonable person in the same situation would only have concluded the contract on materially different terms or would not have concluded it at all";
    label ru unofficial "заблуждение было таким, что разумное лицо в той же ситуации заключило бы договор на существенно иных условиях или не заключило бы вовсе";
}

pub relation other_party_shared_caused_or_knew(m: Mistake) kind empirical {
    label en official "the other party made the same mistake, or caused it, or knew or ought to have known of it";
    label ru unofficial "другая сторона допустила то же заблуждение, вызвала его либо знала или должна была знать о нём";
}

pub external judgment relation contrary_to_fair_dealing_to_leave_in_error(m: Mistake) {
    authority Tribunal;
    label en official "it was contrary to reasonable commercial standards of fair dealing to leave the mistaken party in error";
    label ru unofficial "оставление заблуждающейся стороны в заблуждении противоречило разумным коммерческим стандартам честной деловой практики";
}

pub relation other_party_had_not_relied(m: Mistake) kind empirical {
    label en official "the other party had not at the time of avoidance reasonably acted in reliance on the contract";
    label ru unofficial "другая сторона к моменту оспаривания разумно не действовала, полагаясь на договор";
}

pub relation grossly_negligent_in_committing_mistake(m: Mistake) kind empirical {
    label en official "the mistaken party was grossly negligent in committing the mistake";
    label ru unofficial "заблуждавшаяся сторона допустила заблуждение по грубой неосторожности";
}

pub relation risk_of_mistake_borne_by_party(m: Mistake) kind empirical {
    label en official "the risk of mistake was assumed by, or should be borne by, the mistaken party";
    label ru unofficial "риск заблуждения принят заблуждавшейся стороной или должен лежать на ней";
}

pub relation remedy_for_non_performance_available(m: Mistake) kind empirical {
    label en official "the circumstances relied upon afford, or could have afforded, a remedy for non-performance";
    label ru unofficial "обстоятельства, на которые ссылается сторона, дают или могли дать средство защиты при неисполнении";
}

pub relation may_avoid_for_mistake(m: Mistake, p: Party) kind institutional {
    label en official "the party may avoid the contract for mistake (article 3.2.2)";
    label ru unofficial "сторона может оспорить договор вследствие заблуждения (статья 3.2.2)";
}

@source(PICC_ART3_2_2_EN, PICC_ART3_2_2_RU)
rule AvoidanceForMistakeKnownToOtherParty(m: Mistake, c: Contract, p: Party) defeasible {
    label en official "Article 3.2.2(1)(a). A party may avoid the contract for a mistake of decisive importance where the other party made, caused or knew of the mistake and it was contrary to fair dealing to leave the party in error";
    label ru unofficial "Статья 3.2.2 пункт 1 подпункт a. Сторона может оспорить договор вследствие существенного заблуждения, если другая сторона допустила, вызвала или знала о нём и оставление в заблуждении противоречило честной деловой практике";
    when is_mistake(m)
        and mistake_of(m, c, p)
        and mistake_of_decisive_importance(m)
        and other_party_shared_caused_or_knew(m)
        and contrary_to_fair_dealing_to_leave_in_error(m);
    then may_avoid_for_mistake(m, p);
}

@source(PICC_ART3_2_2_EN, PICC_ART3_2_2_RU)
rule AvoidanceForMistakeWithoutReliance(m: Mistake, c: Contract, p: Party) defeasible {
    label en official "Article 3.2.2(1)(b). A party may avoid the contract for a mistake of decisive importance where the other party had not at the time of avoidance reasonably acted in reliance on the contract";
    label ru unofficial "Статья 3.2.2 пункт 1 подпункт b. Сторона может оспорить договор вследствие существенного заблуждения, если другая сторона к моменту оспаривания разумно не действовала, полагаясь на договор";
    when is_mistake(m)
        and mistake_of(m, c, p)
        and mistake_of_decisive_importance(m)
        and other_party_had_not_relied(m);
    then may_avoid_for_mistake(m, p);
}

@source(PICC_ART3_2_2_EN, PICC_ART3_2_2_RU)
rule GrossNegligenceBarsAvoidance(m: Mistake, c: Contract, p: Party) defeater {
    label en official "Article 3.2.2(2)(a). A party may not avoid the contract if it was grossly negligent in committing the mistake";
    label ru unofficial "Статья 3.2.2 пункт 2 подпункт a. Сторона не может оспорить договор, если допустила заблуждение по грубой неосторожности";
    when mistake_of(m, c, p)
        and grossly_negligent_in_committing_mistake(m);
    defeat may_avoid_for_mistake(m, p);
}

@source(PICC_ART3_2_2_EN, PICC_ART3_2_2_RU)
rule AssumedRiskBarsAvoidance(m: Mistake, c: Contract, p: Party) defeater {
    label en official "Article 3.2.2(2)(b). A party may not avoid the contract where the risk of mistake was assumed or should be borne by it";
    label ru unofficial "Статья 3.2.2 пункт 2 подпункт b. Сторона не может оспорить договор, если риск заблуждения принят ею или должен лежать на ней";
    when mistake_of(m, c, p)
        and risk_of_mistake_borne_by_party(m);
    defeat may_avoid_for_mistake(m, p);
}

@source(PICC_ART3_2_4_EN, PICC_ART3_2_4_RU)
rule RemedyForNonPerformanceBarsAvoidance(m: Mistake, c: Contract, p: Party) defeater {
    label en official "Article 3.2.4. A party is not entitled to avoid the contract on the ground of mistake if the circumstances afford, or could have afforded, a remedy for non-performance";
    label ru unofficial "Статья 3.2.4. Сторона не вправе оспорить договор вследствие заблуждения, если обстоятельства дают или могли дать средство защиты при неисполнении";
    when mistake_of(m, c, p)
        and remedy_for_non_performance_available(m);
    defeat may_avoid_for_mistake(m, p);
}

// --- Статьи 3.2.5-3.2.7: обман, угроза, существенное неравновесие --------------

pub relation fraudulent_representation_or_non_disclosure(c: Contract, p: Party) kind empirical {
    label en official "the party was led to conclude the contract by the other party's fraudulent representation, including language or practices, or fraudulent non-disclosure";
    label ru unofficial "сторона была побуждена к заключению договора обманным заявлением другой стороны, включая слова или действия, либо обманным умолчанием";
}

pub relation threat_made(c: Contract, p: Party) kind empirical {
    label en official "the party was led to conclude the contract by the other party's threat";
    label ru unofficial "сторона была побуждена к заключению договора угрозой другой стороны";
}

pub relation threatened_act_wrongful(c: Contract, p: Party) kind empirical {
    label en official "the act or omission with which the party has been threatened is wrongful in itself, or it is wrongful to use it as a means to obtain the conclusion of the contract";
    label ru unofficial "действие или бездействие, которым угрожали стороне, противоправно само по себе либо противоправно его использование как средства добиться заключения договора";
}

pub external judgment relation threat_imminent_and_serious(c: Contract, p: Party) {
    authority Tribunal;
    label en official "the threat is, having regard to the circumstances, so imminent and serious as to leave the party no reasonable alternative";
    label ru unofficial "угроза с учётом обстоятельств настолько неминуема и серьёзна, что не оставляет стороне разумной альтернативы";
}

pub relation threat_unjustified(c: Contract, p: Party) kind institutional {
    label en official "the threat is unjustified (article 3.2.6)";
    label ru unofficial "угроза является неоправданной (статья 3.2.6)";
}

pub relation excessive_advantage_claimed(c: Contract, p: Party) kind empirical {
    label en official "the contract or an individual term is said to have unjustifiably given the other party an excessive advantage at the time of conclusion";
    label ru unofficial "утверждается, что договор или отдельное условие неоправданно предоставили другой стороне чрезмерное преимущество в момент заключения";
}

pub relation took_unfair_advantage(c: Contract) kind empirical {
    label en official "the other party has taken unfair advantage of the first party's dependence, economic distress, urgent needs, improvidence, ignorance, inexperience or lack of bargaining skill";
    label ru unofficial "другая сторона недобросовестно воспользовалась зависимостью, экономическими трудностями, неотложными нуждами, неопытностью, неосведомлённостью или неумением вести переговоры первой стороны";
}

pub external judgment relation advantage_excessive_and_unjustifiable(c: Contract) {
    authority Tribunal;
    label en official "the contract or term unjustifiably gave the other party an excessive advantage, regard being had among other factors to the taking of unfair advantage and to the nature and purpose of the contract";
    label ru unofficial "договор или условие неоправданно предоставили другой стороне чрезмерное преимущество с учётом, среди прочего, недобросовестного использования положения и природы и цели договора";
}

pub relation may_avoid_contract(c: Contract, p: Party) kind institutional {
    label en official "the party may avoid the contract (articles 3.2.5-3.2.8)";
    label ru unofficial "сторона может оспорить договор (статьи 3.2.5-3.2.8)";
}

pub relation may_avoid_term(t: Term, c: Contract, p: Party) kind institutional {
    label en official "the party may avoid an individual term of the contract (article 3.2.7(1))";
    label ru unofficial "сторона может оспорить отдельное условие договора (статья 3.2.7 пункт 1)";
}

@source(PICC_ART3_2_5_EN, PICC_ART3_2_5_RU)
rule AvoidanceForFraud(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.5. A party may avoid the contract when it has been led to conclude it by the other party's fraudulent representation or fraudulent non-disclosure";
    label ru unofficial "Статья 3.2.5. Сторона может оспорить договор, если была побуждена к его заключению обманным заявлением или обманным умолчанием другой стороны";
    when fraudulent_representation_or_non_disclosure(c, p);
    then may_avoid_contract(c, p);
}

@source(PICC_ART3_2_6_EN, PICC_ART3_2_6_RU)
rule ThreatIsUnjustified(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.6. In particular, a threat is unjustified if the act or omission threatened is wrongful in itself, or it is wrongful to use it as a means to obtain the conclusion of the contract";
    label ru unofficial "Статья 3.2.6. В частности, угроза неоправданна, если действие или бездействие, которым угрожали, противоправно само по себе либо противоправно его использование как средства добиться заключения договора";
    when threat_made(c, p)
        and threatened_act_wrongful(c, p);
    then threat_unjustified(c, p);
}

@source(PICC_ART3_2_6_EN, PICC_ART3_2_6_RU)
rule AvoidanceForThreat(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.6. A party may avoid the contract when it has been led to conclude it by the other party's unjustified threat which is so imminent and serious as to leave no reasonable alternative";
    label ru unofficial "Статья 3.2.6. Сторона может оспорить договор, если была побуждена к его заключению неоправданной угрозой другой стороны, настолько неминуемой и серьёзной, что не оставляла разумной альтернативы";
    when threat_unjustified(c, p)
        and threat_imminent_and_serious(c, p);
    then may_avoid_contract(c, p);
}

@source(PICC_ART3_2_7_EN, PICC_ART3_2_7_RU)
rule AvoidanceForGrossDisparity(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.7(1). A party may avoid the contract if at the time of its conclusion the contract unjustifiably gave the other party an excessive advantage";
    label ru unofficial "Статья 3.2.7 пункт 1. Сторона может оспорить договор, если в момент его заключения он неоправданно предоставил другой стороне чрезмерное преимущество";
    when excessive_advantage_claimed(c, p)
        and advantage_excessive_and_unjustifiable(c);
    then may_avoid_contract(c, p);
}

@source(PICC_ART3_2_7_EN, PICC_ART3_2_7_RU)
rule AvoidanceOfIndividualTermForGrossDisparity(t: Term, c: Contract, p: Party) defeasible {
    label en official "Article 3.2.7(1). A party may avoid an individual term of the contract which unjustifiably gave the other party an excessive advantage";
    label ru unofficial "Статья 3.2.7 пункт 1. Сторона может оспорить отдельное условие договора, неоправданно предоставившее другой стороне чрезмерное преимущество";
    when term_asserted_by_other_party(t, c)
        and excessive_advantage_claimed(c, p)
        and advantage_excessive_and_unjustifiable(c);
    then may_avoid_term(t, c, p);
}

pub relation adaptation_requested_by_entitled_party(c: Contract, p: Party) kind empirical {
    label en official "the party entitled to avoidance has requested the court to adapt the contract or term";
    label ru unofficial "сторона, имеющая право на оспаривание, просила суд адаптировать договор или условие";
}

pub relation adaptation_requested_after_notice(c: Contract) kind empirical {
    label en official "the party receiving notice of avoidance informed the other party of its request for adaptation promptly after receiving the notice and before the other party has reasonably acted in reliance on it";
    label ru unofficial "сторона, получившая извещение об оспаривании, сообщила другой стороне о просьбе об адаптации сразу после получения извещения и до того, как та разумно совершила действия, полагаясь на него";
}

pub relation contract_adapted_to_fair_dealing(c: Contract) kind institutional {
    label en official "the contract or term has been adapted so as to accord with reasonable commercial standards of fair dealing (article 3.2.7(2))";
    label ru unofficial "договор или условие адаптированы так, чтобы соответствовать разумным коммерческим стандартам честной деловой практики (статья 3.2.7 пункт 2)";
}

pub relation adaptation_ordered(c: Contract) kind empirical {
    label en official "the court has adapted the contract or term";
    label ru unofficial "суд адаптировал договор или условие";
}

@source(PICC_ART3_2_7_EN, PICC_ART3_2_7_RU)
rule CourtMayAdaptOnRequest(c: Contract, p: Party) strict {
    label en official "Article 3.2.7(2). Upon the request of the party entitled to avoidance, a court may adapt the contract or term in order to make it accord with reasonable commercial standards of fair dealing";
    label ru unofficial "Статья 3.2.7 пункт 2. По просьбе стороны, имеющей право на оспаривание, суд может адаптировать договор или условие, чтобы привести его в соответствие с разумными коммерческими стандартами честной деловой практики";
    when adaptation_requested_by_entitled_party(c, p);
    then power AdaptContract {
        holder Tribunal;
        over c;
        exercise adaptation_ordered(c);
        valid_when adaptation_requested_by_entitled_party(c, p);
        effect create(contract_adapted_to_fair_dealing(c));
    };
}

@source(PICC_ART3_2_7_EN, PICC_ART3_2_7_RU)
rule AdaptationOnRequestOfNotifiedParty(c: Contract) defeasible {
    label en official "Article 3.2.7(3). A court may also adapt the contract or term upon the request of the party receiving notice of avoidance, provided that party informs the other promptly and before reliance";
    label ru unofficial "Статья 3.2.7 пункт 3. Суд может адаптировать договор или условие и по просьбе стороны, получившей извещение об оспаривании, если она сообщила об этом сразу и до совершения другой стороной действий в расчёте на извещение";
    when adaptation_requested_after_notice(c)
        and adaptation_ordered(c);
    then contract_adapted_to_fair_dealing(c);
}

// --- Статья 3.2.8: третьи лица ---------------------------------------------------

pub relation ground_imputable_to_third_person(c: Contract, p: Party) kind empirical {
    label en official "fraud, threat, gross disparity or a party's mistake is imputable to, or known or ought to be known by, a third person";
    label ru unofficial "обман, угроза, существенное неравновесие или заблуждение стороны вменяются третьему лицу либо известны или должны быть известны ему";
}

pub relation other_party_responsible_for_third_person(c: Contract) kind empirical {
    label en official "the other party is responsible for the acts of that third person";
    label ru unofficial "другая сторона отвечает за действия этого третьего лица";
}

pub relation other_party_knew_of_ground(c: Contract) kind empirical {
    label en official "the other party knew or ought to have known of the fraud, threat or disparity";
    label ru unofficial "другая сторона знала или должна была знать об обмане, угрозе или неравновесии";
}

@source(PICC_ART3_2_8_EN, PICC_ART3_2_8_RU)
rule ThirdPersonForWhomPartyIsResponsible(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.8(1). Where the ground is imputable to a third person for whose acts the other party is responsible, the contract may be avoided under the same conditions";
    label ru unofficial "Статья 3.2.8 пункт 1. Если основание вменяется третьему лицу, за действия которого отвечает другая сторона, договор может быть оспорен на тех же условиях";
    when ground_imputable_to_third_person(c, p)
        and other_party_responsible_for_third_person(c);
    then may_avoid_contract(c, p);
}

@source(PICC_ART3_2_8_EN, PICC_ART3_2_8_RU)
rule ThirdPersonOutsideResponsibility(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.8(2). Where the ground is imputable to a third person for whose acts the other party is not responsible, the contract may be avoided if that party knew or ought to have known of it";
    label ru unofficial "Статья 3.2.8 пункт 2. Если основание вменяется третьему лицу, за действия которого другая сторона не отвечает, договор может быть оспорен, если та знала или должна была знать о нём";
    when ground_imputable_to_third_person(c, p)
        and other_party_knew_of_ground(c);
    then may_avoid_contract(c, p);
}

// --- Статьи 3.2.9 и 3.2.10: подтверждение и утрата права -------------------------

pub relation contract_confirmed_after_period_began(c: Contract, p: Party) kind empirical {
    label en official "the party entitled to avoid expressly or impliedly confirmed the contract after the period of time for giving notice of avoidance had begun to run";
    label ru unofficial "сторона, имеющая право на оспаривание, прямо или молчаливо подтвердила договор после начала течения срока на извещение об оспаривании";
}

@source(PICC_ART3_2_9_EN, PICC_ART3_2_9_RU)
rule ConfirmationExcludesAvoidance(c: Contract, p: Party) defeater {
    label en official "Article 3.2.9. If the party entitled to avoid confirms the contract after the period for giving notice has begun to run, avoidance is excluded";
    label ru unofficial "Статья 3.2.9. Если сторона, имеющая право на оспаривание, подтверждает договор после начала течения срока на извещение, оспаривание исключается";
    when contract_confirmed_after_period_began(c, p);
    defeat may_avoid_contract(c, p);
}

pub relation other_party_performs_as_understood(c: Contract, p: Party) kind empirical {
    label en official "the other party declared itself willing to perform, or performed, the contract as it was understood by the party entitled to avoidance, promptly and before reliance on a notice of avoidance";
    label ru unofficial "другая сторона заявила о готовности исполнить или исполнила договор так, как его понимала сторона, имеющая право на оспаривание, — сразу и до совершения действий в расчёте на извещение об оспаривании";
}

pub relation contract_as_understood_by_mistaken_party(c: Contract) kind institutional {
    label en official "the contract is considered to have been concluded as the party entitled to avoidance understood it (article 3.2.10(1))";
    label ru unofficial "договор считается заключённым так, как его понимала сторона, имеющая право на оспаривание (статья 3.2.10 пункт 1)";
}

pub relation right_to_avoid_lost(c: Contract, p: Party) kind institutional {
    label en official "the right to avoidance is lost and any earlier notice of avoidance is ineffective (article 3.2.10(2))";
    label ru unofficial "право на оспаривание утрачено, и ранее данное извещение об оспаривании силы не имеет (статья 3.2.10 пункт 2)";
}

@source(PICC_ART3_2_10_EN, PICC_ART3_2_10_RU)
rule ContractStandsAsUnderstood(c: Contract, p: Party) strict {
    label en official "Article 3.2.10(1). Where the other party declares itself willing to perform or performs the contract as understood by the party entitled to avoidance, the contract is considered to have been concluded as that party understood it";
    label ru unofficial "Статья 3.2.10 пункт 1. Если другая сторона заявляет о готовности исполнить или исполняет договор так, как его понимала сторона, имеющая право на оспаривание, договор считается заключённым в этом понимании";
    when other_party_performs_as_understood(c, p);
    then contract_as_understood_by_mistaken_party(c);
}

@source(PICC_ART3_2_10_EN, PICC_ART3_2_10_RU)
rule RightToAvoidLost(c: Contract, p: Party) strict {
    label en official "Article 3.2.10(2). After such a declaration or performance the right to avoidance is lost and any earlier notice of avoidance is ineffective";
    label ru unofficial "Статья 3.2.10 пункт 2. После такого заявления или исполнения право на оспаривание утрачивается, а ранее данное извещение силы не имеет";
    when other_party_performs_as_understood(c, p);
    then right_to_avoid_lost(c, p);
}

@source(PICC_ART3_2_10_EN, PICC_ART3_2_10_RU)
rule LostRightDefeatsMistakeAvoidance(m: Mistake, c: Contract, p: Party) defeater {
    label en official "Article 3.2.10(2). Where the right to avoidance is lost, the party may no longer avoid the contract for mistake";
    label ru unofficial "Статья 3.2.10 пункт 2. При утрате права на оспаривание сторона более не может оспорить договор вследствие заблуждения";
    when mistake_of(m, c, p)
        and right_to_avoid_lost(c, p);
    defeat may_avoid_for_mistake(m, p);
}

// --- Статьи 3.2.11 и 3.2.12: извещение об оспаривании и его срок ------------------

pub relation notice_of_avoidance_given(c: Contract, p: Party) kind empirical {
    label en official "the party has given notice of avoidance to the other party";
    label ru unofficial "сторона дала другой стороне извещение об оспаривании";
}

pub relation contract_avoided(c: Contract) kind institutional {
    label en official "the contract has been avoided by notice (article 3.2.11)";
    label ru unofficial "договор оспорен извещением (статья 3.2.11)";
}

@source(PICC_ART3_2_11_EN, PICC_ART3_2_11_RU)
rule AvoidanceExercisedByNotice(c: Contract, p: Party) strict {
    label en official "Article 3.2.11. The right of a party to avoid the contract is exercised by notice to the other party";
    label ru unofficial "Статья 3.2.11. Право стороны оспорить договор осуществляется извещением другой стороны";
    when may_avoid_contract(c, p);
    then power AvoidByNotice {
        holder p;
        over c;
        exercise notice_of_avoidance_given(c, p);
        valid_when may_avoid_contract(c, p);
        effect create(contract_avoided(c));
    };
}

@source(PICC_ART3_2_11_EN, PICC_ART3_2_11_RU)
rule NoticeAvoidsContract(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.11. On notice to the other party the contract is avoided";
    label ru unofficial "Статья 3.2.11. Извещением другой стороны договор оспаривается";
    when may_avoid_contract(c, p)
        and notice_of_avoidance_given(c, p);
    then contract_avoided(c);
}

pub external judgment relation notice_within_reasonable_time(c: Contract, p: Party) {
    authority Tribunal;
    label en official "notice of avoidance was given within a reasonable time, having regard to the circumstances, after the avoiding party knew or could not have been unaware of the relevant facts or became capable of acting freely";
    label ru unofficial "извещение об оспаривании дано в разумный с учётом обстоятельств срок после того, как сторона узнала или не могла не знать о существенных фактах либо получила возможность действовать свободно";
}

pub relation term_asserted_by_other_party(t: Term, c: Contract) kind empirical {
    label en official "the individual term has been asserted by the other party";
    label ru unofficial "отдельное условие заявлено другой стороной";
}

pub relation avoidance_notice_in_time(c: Contract, p: Party) kind institutional {
    label en official "the notice of avoidance was given in time (article 3.2.12(1))";
    label ru unofficial "извещение об оспаривании дано в срок (статья 3.2.12 пункт 1)";
}

pub relation notice_period_runs_from_assertion(t: Term, c: Contract) kind institutional {
    label en official "the period of time for giving notice of avoidance of the term begins to run when that term is asserted by the other party (article 3.2.12(2))";
    label ru unofficial "срок на извещение об оспаривании условия начинает течь, когда это условие заявлено другой стороной (статья 3.2.12 пункт 2)";
}

@source(PICC_ART3_2_12_EN, PICC_ART3_2_12_RU)
rule NoticeGivenInTime(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.12(1). Notice of avoidance shall be given within a reasonable time after the avoiding party knew of the relevant facts or became capable of acting freely";
    label ru unofficial "Статья 3.2.12 пункт 1. Извещение об оспаривании должно быть дано в разумный срок после того, как сторона узнала о существенных фактах или получила возможность действовать свободно";
    when notice_of_avoidance_given(c, p)
        and notice_within_reasonable_time(c, p);
    then avoidance_notice_in_time(c, p);
}

@source(PICC_ART3_2_12_EN, PICC_ART3_2_12_RU)
rule PeriodForTermRunsFromAssertion(t: Term, c: Contract) strict {
    label en official "Article 3.2.12(2). Where an individual term may be avoided under Article 3.2.7, the period for giving notice begins to run when that term is asserted by the other party";
    label ru unofficial "Статья 3.2.12 пункт 2. Если отдельное условие может быть оспорено по статье 3.2.7, срок на извещение начинает течь с момента, когда это условие заявлено другой стороной";
    when term_asserted_by_other_party(t, c);
    then notice_period_runs_from_assertion(t, c);
}

// --- Статьи 3.2.13 и 3.2.14: частичное оспаривание и обратная сила ---------------

pub relation ground_affects_individual_terms_only(c: Contract, t: Term) kind empirical {
    label en official "the ground of avoidance affects only individual terms of the contract";
    label ru unofficial "основание оспаривания затрагивает только отдельные условия договора";
}

pub external judgment relation unreasonable_to_uphold_remaining(c: Contract) {
    authority Tribunal;
    label en official "having regard to the circumstances, it is unreasonable to uphold the remaining contract";
    label ru unofficial "с учётом обстоятельств сохранение остальной части договора неразумно";
}

pub relation avoidance_limited_to_terms(c: Contract, t: Term) kind institutional {
    label en official "the effect of avoidance is limited to those terms (article 3.2.13)";
    label ru unofficial "последствие оспаривания ограничено этими условиями (статья 3.2.13)";
}

pub relation avoidance_retroactive(c: Contract) kind institutional {
    label en official "avoidance takes effect retroactively (article 3.2.14)";
    label ru unofficial "оспаривание действует с обратной силой (статья 3.2.14)";
}

@source(PICC_ART3_2_13_EN, PICC_ART3_2_13_RU)
rule PartialAvoidance(c: Contract, t: Term) defeasible {
    label en official "Article 3.2.13. Where a ground of avoidance affects only individual terms, the effect of avoidance is limited to those terms";
    label ru unofficial "Статья 3.2.13. Если основание оспаривания затрагивает только отдельные условия, последствие оспаривания ограничено этими условиями";
    when ground_affects_individual_terms_only(c, t);
    then avoidance_limited_to_terms(c, t);
    unless ground_affects_individual_terms_only(c, t)
        and unreasonable_to_uphold_remaining(c);
}

@source(PICC_ART3_2_14_EN, PICC_ART3_2_14_RU)
rule AvoidanceIsRetroactive(c: Contract) defeasible {
    label en official "Article 3.2.14. Avoidance takes effect retroactively";
    label ru unofficial "Статья 3.2.14. Оспаривание действует с обратной силой";
    when contract_avoided(c);
    then avoidance_retroactive(c);
}

// --- Статья 3.2.15: реституция ---------------------------------------------------

pub relation supplied_under_contract(c: Contract, p: Party) kind empirical {
    label en official "the party has supplied something under the contract or the part of it avoided";
    label ru unofficial "сторона предоставила что-либо по договору или по оспоренной его части";
}

pub relation makes_concurrent_restitution(c: Contract, p: Party) kind empirical {
    label en official "the party concurrently makes restitution of whatever it has received under the contract or the part of it avoided";
    label ru unofficial "сторона одновременно возвращает всё полученное по договору или по оспоренной его части";
}

pub relation restitution_in_kind_impossible(c: Contract, p: Party) kind empirical {
    label en official "restitution in kind is not possible or appropriate";
    label ru unofficial "реституция в натуре невозможна или неуместна";
}

pub external judgment relation allowance_in_money_reasonable(c: Contract, p: Party) {
    authority Tribunal;
    label en official "an allowance in money is reasonable in the circumstances";
    label ru unofficial "денежное возмещение разумно при данных обстоятельствах";
}

pub relation impossibility_attributable_to_other_party(c: Contract, p: Party) kind empirical {
    label en official "the impossibility to make restitution in kind is attributable to the other party";
    label ru unofficial "невозможность реституции в натуре вызвана другой стороной";
}

pub relation expenses_reasonably_required(c: Contract, p: Party) kind empirical {
    label en official "expenses were reasonably required to preserve or maintain the performance received";
    label ru unofficial "расходы были разумно необходимы для сохранения или поддержания полученного исполнения";
}

pub relation may_claim_restitution(c: Contract, p: Party) kind institutional {
    label en official "the party may claim restitution of whatever it has supplied (article 3.2.15(1))";
    label ru unofficial "сторона может требовать возврата всего предоставленного (статья 3.2.15 пункт 1)";
}

pub relation allowance_in_money_due(c: Contract, p: Party) kind institutional {
    label en official "an allowance in money has to be made (article 3.2.15(2))";
    label ru unofficial "должно быть сделано денежное возмещение (статья 3.2.15 пункт 2)";
}

pub relation expenses_compensable(c: Contract, p: Party) kind institutional {
    label en official "compensation may be claimed for expenses reasonably required to preserve or maintain the performance received (article 3.2.15(4))";
    label ru unofficial "может быть потребовано возмещение расходов, разумно необходимых для сохранения или поддержания полученного исполнения (статья 3.2.15 пункт 4)";
}

@source(PICC_ART3_2_15_EN, PICC_ART3_2_15_RU)
rule RestitutionOnAvoidance(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.15(1). On avoidance either party may claim restitution of whatever it has supplied, provided that it concurrently makes restitution of whatever it has received";
    label ru unofficial "Статья 3.2.15 пункт 1. При оспаривании каждая сторона может требовать возврата предоставленного при условии одновременного возврата полученного";
    when contract_avoided(c)
        and supplied_under_contract(c, p)
        and makes_concurrent_restitution(c, p);
    then may_claim_restitution(c, p);
}

@source(PICC_ART3_2_15_EN, PICC_ART3_2_15_RU)
rule AllowanceInMoney(c: Contract, p: Party) defeasible {
    label en official "Article 3.2.15(2). If restitution in kind is not possible or appropriate, an allowance has to be made in money whenever reasonable";
    label ru unofficial "Статья 3.2.15 пункт 2. Если реституция в натуре невозможна или неуместна, должно быть сделано денежное возмещение, когда это разумно";
    when restitution_in_kind_impossible(c, p)
        and allowance_in_money_reasonable(c, p);
    then allowance_in_money_due(c, p);
    unless restitution_in_kind_impossible(c, p)
        and impossibility_attributable_to_other_party(c, p);
}

@source(PICC_ART3_2_15_EN, PICC_ART3_2_15_RU)
rule ExpensesOfPreservationCompensable(c: Contract, p: Party) strict {
    label en official "Article 3.2.15(4). Compensation may be claimed for expenses reasonably required to preserve or maintain the performance received";
    label ru unofficial "Статья 3.2.15 пункт 4. Может быть потребовано возмещение расходов, разумно необходимых для сохранения или поддержания полученного исполнения";
    when expenses_reasonably_required(c, p);
    then expenses_compensable(c, p);
}

// --- Статьи 3.2.16 и 3.2.17: убытки и односторонние заявления --------------------

pub relation knew_of_ground_for_avoidance(c: Contract, p: Party) kind empirical {
    label en official "the party knew or ought to have known of the ground for avoidance";
    label ru unofficial "сторона знала или должна была знать об основании оспаривания";
}

pub relation liable_for_reliance_damages(c: Contract, p: Party) kind institutional {
    label en official "the party is liable for damages so as to put the other party in the position in which it would have been if it had not concluded the contract (article 3.2.16)";
    label ru unofficial "сторона отвечает за убытки, чтобы поставить другую сторону в положение, в котором та была бы, не заключив договора (статья 3.2.16)";
}

@source(PICC_ART3_2_16_EN, PICC_ART3_2_16_RU)
rule DamagesIrrespectiveOfAvoidance(c: Contract, p: Party) strict {
    label en official "Article 3.2.16. Irrespective of whether or not the contract has been avoided, the party who knew or ought to have known of the ground for avoidance is liable for damages";
    label ru unofficial "Статья 3.2.16. Независимо от того, оспорен договор или нет, сторона, знавшая или обязанная знать об основании оспаривания, отвечает за убытки";
    when knew_of_ground_for_avoidance(c, p);
    then liable_for_reliance_damages(c, p);
}

pub relation communication_of_intention(d: Declaration, c: Contract) kind empirical {
    label en official "the communication of intention is addressed by one party to the other";
    label ru unofficial "сообщение о намерении адресовано одной стороной другой";
}

pub relation chapter_applies_to_declaration(d: Declaration) kind institutional {
    label en official "the provisions of this Chapter apply with appropriate adaptations to the communication of intention (article 3.2.17)";
    label ru unofficial "положения настоящей главы применяются с соответствующими изменениями к сообщению о намерении (статья 3.2.17)";
}

@source(PICC_ART3_2_17_EN, PICC_ART3_2_17_RU)
rule ChapterAppliesToUnilateralDeclarations(d: Declaration, c: Contract) strict {
    label en official "Article 3.2.17. The provisions of this Chapter apply with appropriate adaptations to any communication of intention addressed by one party to the other";
    label ru unofficial "Статья 3.2.17. Положения настоящей главы применяются с соответствующими изменениями к любому сообщению о намерении, адресованному одной стороной другой";
    when communication_of_intention(d, c);
    then chapter_applies_to_declaration(d);
}
