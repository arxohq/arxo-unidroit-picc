// Articles 3.3.1 and 3.3.2. Illegality: a contract infringing a mandatory rule.
//
// THE MANDATORY RULE ITSELF NAMES THE EFFECTS, NOT THE PRINCIPLES. Article
// 3.3.1(1) refers to the infringed rule directly; the Principles step in only
// where that rule is silent (paragraph 2), and the measure is then
// reasonableness with the seven named factors (paragraph 3). This is a boundary
// from the text: which rule is mandatory and what it prescribes is an input of
// the case under article 1.4.

language "law.core" version "0.2";
package unidroit.picc_validity version "0.1.0";
namespace "urn:org:unidroit:clir:picc-validity";

pub relation infringes_mandatory_rule(c: Contract) kind empirical {
    label en official "the contract infringes a mandatory rule, whether of national, international or supranational origin, applicable under Article 1.4";
}

pub relation effects_expressly_prescribed(c: Contract) kind empirical {
    label en official "the mandatory rule expressly prescribes the effects of the infringement upon the contract";
}

pub relation effects_are_those_of_the_rule(c: Contract) kind institutional {
    label en official "the effects of the infringement upon the contract are those expressly prescribed by the mandatory rule (article 3.3.1(1))";
}

pub external judgment relation remedies_reasonable_in_circumstances(c: Contract) {
    authority Tribunal;
    label en official "the remedies under the contract are reasonable in the circumstances, regard being had in particular to the purpose of the rule infringed, the category of persons it protects, any sanction under it, the seriousness of the infringement, the parties' knowledge of it, whether performance necessitates the infringement and the parties' reasonable expectations";
}

pub relation remedies_under_contract_available(c: Contract) kind institutional {
    label en official "the parties have the right to exercise such remedies under the contract as in the circumstances are reasonable (article 3.3.1(2))";
}

@source(PICC_ART3_3_1_EN, PICC_ART3_3_1_FR)
rule EffectsPrescribedByTheRule(c: Contract) strict {
    label en official "Article 3.3.1(1). Where a contract infringes a mandatory rule, the effects of that infringement are the effects expressly prescribed by that rule";
    when infringes_mandatory_rule(c)
        and effects_expressly_prescribed(c);
    then effects_are_those_of_the_rule(c);
}

@source(PICC_ART3_3_1_EN, PICC_ART3_3_1_FR)
rule ReasonableRemediesWhereRuleSilent(c: Contract) defeasible {
    label en official "Article 3.3.1(2). Where the mandatory rule does not expressly prescribe the effects, the parties have the right to exercise such remedies under the contract as in the circumstances are reasonable";
    when infringes_mandatory_rule(c)
        and not_known(effects_expressly_prescribed(c))
        and remedies_reasonable_in_circumstances(c);
    then remedies_under_contract_available(c);
}

// --- Article 3.3.2: restitution in the case of illegality ---------------------

pub relation performance_rendered_under_illegal_contract(c: Contract, p: Party) kind empirical {
    label en official "there has been performance under a contract infringing a mandatory rule";
}

pub external judgment relation restitution_reasonable_in_circumstances(c: Contract, p: Party) {
    authority Tribunal;
    label en official "restitution would be reasonable in the circumstances, regard being had with appropriate adaptations to the criteria referred to in Article 3.3.1(3)";
}

pub relation restitution_may_be_granted(c: Contract, p: Party) kind institutional {
    label en official "restitution may be granted (article 3.3.2(1))";
}

@source(PICC_ART3_3_2_EN, PICC_ART3_3_2_FR)
rule RestitutionForIllegality(c: Contract, p: Party) defeasible {
    label en official "Article 3.3.2(1). Where there has been performance under a contract infringing a mandatory rule, restitution may be granted where this would be reasonable in the circumstances";
    when infringes_mandatory_rule(c)
        and performance_rendered_under_illegal_contract(c, p)
        and restitution_reasonable_in_circumstances(c, p);
    then restitution_may_be_granted(c, p);
}

@source(PICC_ART3_3_2_EN, PICC_ART3_3_2_FR)
rule IllegalityRestitutionFollowsArticle3215(c: Contract, p: Party) defeasible {
    label en official "Article 3.3.2(3). If restitution is granted, the rules set out in Article 3.2.15 apply with appropriate adaptations";
    when restitution_may_be_granted(c, p)
        and supplied_under_contract(c, p)
        and makes_concurrent_restitution(c, p);
    then may_claim_restitution(c, p);
}
