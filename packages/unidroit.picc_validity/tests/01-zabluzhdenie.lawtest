language "law.core" version "0.2";
package unidroit.picc_validity version "0.1.0";
namespace "urn:org:unidroit:clir:picc-validity";

// Дело 1. Заблуждение: что им является (3.2.1, 3.2.3), когда оно даёт право
// оспорить договор (3.2.2 п. 1) и что это право снимает (3.2.2 п. 2, 3.2.4,
// 3.2.10).
//
// ЗДЕСЬ КОНВЕНЦИЯ МОЛЧИТ ПО СОБСТВЕННОМУ ЗАЯВЛЕНИЮ: статья 4 подпункт a
// выводит действительность договора из её предмета. Ответ даёт только этот
// инструмент, и дело показывает, чем именно.

test "PICCV-01-MISTAKE" {
    given {
        context {
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": mistake_of(entity_ref("urn:case:piccv:m-known"), entity_ref("urn:case:piccv:contract-1"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
        assert "a1": erroneous_assumption_about_facts_or_law(entity_ref("urn:case:piccv:m-known")) { origin case_input; }
        assert "a2": mistake_of_decisive_importance(entity_ref("urn:case:piccv:m-known")) { origin adjudicated; }
        assert "a3": other_party_shared_caused_or_knew(entity_ref("urn:case:piccv:m-known")) { origin case_input; }
        assert "a4": contrary_to_fair_dealing_to_leave_in_error(entity_ref("urn:case:piccv:m-known")) { origin adjudicated; }
        assert "a5": mistake_of(entity_ref("urn:case:piccv:m-negligent"), entity_ref("urn:case:piccv:contract-1b"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
        assert "a6": erroneous_assumption_about_facts_or_law(entity_ref("urn:case:piccv:m-negligent")) { origin case_input; }
        assert "a7": mistake_of_decisive_importance(entity_ref("urn:case:piccv:m-negligent")) { origin adjudicated; }
        assert "a8": other_party_had_not_relied(entity_ref("urn:case:piccv:m-negligent")) { origin case_input; }
        assert "a9": grossly_negligent_in_committing_mistake(entity_ref("urn:case:piccv:m-negligent")) { origin case_input; }
        assert "a10": mistake_of(entity_ref("urn:case:piccv:m-transmission"), entity_ref("urn:case:piccv:contract-1c"), entity_ref("urn:case:piccv:seller")) { origin case_input; }
        assert "a11": error_in_expression_or_transmission(entity_ref("urn:case:piccv:m-transmission")) { origin case_input; }
        assert "a12": mistake_of_decisive_importance(entity_ref("urn:case:piccv:m-transmission")) { origin adjudicated; }
        assert "a13": other_party_had_not_relied(entity_ref("urn:case:piccv:m-transmission")) { origin case_input; }
        assert "a14": remedy_for_non_performance_available(entity_ref("urn:case:piccv:m-transmission")) { origin case_input; }
        assert "a15": mistake_of(entity_ref("urn:case:piccv:m-cured"), entity_ref("urn:case:piccv:contract-1d"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
        assert "a16": erroneous_assumption_about_facts_or_law(entity_ref("urn:case:piccv:m-cured")) { origin case_input; }
        assert "a17": mistake_of_decisive_importance(entity_ref("urn:case:piccv:m-cured")) { origin adjudicated; }
        assert "a18": other_party_had_not_relied(entity_ref("urn:case:piccv:m-cured")) { origin case_input; }
        assert "a19": other_party_performs_as_understood(entity_ref("urn:case:piccv:contract-1d"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
    }

    evaluate truth(is_mistake(entity_ref("urn:case:piccv:m-known")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(ErroneousAssumptionIsMistake);

    // Ошибка передачи — заблуждение того, от кого заявление исходит (3.2.3).
    evaluate truth(is_mistake(entity_ref("urn:case:piccv:m-transmission")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ErrorInTransmissionIsMistake);

    evaluate truth(may_avoid_for_mistake(entity_ref("urn:case:piccv:m-known"), entity_ref("urn:case:piccv:buyer")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(AvoidanceForMistakeKnownToOtherParty);

    // Грубая неосторожность заблуждавшейся стороны снимает право (3.2.2 п. 2 a).
    evaluate truth(may_avoid_for_mistake(entity_ref("urn:case:piccv:m-negligent"), entity_ref("urn:case:piccv:buyer")));
    expect truth_status == NEITHER;

    // Доступное средство защиты при неисполнении тоже снимает его (3.2.4).
    evaluate truth(may_avoid_for_mistake(entity_ref("urn:case:piccv:m-transmission"), entity_ref("urn:case:piccv:seller")));
    expect truth_status == NEITHER;

    // Исполнение так, как понимала заблуждавшаяся сторона: договор считается
    // заключённым в этом понимании, право на оспаривание утрачено (3.2.10).
    evaluate truth(contract_as_understood_by_mistaken_party(entity_ref("urn:case:piccv:contract-1d")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ContractStandsAsUnderstood);

    evaluate truth(right_to_avoid_lost(entity_ref("urn:case:piccv:contract-1d"), entity_ref("urn:case:piccv:buyer")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(RightToAvoidLost);

    evaluate truth(may_avoid_for_mistake(entity_ref("urn:case:piccv:m-cured"), entity_ref("urn:case:piccv:buyer")));
    expect truth_status == NEITHER;
}
