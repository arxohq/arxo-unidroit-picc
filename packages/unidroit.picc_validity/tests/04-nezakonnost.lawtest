language "law.core" version "0.2";
package unidroit.picc_validity version "0.1.0";
namespace "urn:org:unidroit:clir:picc-validity";

// Дело 4. Общие положения главы (3.1.1-3.1.4) и незаконность (3.3.1, 3.3.2).
//
// ПОСЛЕДСТВИЯ НАРУШЕНИЯ НАЗЫВАЕТ САМА ИМПЕРАТИВНАЯ НОРМА. Принципы вступают
// только там, где она молчит, и тогда мерилом становится разумность. Дело
// предъявляет оба случая рядом.

test "PICCV-04-GENERAL-PROVISIONS-AND-ILLEGALITY" {
    given {
        context {
            decision_time @2026-09-17T12:00:00Z;
            knowledge_time @2026-09-17T12:00:00Z;
            legal_time @2026-09-17;
            timezone "UTC";
        }

        assert "a0": contract_under_consideration(entity_ref("urn:case:piccv:contract-4")) { origin case_input; }
        assert "a1": mere_agreement_of_parties(entity_ref("urn:case:piccv:contract-4")) { origin case_input; }
        assert "a2": performance_initially_impossible(entity_ref("urn:case:piccv:contract-4")) { origin case_input; }
        assert "a3": party_not_entitled_to_dispose(entity_ref("urn:case:piccv:contract-4b")) { origin case_input; }
        assert "a4": exclusion_of_chapter_attempted(entity_ref("urn:case:piccv:contract-4"), entity_ref("urn:case:piccv:term-4")) { origin case_input; }
        assert "a5": infringes_mandatory_rule(entity_ref("urn:case:piccv:contract-4c")) { origin case_input; }
        assert "a6": effects_expressly_prescribed(entity_ref("urn:case:piccv:contract-4c")) { origin case_input; }
        assert "a7": infringes_mandatory_rule(entity_ref("urn:case:piccv:contract-4d")) { origin case_input; }
        assert "a8": remedies_reasonable_in_circumstances(entity_ref("urn:case:piccv:contract-4d")) { origin adjudicated; }
        assert "a9": performance_rendered_under_illegal_contract(entity_ref("urn:case:piccv:contract-4d"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
        assert "a10": restitution_reasonable_in_circumstances(entity_ref("urn:case:piccv:contract-4d"), entity_ref("urn:case:piccv:buyer")) { origin adjudicated; }
        assert "a11": supplied_under_contract(entity_ref("urn:case:piccv:contract-4d"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
        assert "a12": makes_concurrent_restitution(entity_ref("urn:case:piccv:contract-4d"), entity_ref("urn:case:piccv:buyer")) { origin case_input; }
    }

    // Дееспособность глава не регулирует — граница из текста (3.1.1).
    evaluate truth(capacity_not_governed(entity_ref("urn:case:piccv:contract-4")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect any_applied(ChapterDoesNotDealWithCapacity);

    evaluate truth(valid_without_further_requirement(entity_ref("urn:case:piccv:contract-4")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(MereAgreementSuffices);

    evaluate truth(validity_unaffected(entity_ref("urn:case:piccv:contract-4")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(InitialImpossibilityDoesNotAffectValidity);

    evaluate truth(validity_unaffected(entity_ref("urn:case:piccv:contract-4b")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(NoRightToDisposeDoesNotAffectValidity);

    // Положения об обмане, угрозе, неравновесии и незаконности императивны (3.1.4).
    evaluate truth(exclusion_of_chapter_ineffective(entity_ref("urn:case:piccv:contract-4"), entity_ref("urn:case:piccv:term-4")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(MandatoryProvisionsResistExclusion);

    // Норма назвала последствия сама — Принципы их не подменяют (3.3.1 п. 1).
    evaluate truth(effects_are_those_of_the_rule(entity_ref("urn:case:piccv:contract-4c")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(EffectsPrescribedByTheRule);

    // Норма молчит — вступает разумность средств защиты (3.3.1 п. 2).
    evaluate truth(remedies_under_contract_available(entity_ref("urn:case:piccv:contract-4d")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(ReasonableRemediesWhereRuleSilent);

    evaluate truth(restitution_may_be_granted(entity_ref("urn:case:piccv:contract-4d"), entity_ref("urn:case:piccv:buyer")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(RestitutionForIllegality);

    evaluate truth(may_claim_restitution(entity_ref("urn:case:piccv:contract-4d"), entity_ref("urn:case:piccv:buyer")));
    expect truth_status == TRUE_ONLY;
    expect any_applied(IllegalityRestitutionFollowsArticle3215);
}
